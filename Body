-- REBIRTH: only READS the player's rebirth count for display in the UI.
local SUFFIX = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}

local function abbr(n)
	local neg = n < 0
	n = math.abs(n)
	local i = 1
	while n >= 1000 and i < #SUFFIX do
		n /= 1000
		i += 1
	end
	local shown = i == 1 and math.floor(n + 0.5) or tonumber(string.format("%.2f", n))
	if shown >= 1000 and i < #SUFFIX then
		n /= 1000
		i += 1
		shown = tonumber(string.format("%.2f", n))
	end
	local s = i == 1 and tostring(shown) or string.format("%.2f", shown)
	return (neg and "-" or "") .. s .. SUFFIX[i]
end

-- full number with dot separators: 150000 -> 150.000
local function full(n)
	local s = string.format("%.0f", math.abs(n))
	s = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	s = s:gsub("^%.", "")
	return (n < 0 and "-" or "") .. s
end

local function isNum(v) return v:IsA("IntValue") or v:IsA("NumberValue") end

-- Fallback finder: leaderstats.Rebirths first, then any value whose name contains "rebirth".
local function findRebirthObj()
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	local direct = ls and ls:FindFirstChild("Rebirths")
	if direct and isNum(direct) then return direct end
	local roots = {}
	if ls then roots[#roots + 1] = ls end
	roots[#roots + 1] = LocalPlayer
	for _, root in ipairs(roots) do
		for _, d in ipairs(root:GetDescendants()) do
			if isNum(d) and d.Name:lower():find("rebirth", 1, true) then return d end
		end
	end
	return nil
end

