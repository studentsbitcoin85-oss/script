-- Helper (semua posisi absolut pada kanvas 1536x1024)
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) new("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
local function stroke(o, c, t) return new("UIStroke", {Color = c or LINE, Thickness = t or 1}, o) end

local function box(p, x1, y1, x2, y2, bg, r, noStroke)
	local f = new("Frame", {
		Position = UDim2.fromOffset(x1, y1), Size = UDim2.fromOffset(x2 - x1, y2 - y1),
		BackgroundColor3 = bg, BorderSizePixel = 0,
	}, p)
	round(f, r or 12)
	if not noStroke then stroke(f) end
	return f
end

-- x = kiri, cy = titik tengah vertikal.
-- fit = true: tulisan otomatis mengecil supaya muat di lebar w (tidak ikut TS).
local function text(p, t, size, x, cy, w, color, font, align, fit)
	size = math.floor(size * TS)
	align = align or LEFT
	local nw = fit and w or w * TS
	if not fit then
		if align == CENTER then x = x - (nw - w) / 2 elseif align == RIGHT then x = x - (nw - w) end
	end
	local h = size + 10
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Text = t, TextSize = size, Font = font or F.Gotham,
		Position = UDim2.fromOffset(x, cy - h / 2), Size = UDim2.fromOffset(nw, h),
		TextColor3 = color or TX, TextXAlignment = align, TextYAlignment = Enum.TextYAlignment.Center,
	}, p)
	if fit then
		l.TextScaled = true
		new("UITextSizeConstraint", {MaxTextSize = size, MinTextSize = 4}, l)
	end
	return l
end

local function hline(p, x1, x2, y)
	new("Frame", {Position = UDim2.fromOffset(x1, y), Size = UDim2.fromOffset(x2 - x1, 1),
		BackgroundColor3 = LINE, BorderSizePixel = 0}, p)
end

local function image(p, id, x1, y1, x2, y2, fallback, fsize)
	if id ~= "" then
		return new("ImageLabel", {
			BackgroundTransparency = 1, Image = assetUrl(id),
			Position = UDim2.fromOffset(x1, y1), Size = UDim2.fromOffset(x2 - x1, y2 - y1),
			ScaleType = Enum.ScaleType.Fit,
		}, p)
	end
	return text(p, fallback, fsize or 20, x1, (y1 + y2) / 2, x2 - x1, TX, F.GothamBlack, CENTER, true)
end

-- Drag generik: `target` digeser lewat `handle`. onTap dipanggil kalau cuma diklik (tidak digeser).
local function makeDraggable(handle, target, threshold, onTap)
	local dragging, moved, startPos, startTarget
	handle.InputBegan:Connect(function(i)
		if not isPointer(i) then return end
		dragging, moved, startPos, startTarget = true, false, i.Position, target.Position
		i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End then
				dragging = false
				if not moved and onTap then onTap() end
			end
		end)
	end)
	UserInputService.InputChanged:Connect(function(i)
		if not (dragging and isMove(i)) then return end
		local d = i.Position - startPos
		if d.Magnitude > threshold then moved = true end
		if moved then
			target.Position = UDim2.new(startTarget.X.Scale, startTarget.X.Offset + d.X,
				startTarget.Y.Scale, startTarget.Y.Offset + d.Y)
		end
	end)
end

