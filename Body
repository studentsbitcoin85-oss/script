local function new(className, properties, parent)
    local object = Instance.new(className)

    for key, value in pairs(properties or {}) do
        object[key] = value
    end

    object.Parent = parent
    return object
end

local function round(object, radius)
    new("UICorner", {
        CornerRadius = UDim.new(0, radius or 10),
    }, object)
end

local function stroke(object, color, thickness)
    return new("UIStroke", {
        Color = color or C.Line,
        Thickness = thickness or 1,
    }, object)
end

local function measure(value, size, font)
    local ok, result = pcall(function()
        return TextService:GetTextSize(
            value,
            size,
            font or F.Gotham,
            Vector2.new(10000, 1000)
        )
    end)

    return ok and result.X or (#value * size * 0.6)
end

local function box(parent, x, y, width, height, color, radius)
    local object = new("Frame", {
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = color or C.Card,
        BorderSizePixel = 0,
    }, parent)

    round(object, radius or 12)
    stroke(object)

    return object
end

local function label(parent, value, size, x, centerY, width, color, font, align)
    local height = size + 10

    return new("TextLabel", {
        BackgroundTransparency = 1,
        Text = value,
        TextSize = size,
        Font = font or F.Gotham,
        Position = UDim2.fromOffset(x, centerY - height / 2),
        Size = UDim2.fromOffset(width, height),
        TextColor3 = color or C.Text,
        TextXAlignment = align or LEFT,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    }, parent)
end

local function divider(parent, x, y, width)
    new("Frame", {
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(width, 1),
        BackgroundColor3 = C.Line,
        BorderSizePixel = 0,
    }, parent)
end

local function image(parent, assetId, x, y, width, height, fallback)
    local id = tostring(assetId or ""):match("%d+")

    if not id then
        return label(
            parent, fallback or "M", 24,
            x, y + height / 2, width,
            C.Text, F.GothamBlack, CENTER
        )
    end

    return new("ImageLabel", {
        BackgroundTransparency = 1,
        Image = "rbxassetid://" .. id,
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(width, height),
        ScaleType = Enum.ScaleType.Fit,
    }, parent)
end

local function makeToggle(parent, x, centerY, initial, callback)
    local state = initial == true

    local track = new("TextButton", {
        Text = "",
        AutoButtonColor = false,
        Position = UDim2.fromOffset(x, centerY - 13),
        Size = UDim2.fromOffset(44, 26),
        BackgroundColor3 = state and C.On or C.Off,
        BorderSizePixel = 0,
    }, parent)

    round(track, 13)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.fromOffset(state and 21 or 3, 3),
        BackgroundColor3 = Color3.fromRGB(235, 235, 235),
        BorderSizePixel = 0,
    }, track)

    round(knob, 10)

    track.MouseButton1Click:Connect(function()
        state = not state

        local tweenInfo = TweenInfo.new(0.15)

        TweenService:Create(track, tweenInfo, {
            BackgroundColor3 = state and C.On or C.Off,
        }):Play()

        TweenService:Create(knob, tweenInfo, {
            Position = UDim2.fromOffset(state and 21 or 3, 3),
        }):Play()

        if callback then
            callback(state)
        end
    end)

    return track
end

local function makeNumberBox(parent, x, y, width, height, initial, callback)
    local frame = box(parent, x, y, width, height, C.Black, 8)
    local input = new("TextBox", {
        BackgroundTransparency = 1,
        Text = initial or "",
        PlaceholderText = "Value",
        TextSize = 14,
        Font = F.GothamBold,
        TextColor3 = C.Text,
        PlaceholderColor3 = C.Sub,
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(1, -16, 1, 0),
        TextXAlignment = LEFT,
        ClearTextOnFocus = false,
    }, frame)

    input.FocusLost:Connect(function()
        if callback then
            callback(input.Text)
        end
    end)

    return frame
end

local function makeOption(parent, y, width, title, subtitle, callback, numberValue)
    local row = new("Frame", {
        Position = UDim2.fromOffset(0, y),
        Size = UDim2.fromOffset(width, ROW_H),
        BackgroundTransparency = 1,
    }, parent)

    if numberValue then
        label(row, "↳", 20, 8, 27, 30, C.Muted, F.GothamBold, CENTER)

        label(
            row, title, 15, 42, 18,
            width - 150, C.Text, F.GothamBold
        )

        label(
            row, subtitle, 11, 42, 40,
            width - 150, C.Sub, F.GothamMedium
        )

        makeNumberBox(
            row,
            width - 94,
            15,
            80,
            28,
            numberValue,
            callback
        )
    else
        makeToggle(row, 8, ROW_H / 2, false, callback)

        label(
            row, title, 15, 64, 18,
            width - 76, C.Text, F.GothamBold
        )

        label(
            row, subtitle, 11, 64, 40,
            width - 76, C.Sub, F.GothamMedium
        )
    end

    return row
end

