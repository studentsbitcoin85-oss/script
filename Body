-- Update Label. Versi Luna berbeda: ada yang Set({Text=,Style=}), ada yang Set(text, style).
-- Dicoba dua-duanya, bentuk yang berhasil diingat per label.
local labelMode = setmetatable({}, {__mode = "k"})
local warnedSet = false
local function setLabel(el, s)
	if labelMode[el] ~= "str" then
		if pcall(el.Set, el, {Text = s.Text, Style = s.Style}) then
			labelMode[el] = "tbl"
			return
		end
	end
	if pcall(el.Set, el, s.Text, s.Style) then
		labelMode[el] = "str"
		return
	end
	if not warnedSet then
		warnedSet = true
		warn("[Muhaves] Label:Set gagal di versi Luna ini, teks status tidak bisa di-update.")
	end
end

