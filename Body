-- Helper (semua posisi absolut pada kanvas 1536x1024)
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) new("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
local function stroke(o, c, t) new("UIStroke", {Color = c or LINE, Thickness = t or 1}, o) end

local function box(p, x1, y1, x2, y2, bg, r, noStroke)
	local f = new("Frame", {
		Position = UDim2.fromOffset(x1, y1), Size = UDim2.fromOffset(x2 - x1, y2 - y1),
		BackgroundColor3 = bg, BorderSizePixel = 0,
	}, p)
	round(f, r or 12)
	if not noStroke then stroke(f) end
	return f
end

-- x = kiri, cy = titik tengah vertikal
local function text(p, t, size, x, cy, w, color, font, align)
	local h = size + 10
	return new("TextLabel", {
		BackgroundTransparency = 1, Text = t, TextSize = size, Font = font or F.Gotham,
		Position = UDim2.fromOffset(x, cy - h / 2), Size = UDim2.fromOffset(w, h),
		TextColor3 = color or TX, TextXAlignment = align or LEFT, TextYAlignment = Enum.TextYAlignment.Center,
	}, p)
end

local function hline(p, x1, x2, y)
	new("Frame", {Position = UDim2.fromOffset(x1, y), Size = UDim2.fromOffset(x2 - x1, 1),
		BackgroundColor3 = LINE, BorderSizePixel = 0}, p)
end

local function image(p, id, x1, y1, x2, y2, fallback, fsize)
	if id ~= "" then
		return new("ImageLabel", {
			BackgroundTransparency = 1, Image = id:match("^rbxassetid") and id or ("rbxassetid://" .. id),
			Position = UDim2.fromOffset(x1, y1), Size = UDim2.fromOffset(x2 - x1, y2 - y1),
			ScaleType = Enum.ScaleType.Fit,
		}, p)
	end
	return text(p, fallback, fsize or 20, x1, (y1 + y2) / 2, x2 - x1, TX, F.GothamBlack, CENTER)
end

local function toggle(p, x, cy, initial, cb)
	local state = initial
	local tr = new("TextButton", {
		Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(x, cy - 13),
		Size = UDim2.fromOffset(44, 26), BackgroundColor3 = state and ONBG or OFFBG, BorderSizePixel = 0,
	}, p)
	round(tr, 13)
	local kn = new("Frame", {
		Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(state and 21 or 3, 3),
		BackgroundColor3 = state and Color3.new(1, 1, 1) or Color3.fromRGB(225, 225, 225), BorderSizePixel = 0,
	}, tr)
	round(kn, 10)
	tr.MouseButton1Click:Connect(function()
		state = not state
		local i = TweenInfo.new(0.15)
		TweenService:Create(tr, i, {BackgroundColor3 = state and ONBG or OFFBG}):Play()
		TweenService:Create(kn, i, {Position = UDim2.fromOffset(state and 21 or 3, 3),
			BackgroundColor3 = state and Color3.new(1, 1, 1) or Color3.fromRGB(225, 225, 225)}):Play()
		cb(state)
	end)
end

local function numberBox(p, x1, y1, x2, y2, value, cb)
	local f = box(p, x1, y1, x2, y2, Color3.fromRGB(12, 12, 13), 8, true)
	stroke(f, Color3.fromRGB(85, 85, 90))
	local tb = new("TextBox", {
		BackgroundTransparency = 1, Text = value, TextSize = 17, Font = F.Gotham, TextColor3 = TX,
		Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -36, 1, 0), TextXAlignment = LEFT,
		ClearTextOnFocus = false,
	}, f)
	text(f, "⌃", 10, x2 - x1 - 22, 11, 14, MUTED, F.GothamBold, CENTER)
	text(f, "⌄", 10, x2 - x1 - 22, (y2 - y1) - 11, 14, MUTED, F.GothamBold, CENTER)
	tb.FocusLost:Connect(function()
		local n = tonumber((tb.Text:gsub("%.", "")))
		if n then cb(n) end
	end)
end

local function toggleRow(p, tx, titleX, cy, title, sub, initial, cb)
	toggle(p, tx, cy, initial, cb)
	text(p, title, 17, titleX, cy - 9, 300, TX, F.GothamMedium)
	text(p, sub, 13, titleX, cy + 13, 400, SUB)
end

local function iconRow(p, icon, ix, titleX, cy, title, sub)
	text(p, icon, 30, ix, cy, 44, MUTED, F.GothamBold, CENTER)
	text(p, title, 17, titleX, cy - 9, 300, TX, F.GothamMedium)
	text(p, sub, 13, titleX, cy + 13, 400, SUB)
end

local function pill(p, x1, y1, x2, y2, t)
	local f = box(p, x1, y1, x2, y2, Color3.fromRGB(10, 10, 11), 16)
	local d = new("Frame", {Position = UDim2.fromOffset(12, (y2 - y1) / 2 - 7), Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.fromRGB(130, 130, 134), BorderSizePixel = 0}, f)
	round(d, 7)
	return text(f, t, 15, 36, (y2 - y1) / 2, x2 - x1 - 40, TX)
end

-- header halaman: ikon + judul + subjudul + pill status (kanan)
local function pageHeader(p, icon, title, sub, status, pillX1)
	text(p, icon, 30, 326, 178, 44, TX, F.GothamBold, CENTER)
	text(p, title, 25, 380, 168, 500, TX, F.GothamMedium)
	text(p, sub, 15, 380, 193, 600, SUB)
	if status then return pill(p, pillX1, 160, pillX1 + 141, 192, status) end
end

local function stat(p, icon, name, value, cy, ix, nx, vx, vw, size, align)
	text(p, icon, size + 2, ix - 10, cy, 22, MUTED, F.Gotham, CENTER)
	text(p, name, size, nx, cy, 170, Color3.fromRGB(205, 205, 208))
	return text(p, value, size, vx, cy, vw, TX, F.Gotham, align or LEFT)
end

