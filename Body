local function prepCard(o, height)
	local a, depth = o.Parent, 0
	while a and a.Parent and not a.Parent:FindFirstChildOfClass("UIListLayout") and depth < 8 do
		a = a.Parent
		depth += 1
	end
	if not (a and a.Parent and a:IsA("GuiObject") and a.Parent:FindFirstChildOfClass("UIListLayout")) then return nil end
	if a:FindFirstChild("MuhavesCard") then return nil end
	for _, ch in ipairs(a:GetChildren()) do
		if ch:IsA("GuiObject") then ch.Visible = false end
	end
	pcall(function() a.AutomaticSize = Enum.AutomaticSize.None end)
	local function fit()
		if a.Size.Y.Scale ~= 0 or a.Size.Y.Offset ~= height then
			a.Size = UDim2.new(a.Size.X.Scale, a.Size.X.Offset, 0, height)
		end
	end
	fit()
	a:GetPropertyChangedSignal("Size"):Connect(fit)
	a.ClipsDescendants = true
	local holder = Instance.new("Frame")
	holder.Name = "MuhavesCard"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Position = UDim2.fromOffset(8, 8)
	holder.Size = UDim2.new(1, -16, 1, -16)
	holder.Parent = a
	return a, holder
end

local function cellColor(card)
