-- PET SELECTION ALGORITHM
--==================================================
local function selectBestPets(ownedPets, mode)
    local selected = {}
    local seen = {}
    local function addPet(name)
        if #selected >= MAX_PET_SLOTS then
            return
        end
        if PETS[name] and not seen[name] then
            seen[name] = true
            table.insert(selected, name)
        end
    end
    -- Required pet is always first if owned.
    for _, name in ipairs(ownedPets) do
        if name == REQUIRED_PET then
            addPet(name)
            break
        end
    end
    local function getScore(name)
        local pet = PETS[name]
        if mode == "Fast Rebirth" then
            return pet.rebirth
        elseif mode == "Fast Strength" then
            return pet.strength * 100 + pet.durability
        elseif mode == "Fast Reps" then
            return pet.repSpeed
        end
        return 0
    end
    local candidates = {}
    for _, name in ipairs(ownedPets) do
        if PETS[name] and not seen[name] then
            table.insert(candidates, name)
        end
    end
    table.sort(candidates, function(a, b)
        local scoreA = getScore(a)
        local scoreB = getScore(b)
        if scoreA == scoreB then
            return a < b
        end
        return scoreA > scoreB
    end)
    for _, name in ipairs(candidates) do
        addPet(name)
    end
    return selected
end
