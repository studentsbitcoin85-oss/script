-- Toggle switch. The look changes first; if the callback errors, the switch is put back and the error is
-- printed, so the switch can never show ON for a feature that did not start.
local function toggle(p, x, cy, initial, cb)
	local state = initial
	local tr = new("TextButton", {
		Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(x, cy - 13),
		Size = UDim2.fromOffset(44, 26), BackgroundColor3 = state and ONBG or OFFBG, BorderSizePixel = 0,
	}, p)
	round(tr, 13)
	local kn = new("Frame", {
		Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(state and 21 or 3, 3),
		BackgroundColor3 = state and Color3.new(1, 1, 1) or Color3.fromRGB(225, 225, 225), BorderSizePixel = 0,
	}, tr)
	round(kn, 10)
	local function paint(v)
		local i = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		TweenService:Create(tr, i, {BackgroundColor3 = v and ONBG or OFFBG}):Play()
		TweenService:Create(kn, i, {Position = UDim2.fromOffset(v and 21 or 3, 3),
			BackgroundColor3 = v and Color3.new(1, 1, 1) or Color3.fromRGB(225, 225, 225)}):Play()
	end
	local function set(v, silent)
		local prev = state
		state = v
		paint(state)
		if not silent then
			local ok, err = pcall(cb, state)
			if not ok then
				warn("[Muhaves] Toggle error: " .. tostring(err))
				state = prev
				paint(state)
			end
		end
	end
	tr.MouseButton1Click:Connect(function() set(not state) end)
	return set
end

-- Number parsing: spaces/commas/underscores ignored, dots = thousand separators when valid (1.000 = 1000),
-- otherwise a decimal point; suffixes K M B T Qa Qi Sx Sp Oc No Dc work. Returns nil if not a number.
local SUFFIX_MULT = {
	k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18,
	sx = 1e21, sp = 1e24, oc = 1e27, no = 1e30, dc = 1e33,
}
local function parseNumber(s)
	s = s:lower():gsub("[%s_,]", "")
	local num, suf = s:match("^([%d%.]+)(%a*)$")
	if not num then return nil end
	local parts = {}
	for p in (num .. "."):gmatch("([^%.]*)%.") do parts[#parts + 1] = p end
	if #parts >= 2 then
		local grouped = #parts[1] >= 1 and #parts[1] <= 3 and parts[1] ~= "0"
		for i = 2, #parts do
			if #parts[i] ~= 3 then grouped = false end
		end
		if grouped then
			num = table.concat(parts)
		elseif #parts > 2 then
			return nil
		end
	end
	local n = tonumber(num)
	if not n then return nil end
	if suf ~= "" then
		local m = SUFFIX_MULT[suf]
		if not m then return nil end
		n *= m
	end
	return n
end

local MAX_INPUT = 1e18
local function numberBox(p, x, y, w, h, value, cb, minVal, default, maxVal)
	local f = box(p, x, y, w, h, Color3.fromRGB(12, 12, 13), 8, true)
	stroke(f, Color3.fromRGB(85, 85, 90))
	local tb = new("TextBox", {
		BackgroundTransparency = 1, Text = value, TextSize = 16, Font = F.GothamBold, TextColor3 = TX,
		Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -30, 1, 0), TextXAlignment = LEFT,
		ClearTextOnFocus = false,
	}, f)
	autoFit(tb, 16, 7, w - 34)
	local last = tonumber(value) or 0
	local function commit()
		local n = parseNumber(tb.Text)
		if not n or n < (minVal or 0) then n = default or last end
		n = math.min(math.floor(n), maxVal or MAX_INPUT)
		last = n
		tb.Text = string.format("%.0f", n)
		cb(n)
	end
	tb.FocusLost:Connect(commit)
	local function stepBy(dir)
		local n = parseNumber(tb.Text) or last
		local step = math.max(1, 10 ^ math.max(0, #string.format("%.0f", n) - 2))
		tb.Text = string.format("%.0f", math.max(minVal or 0, n + dir * step))
		commit()
	end
	for k, sym in ipairs({"▲", "▼"}) do
		local b = new("TextButton", {
			Text = sym, TextSize = 9, Font = F.GothamBold, TextColor3 = MUTED,
			BackgroundTransparency = 1, AutoLocalize = false, AutoButtonColor = false,
			Position = UDim2.fromOffset(w - 26, (k - 1) * h / 2), Size = UDim2.fromOffset(20, h / 2),
		}, f)
		b.MouseButton1Click:Connect(function() stepBy(k == 1 and 1 or -1) end)
	end
end

-- Toggle setters, keyed by the plain title ("Auto Rebirth", "Eat Eggs (Auto)", ...).
local Toggles = {}
local RH = 58
local function rowW(title, sub, icon, num)
	local w = 14 + (icon and 38 or 56) + math.max(tw(title, 17, F.GothamBold), tw(sub, 13, F.GothamMedium)) + 14
	if num then w = w + 98 end
	return w
end
local function optRow(p, w, y, title, sub, state, cb, icon, numVal, numCb, numMin, numDef, numMax)
	local left = 14
	if icon then
		text(p, icon, 26, left - 2, y + RH / 2, 34, MUTED, F.GothamBold, CENTER)
		left = left + 38
	else
		Toggles[title] = toggle(p, left, y + RH / 2, state, cb)
		left = left + 56
	end
	text(p, title, 17, left, y + 20, 400, TX, F.GothamBold)
	text(p, sub, 13, left, y + 41, 400, SUB, F.GothamMedium)
	if numVal then numberBox(p, w - 14 - 84, y + 15, 84, 28, numVal, numCb, numMin, numDef, numMax) end
end

local function pillW(t, dot) return tw(t, 14, F.GothamMedium) + (dot and 52 or 26) end
local function pill(p, x, y, t, dot, wOverride)
	local w = wOverride or pillW(t, dot)
	local f = box(p, x, y, w, 32, Color3.fromRGB(10, 10, 11), 16)
	if dot then
		local d = new("Frame", {Position = UDim2.fromOffset(12, 9), Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = Color3.fromRGB(130, 130, 134), BorderSizePixel = 0}, f)
		round(d, 7)
	end
	local tx = dot and 34 or 13
	local lbl = text(f, t, 14, tx, 16, w - tx - 6, TX, F.GothamMedium)
	autoFit(lbl, 14, 9, w - tx - 12)
	return lbl, w
end

local PAD, GAP, HH, SW = 14, 10, 78, 200
local CX, CY = PAD + SW + PAD, PAD
local CONTENT_Y = PAD + 44 + GAP

local function cardHeader(card, icon, title, sub, status, extra, boldSub)
	local cw = card.Size.X.Offset
	text(card, icon, 28, PAD, PAD + 22, 36, TX, F.GothamBold, CENTER)
	text(card, title, 22, PAD + 44, PAD + 12, 400, TX, F.GothamBold)
	text(card, sub, 13, PAD + 44, PAD + 36, 600, boldSub and SUBB or SUB, boldSub and F.GothamBold or F.GothamMedium)
	local sLbl, eLbl
	local x = cw - PAD
	if status then
		local sw = math.max(pillW(status, true), pillW("Status: Target reached", true))
		x = x - sw
		sLbl = pill(card, x, PAD + 6, status, true, sw)
	end
	if extra then
		local w = pillW(extra, false) + 30
		x = x - 8 - w
		eLbl = pill(card, x, PAD + 6, extra, false, w)
	end
	return sLbl, eLbl
end

