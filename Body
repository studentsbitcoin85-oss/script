-- FAST REBIRTH
TabRebirth:AddSection("Auto Rebirth")
do
	local status = line(TabRebirth, "Status: Inactive")
	status.color = IDLE
	UI.Rebirth.Status = labelProxy(status)

	local totals = {gain = 0, rebirths = 0, runtime = 0}
	local rebE = line(TabRebirth, "")
	rebE.compose = function() return "Rebirths: " .. UI.Abbr(totals.rebirths) .. " (+" .. UI.Abbr(totals.gain) .. ")" end
	local timeE = line(TabRebirth, "")
	timeE.compose = function() return "Runtime: " .. timeText(totals.runtime) end
	local paceVals = {}
	local paceE = line(TabRebirth, "")
	paceE.compose = function() return "Pace: " .. rates(paceVals) end
	cells5(paceE, paceVals)
	markDirty(rebE) markDirty(timeE) markDirty(paceE)

	addInput(TabRebirth, "Rebirth Target", "Stop Auto Rebirth at this amount (0 = no limit)", tonumber(Saved.RebirthTarget) or 0, "RebirthTarget")
	addToggle(TabRebirth, "Auto Rebirth", "Farm strength and rebirth automatically", false, "AutoRebirth")

	TabRebirth:AddSection("Pets")
	addToggle(TabRebirth, "Equip Rebirth Pets", "Equip the best rebirth pets while rebirthing", Saved.EquipRebirthPets == true, "EquipRebirthPets")
	addToggle(TabRebirth, "Equip Reps Pets", "Equip pets with the best rep speed", Saved.PetMode == "reps", "EquipRepsPets")
	addToggle(TabRebirth, "Equip Strength Pets", "Equip pets with the best strength", Saved.PetMode == "strength", "EquipStrengthPets")

	local last, lastT = nil, os.clock()
	local MULT = {1, 60, 3600, 86400, 604800}
	task.spawn(function()
		while gui.Parent do
			task.wait(0.5)
			local now = os.clock()
			local dt = now - lastT
			lastT = now
			local obj = UI.RebirthSource.obj
			if obj then
				local value = obj.Value
				if last == nil then last = value end
				local active = UI.RbClock.active()
				if value > last and active then totals.gain += value - last end
				last = value
				if active then totals.runtime += dt end
				totals.rebirths = value
				if totals.runtime >= 1 then
					local rate = totals.gain / totals.runtime
					for i, m in ipairs(MULT) do paceVals[i] = UI.Abbr(rate * m) end
				end
				markDirty(rebE) markDirty(timeE) markDirty(paceE)
			end
		end
	end)
end

