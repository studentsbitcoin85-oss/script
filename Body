-- Label / teks yang di-update dari farming (objek palsu .Text / .TextColor3), dikirim ke Luna tiap 0,5 detik.
local C_WHITE = Color3.fromRGB(240, 240, 240)
local dirty = {}
local els = {}
local renders = {}

local function fake(init, group)
	local store = {Text = init, TextColor3 = C_WHITE}
	return setmetatable({}, {
		__index = function(_, k) return store[k] end,
		__newindex = function(_, k, v)
			if store[k] == v then return end
			store[k] = v
			if group then dirty[group] = true end
		end,
	})
end
local function fakeRow(n, init, group)
	local t = {}
	for i = 1, n do t[i] = fake(init, group) end
	return t
end

-- Warna status -> gaya label Luna (1 biasa, 2 hijau, 3 merah)
-- Hijau (2) = sedang aktif, abu-abu (1) = tidak dipakai / jeda, merah (3) = error.
local ACTIVE_WORDS = {"farming", "rebirthing", "slowing", "retrying", "not ready", "no response", "working"}
local function styleOf(c, text)
	if c.R > 0.9 and c.G < 0.5 then return 3 end
	if c.G > 0.9 and c.R < 0.5 then return 2 end
	local t = tostring(text or ""):lower()
	for _, w in ipairs(ACTIVE_WORDS) do
		if t:find(w, 1, true) then return 2 end
	end
	return 1
end

