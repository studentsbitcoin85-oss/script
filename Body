-- Live rebirth display (only reads values)
local rbClock = {active = function() return false end}
local rbSource = {obj = nil}
do
	local rbObj, startVal, tries = nil, nil, 0
	local activeTime, activeGain, lastN, lastT = 0, 0, nil, os.clock()
	task.spawn(function()
		while gui.Parent do
			if rbSource.obj and rbSource.obj.Parent then
				rbObj = rbSource.obj
			elseif not (rbObj and rbObj.Parent) then
				rbObj = nil
				if tries % 6 == 0 then pcall(function() rbObj = findRebirthObj() end) end
				tries += 1
			end
			local n
			if rbObj then
				n = tonumber(rbObj.Value)
			else
				local a = LocalPlayer:GetAttribute("Rebirths")
				if type(a) == "number" then n = a end
			end

			if n then
				if not startVal then startVal = n end
				if n < startVal then startVal = n end
				local gained = n - startVal
				S.rbRebirths.Text = full(n)
				S.rbGained.Text = abbr(gained)
				local nowT = os.clock()
				local isActive = rbClock.active()
				if isActive then
					activeTime += nowT - lastT
					if lastN and n > lastN then activeGain += n - lastN end
				end
				lastT, lastN = nowT, n
				local elapsed = activeTime
				S.rbRuntime.Text = string.format("🕒 %dd %dh %dm %ds",
					math.floor(elapsed / 86400), math.floor((elapsed % 86400) / 3600),
					math.floor((elapsed % 3600) / 60), math.floor(elapsed % 60))
				if elapsed >= 10 then
					local perHour = activeGain / elapsed * 3600
					S.rbHour.Text = abbr(perHour)
					S.rbDay.Text = abbr(perHour * 24)
					S.rbWeek.Text = abbr(perHour * 168)
				else
					S.rbHour.Text, S.rbDay.Text, S.rbWeek.Text = "--", "--", "--"
				end
			else
				S.rbRebirths.Text, S.rbGained.Text, S.rbHour.Text, S.rbDay.Text, S.rbWeek.Text = "N/A", "--", "--", "--", "--"
			end
			task.wait(0.5)
		end
	end)
end

