local SUFFIX = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}
local function trim(s)
	if s:find("%.") then s = s:gsub("0+$", ""):gsub("%.$", "") end
	return s
end
function UI.Abbr(n)
	n = tonumber(n) or 0
	local sign = n < 0 and "-" or ""
	n = math.abs(n)
	if n < 1000 then return sign .. trim(string.format("%.2f", n)) end
	local i = 1
	while n >= 1000 and i < #SUFFIX do
		n /= 1000
		i += 1
	end
	return sign .. trim(string.format("%.2f", n)) .. SUFFIX[i]
end

