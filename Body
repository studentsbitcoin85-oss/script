local function restyle(o)
	if o:IsA("TextLabel") and CARD_SETUP[o.Text] then
		local fn = CARD_SETUP[o.Text]
		task.defer(function() pcall(fn, o) end)
	end
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
		pcall(function() o.FontFace = FONT_BOLD end)
	end
	if o:IsA("TextBox") and not o.Name:lower():find("search", 1, true) then
		local fr = o.Parent
		if fr and fr:IsA("GuiObject") then
			local function fit()
				if fr.Size.X.Scale ~= 0 or fr.Size.X.Offset ~= INPUT_W then
					fr.Size = UDim2.new(0, INPUT_W, fr.Size.Y.Scale, fr.Size.Y.Offset)
				end
			end
			fit()
			fr.ClipsDescendants = true
			o.TextXAlignment = Enum.TextXAlignment.Center
			o.ClearTextOnFocus = false
			if not fr:FindFirstChildOfClass("UICorner") then
				local c = Instance.new("UICorner")
				c.CornerRadius = UDim.new(0, 8)
				c.Parent = fr
			end
			fr:GetPropertyChangedSignal("Size"):Connect(fit)
		end
	end
end

-- UI Size: UIScale di jendela Luna (slider di tab Extras). Disimpan di Saved.UiScale.
local uiScale = math.clamp(tonumber(Saved.UiScale) or 100, 60, 130)
local scaleObj
local saveToken = 0
local function applyScale(v)
	v = math.clamp(tonumber(v) or 100, 60, 130)
	uiScale = v
	if scaleObj and scaleObj.Parent then scaleObj.Scale = v / 100 end
	saveToken += 1
	local my = saveToken
	task.delay(1, function()
		if my == saveToken and Saved.UiScale ~= v then
			Saved.UiScale = v
			saveSettings()
		end
	end)
end

