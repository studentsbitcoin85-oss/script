local function makePage(name)
    local page = create("ScrollingFrame", {
        Name = name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Color3.fromRGB(150, 150, 150),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, Content)
    create("UIPadding", {
        PaddingTop = UDim.new(0, 14),
        PaddingLeft = UDim.new(0, 13),
        PaddingRight = UDim.new(0, 13),
        PaddingBottom = UDim.new(0, 12),
    }, page)
    create("UIListLayout", {
        Padding = UDim.new(0, 9),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)
    Pages[name] = page
    return page
end
local function makeLabel(parent, text, height)
    return create("TextLabel", {
        Size = UDim2.new(1, 0, 0, height or 30),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Color3.fromRGB(235, 235, 235),
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
end
local function makeButton(parent, text, callback)
    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Color3.fromRGB(35, 35, 35),
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = Color3.fromRGB(245, 245, 245),
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextWrapped = true,
    }, parent)
    create("UICorner", {
        CornerRadius = UDim.new(0, 6),
    }, button)
    button.Activated:Connect(callback)
    return button
end
local function makeToggle(parent, key, title)
    local button
    local function update()
        local enabled = State.toggles[key] == true
        button.Text = title .. "   [" .. (enabled and "ON" or "OFF") .. "]"
        button.BackgroundColor3 = enabled
            and Color3.fromRGB(75, 75, 75)
            or Color3.fromRGB(35, 35, 35)
    end
    button = makeButton(parent, title, function()
        State.toggles[key] = not State.toggles[key]
        update()
    end)
    update()
    return button
end
local function showTab(name)
    State.currentTab = name
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end
    for tabName, button in pairs(TabButtons) do
        button.BackgroundColor3 = tabName == name
            and Color3.fromRGB(75, 75, 75)
            or Color3.fromRGB(30, 30, 30)
    end
end
local function makeTab(name, order)
    local button = create("TextButton", {
        Name = name,
        LayoutOrder = order,
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = Color3.fromRGB(30, 30, 30),
        BorderSizePixel = 0,
        Text = name,
        TextColor3 = Color3.fromRGB(245, 245, 245),
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextWrapped = true,
    }, Sidebar)
    create("UICorner", {
        CornerRadius = UDim.new(0, 6),
    }, button)
    TabButtons[name] = button
    button.Activated:Connect(function()
        showTab(name)
    end)
    return makePage(name)
end
