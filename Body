local function create(className, properties, parent)
    local object = Instance.new(className)

    for property, value in pairs(properties or {}) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function corner(parent, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or 10)
    }, parent)
end

local function outline(parent, color, thickness)
    return create("UIStroke", {
        Color = color or CONFIG.Stroke,
        Thickness = thickness or 1,
        Transparency = 0
    }, parent)
end

local function label(parent, value, position, size, textSize, color, font)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Position = position,
        Size = size,
        Text = value,
        TextColor3 = color or CONFIG.Text,
        TextSize = textSize or 14,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true
    }, parent)
end

local function makeButton(parent, value, position, size)
    local button = create("TextButton", {
        Position = position,
        Size = size,
        BackgroundColor3 = CONFIG.Card,
        Text = value,
        TextColor3 = CONFIG.Text,
        TextSize = 13,
        Font = Enum.Font.GothamSemibold,
        AutoButtonColor = true
    }, parent)

    corner(button, 8)
    outline(button)

    return button
end

local function makeToggle(parent, title, callback)
    local row = create("Frame", {
        BackgroundColor3 = CONFIG.Card,
        Size = UDim2.new(1, 0, 0, 55)
    }, parent)

    corner(row, 9)
    outline(row)

    label(
        row,
        title,
        UDim2.new(0, 12, 0, 0),
        UDim2.new(1, -75, 1, 0),
        13,
        CONFIG.Text,
        Enum.Font.GothamMedium
    )

    local switch = create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 42, 0, 23),
        BackgroundColor3 = CONFIG.Stroke,
        Text = "",
        AutoButtonColor = false
    }, row)

    corner(switch, 20)

    local knob = create("Frame", {
        Position = UDim2.new(0, 3, 0, 3),
        Size = UDim2.new(0, 17, 0, 17),
        BackgroundColor3 = CONFIG.Text
    }, switch)

    corner(knob, 20)

    local enabled = false

    switch.MouseButton1Click:Connect(function()
        enabled = not enabled

        TweenService:Create(switch, TweenInfo.new(0.15), {
            BackgroundColor3 = enabled and CONFIG.Accent or CONFIG.Stroke
        }):Play()

        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = enabled
                and UDim2.new(1, -20, 0, 3)
                or UDim2.new(0, 3, 0, 3)
        }):Play()

        -- UI saja. Callback fitur belum diimplementasikan.
        if callback then
            callback(enabled)
        end
    end)

    return row
end

local function makeInput(parent, title, placeholder, callback)
    local row = create("Frame", {
        BackgroundColor3 = CONFIG.Card,
        Size = UDim2.new(1, 0, 0, 65)
    }, parent)

    corner(row, 9)
    outline(row)

    label(
        row,
        title,
        UDim2.new(0, 12, 0, 5),
        UDim2.new(1, -24, 0, 22),
        12,
        CONFIG.SubText
    )

    local input = create("TextBox", {
        Position = UDim2.new(0, 12, 0, 31),
        Size = UDim2.new(1, -24, 0, 26),
        BackgroundColor3 = CONFIG.Background,
        Text = "",
        PlaceholderText = placeholder,
        PlaceholderColor3 = CONFIG.SubText,
        TextColor3 = CONFIG.Text,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false
    }, row)

    corner(input, 6)

    input.FocusLost:Connect(function()
        if callback then
            callback(input.Text)
        end
    end)

    return row
end

local function makeSection(parent, title, subtitle)
    local section = create("Frame", {
        BackgroundColor3 = CONFIG.Panel,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y
    }, parent)

    corner(section, 12)
    outline(section)

    local padding = create("UIPadding", {
        PaddingTop = UDim.new(0, 14),
        PaddingBottom = UDim.new(0, 14),
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 14)
    }, section)

    local list = create("UIListLayout", {
        Padding = UDim.new(0, 9),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, section)

    label(
        section,
        title,
        UDim2.new(),
        UDim2.new(1, 0, 0, 25),
        16,
        CONFIG.Text,
        Enum.Font.GothamBold
    ).LayoutOrder = 1

    label(
        section,
        subtitle or "",
        UDim2.new(),
        UDim2.new(1, 0, 0, 20),
        11,
        CONFIG.SubText
    ).LayoutOrder = 2

    return section
end

