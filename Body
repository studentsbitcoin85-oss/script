	local greeting = hour < 11 and "Good Morning" or hour < 15 and "Good Afternoon" or hour < 19 and "Good Evening" or "Good Night"
	TabHome:AddParagraph({
		Title = greeting .. ", " .. clean(lp.DisplayName),
		Content = "MuhavesXMain Private Farming v" .. tostring(CONST.VERSION),
	})

	TabHome:AddSection("Session")
	local startedAt = os.clock()
	local session = line(TabHome, "Session: 0d 0h 0m 0s")
	local fps = line(TabHome, "FPS: 0")
	local ping = line(TabHome, "Ping: 0 ms")
	session.compose = function() return "Session: " .. timeText(os.clock() - startedAt) end

	local frames, last = 0, os.clock()
	local fpsConn = RunService.RenderStepped:Connect(function() frames += 1 end)
	gui.Destroying:Connect(function() fpsConn:Disconnect() end)

	TabHome:AddSection("Your Stats")
	local strE = line(TabHome, "Strength: -")
	local duraE = line(TabHome, "Durability: -")
	local rebE = line(TabHome, "Rebirths: -")
	local killE = line(TabHome, "Kills: -")

