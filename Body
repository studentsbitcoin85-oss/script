-- FAST FARMING: Auto Rebirth
TabFarm:AddSection("Auto Rebirth")

do
	local status = paragraph(TabFarm, "Status: Inactive", "")
	UI.Rebirth.Status = labelProxy(status)
	status.color = IDLE

	local totals = {gain = 0, rebirths = 0, runtime = 0}
	local stats = paragraph(TabFarm, "Rebirth Stats", "")
	stats.compose = function()
		return string.format("Rebirths: %s (+%s)\nRuntime: %s", UI.Abbr(totals.rebirths), UI.Abbr(totals.gain), timeText(totals.runtime))
	end
	stats.desc = stats.compose()
	stats.shownDesc = stats.desc

	local paceVals = {}
	local pace = paragraph(TabFarm, "Rebirth Pace", "")
	pace.compose = function() return line5(paceVals) end
	cells5(pace, paceVals)
	pace.desc = pace.compose()
	pace.shownDesc = pace.desc

	addInput(TabFarm, "Rebirth Target", "Stop Auto Rebirth at this amount (0 = no limit)", tonumber(Saved.RebirthTarget) or 0, "RebirthTarget")
	addToggle(TabFarm, "Auto Rebirth", "Farm strength and rebirth automatically", false, "AutoRebirth")
	addToggle(TabFarm, "Equip Rebirth Pets", "Equip the best rebirth pets while rebirthing", Saved.EquipRebirthPets == true, "EquipRebirthPets")

	-- Rebirth tracking (clock follows UI.RbClock.active)
	local last, lastT = nil, os.clock()
	local MULT = {1, 60, 3600, 86400, 604800}
	task.spawn(function()
		while gui.Parent do
			task.wait(0.5)
			local now = os.clock()
			local dt = now - lastT
			lastT = now
			local obj = UI.RebirthSource.obj
			if obj then
				local value = obj.Value
				if last == nil then last = value end
				local active = UI.RbClock.active()
				if value > last and active then totals.gain += value - last end
				last = value
				if active then totals.runtime += dt end
				totals.rebirths = value
				if totals.runtime >= 1 then
					local rate = totals.gain / totals.runtime
					for i, m in ipairs(MULT) do paceVals[i] = UI.Abbr(rate * m) end
				end
				markDirty(stats)
				markDirty(pace)
			end
		end
	end)
end

