-- NOTICE
TabNotice:AddSection("Script")
do
	local entry = paragraph(TabNotice, "Checking...", "")
	local state = {status = "Checking...", check = "⏳"}
	local function refresh() entry.title = state.status .. "  " .. state.check markDirty(entry) end
	entry.title = "Checking...  ⏳"
	entry.shownTitle = entry.title
	UI.Notice.Status = setmetatable({}, {
		__index = function(_, k) if k == "Text" then return state.status end if k == "TextColor3" then return entry.color end end,
		__newindex = function(_, k, v)
			if k == "Text" then
				state.status = tostring(v)
				if state.status == "Working" then state.check = "✅" elseif state.status == "Error" then state.check = "❌" end
				refresh()
			elseif k == "TextColor3" then
				entry.color = v
				markDirty(entry)
			end
		end,
	})
	UI.Notice.Check = setmetatable({}, {
		__index = function(_, k) if k == "Text" then return state.check end end,
		__newindex = function(_, k, v)
			if k == "Text" then
				state.check = tostring(v)
				refresh()
			end
		end,
	})
end

