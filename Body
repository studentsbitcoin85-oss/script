-- Helpers
local function fire(name, value)
	local fn = UI.Callbacks[name]
	if fn then
		local ok, err = pcall(fn, value)
		if not ok then warn("[Muhaves UI] " .. name .. ": " .. tostring(err)) end
	else
		UI.Pending[name] = {t = os.clock(), v = value}
	end
end

local function addToggle(tab, title, description, default, callbackName)
	local muted = true
	local toggle = tab:AddToggle("T_" .. title, {
		Title = title,
		Description = description,
		Default = default and true or false,
		Callback = function(value)
			if muted then return end
			fire(callbackName, value)
		end,
	})
	muted = false
	UI.Toggles[title] = function(state, silent)
		if silent then muted = true end
		pcall(function() toggle:SetValue(state and true or false) end)
		muted = false
	end
	return toggle
end

local function addInput(tab, title, description, default, callbackName)
	local muted = true
	local input = tab:AddInput("I_" .. title, {
		Title = title,
		Description = description,
		Default = tostring(default),
		Placeholder = tostring(default),
		Numeric = true,
		Finished = true,
		Callback = function(value)
			if muted then return end
			fire(callbackName, value)
		end,
	})
	muted = false
	return input
end

-- Label updates are batched (max ~3x per second) so the UI stays light.
local dirty = {}
local function markDirty(entry) dirty[entry] = true end
task.spawn(function()
	while gui.Parent do
		task.wait(0.3)
		for entry in pairs(dirty) do
			dirty[entry] = nil
			pcall(entry.apply)
		end
	end
end)

local function paragraph(tab, title, desc)
	local element = tab:AddParagraph({Title = title, Content = desc or ""})
	local entry = {title = title, desc = desc or "", shownTitle = title, shownDesc = desc or ""}
	local titleLabel
	entry.apply = function()
		if entry.title ~= entry.shownTitle then
			entry.shownTitle = entry.title
			titleLabel = nil
			pcall(function() element:SetTitle(entry.title) end)
		end
		if entry.compose then entry.desc = entry.compose() end
		if entry.desc ~= entry.shownDesc then
			entry.shownDesc = entry.desc
			pcall(function() element:SetDesc(entry.desc) end)
		end
		if entry.color then
			if not titleLabel or not titleLabel.Parent then
				pcall(function()
					for _, d in ipairs(element.Frame:GetDescendants()) do
						if d:IsA("TextLabel") and d.Text == entry.shownTitle then
							titleLabel = d
							break
						end
					end
				end)
			end
			if titleLabel then pcall(function() titleLabel.TextColor3 = entry.color end) end
		end
	end
	return entry
end

-- Object with .Text / .TextColor3 that the farming script can write to.
local function labelProxy(entry, onText)
	return setmetatable({}, {
		__index = function(_, key)
			if key == "Text" then return entry.title end
			if key == "TextColor3" then return entry.color end
		end,
		__newindex = function(_, key, value)
			if key == "Text" then
				entry.title = tostring(value)
				if onText then onText(entry.title) end
			elseif key == "TextColor3" then
				entry.color = value
			end
			markDirty(entry)
		end,
	})
end

-- Several values shown in one paragraph.
local function valueCell(entry, store, key)
	return setmetatable({}, {
		__index = function(_, k) if k == "Text" then return store[key] end end,
		__newindex = function(_, k, v)
			if k == "Text" then
				store[key] = tostring(v)
				markDirty(entry)
			end
		end,
	})
end

local function cells5(entry, store)
	local list = {}
	for i = 1, 5 do
		store[i] = "0"
		list[i] = valueCell(entry, store, i)
	end
	return list
end

local function line5(v)
	return string.format("%s/s  |  %s/min  |  %s/h  |  %s/d  |  %s/w", v[1], v[2], v[3], v[4], v[5])
end

local function timeText(e)
	return string.format("%dd %dh %dm %ds", math.floor(e / 86400), math.floor((e % 86400) / 3600),
		math.floor((e % 3600) / 60), math.floor(e % 60))
end

