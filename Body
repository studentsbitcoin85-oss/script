-- REBIRTH: hanya MEMBACA angka rebirth pemain untuk ditampilkan di UI (tidak ada aksi ke game).
local SUFFIX = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}

local function abbr(n)
	local neg = n < 0
	n = math.abs(n)
	local i = 1
	while n >= 1000 and i < #SUFFIX do
		n /= 1000
		i += 1
	end
	local s = i == 1 and tostring(math.floor(n + 0.5)) or string.format("%.2f", n)
	return (neg and "-" or "") .. s .. SUFFIX[i]
end

-- angka penuh dengan titik pemisah ribuan: 150000 -> 150.000
local function full(n)
	local s = string.format("%.0f", math.abs(n))
	s = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	s = s:gsub("^%.", "")
	return (n < 0 and "-" or "") .. s
end

local function isNum(v) return v:IsA("IntValue") or v:IsA("NumberValue") end

-- cari nilai rebirth: leaderstats.Rebirths dulu, lalu nama apa pun yang mengandung "rebirth" di pemain
local function findRebirthObj()
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	local direct = ls and ls:FindFirstChild("Rebirths")
	if direct and isNum(direct) then return direct end
	for _, root in ipairs({ls, LocalPlayer}) do
		if root then
			for _, d in ipairs(root:GetDescendants()) do
				if isNum(d) and d.Name:lower():find("rebirth", 1, true) then return d end
			end
		end
	end
	return nil
end

