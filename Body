local nav = {{"⚡", "Fast Farming"}, {"⚙", "Other"}, {"ℹ", "Info"}}
local navBtns = {}
local charImg

local function selectNav(idx, instant)
	for i, b in ipairs(navBtns) do
		local on = i == idx
		b.BackgroundTransparency = on and 0 or 1
		b.TextColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(215, 215, 218)
		b:FindFirstChildOfClass("UIStroke").Enabled = on
		pages[i].Visible = on
	end
	local sz = sizes[idx]
	local W = CX + sz.w + PAD
	local H = math.max(HH + PAD + sz.h + PAD, HH + PAD + SIDEMIN + PAD)
	cur.w, cur.h = W, H
	local sideH = H - HH - 2 * PAD
	local charH = math.min(CHAR_MAX_H, sideH - 172 - 8)
	if charImg and charImg:IsA("ImageLabel") then
		charImg.ScaleType = charH >= 300 and Enum.ScaleType.Stretch or Enum.ScaleType.Fit
	end
	local goals = {
		{win, {Size = UDim2.fromOffset(W, H)}},
		{sidebar, {Size = UDim2.fromOffset(SW, sideH)}},
	}
	if charImg then table.insert(goals, {charImg, {Size = UDim2.fromOffset(SW - 16, charH)}}) end
	for _, g in ipairs(goals) do
		if instant then
			for k, v in pairs(g[2]) do g[1][k] = v end
		else
			TweenService:Create(g[1], TweenInfo.new(0.2), g[2]):Play()
		end
