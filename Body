-- Buka / kecilkan
local open = true
local token = 0 -- mencegah animasi lama menimpa yang baru

local function setOpen(s)
	if open == s then return end
	open = s
	token += 1
	local my = token

	if s then
		-- logo menghilang dulu, lalu UI membesar
		local t = TweenService:Create(dockScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad), {Scale = 0})
		t:Play()
		t.Completed:Connect(function()
			if token == my then dock.Visible = false end
		end)
		root.Visible = true
		TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Scale = fit()}):Play()
	else
		-- UI mengecil dulu, baru logo muncul
		local t = TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Scale = 0.001})
		t:Play()
		t.Completed:Connect(function()
			if token ~= my then return end
			root.Visible = false
			dock.Visible = true
			TweenService:Create(dockScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
		end)
	end
end

cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
	if open then scale.Scale = fit() end
end)

