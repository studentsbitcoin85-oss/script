			task.wait(1)
			local now = os.clock()
			fps.title = "FPS: " .. math.floor(frames / math.max(now - last, 0.001) + 0.5)
			frames, last = 0, now
			pcall(function()
				local item = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]
				ping.title = "Ping: " .. math.floor(item:GetValue() + 0.5) .. " ms"
			end)
			markDirty(session) markDirty(fps) markDirty(ping)
			show(strE, "Strength")
			show(duraE, "Durability")
			show(rebE, "Rebirths")
			show(killE, "Kills")
		end
	end)
end

