-- Komponen
local function toggle(p, x, cy, initial, cb)
	local state = initial
	local tr = new("TextButton", {
		Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(x, cy - 13),
		Size = UDim2.fromOffset(44, 26), BackgroundColor3 = state and ONBG or OFFBG, BorderSizePixel = 0,
	}, p)
	round(tr, 13)
	local kn = new("Frame", {
		Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(state and 21 or 3, 3),
		BackgroundColor3 = state and WHITE or KNOB_OFF, BorderSizePixel = 0,
	}, tr)
	round(kn, 10)
	local info = TweenInfo.new(0.15)
	tr.MouseButton1Click:Connect(function()
		state = not state
		TweenService:Create(tr, info, {BackgroundColor3 = state and ONBG or OFFBG}):Play()
		TweenService:Create(kn, info, {
			Position = UDim2.fromOffset(state and 21 or 3, 3),
			BackgroundColor3 = state and WHITE or KNOB_OFF,
		}):Play()
		cb(state)
	end)
end

local function numberBox(p, x1, y1, x2, y2, value, cb)
	local f = box(p, x1, y1, x2, y2, SEC, 8, true)
	stroke(f, Color3.fromRGB(85, 85, 90))
	local tb = new("TextBox", {
		BackgroundTransparency = 1, Text = value, TextSize = 20, Font = F.Gotham, TextColor3 = TX,
		Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -32, 1, 0), TextXAlignment = LEFT,
		ClearTextOnFocus = false,
	}, f)
	local h = y2 - y1
	text(f, "⌃", 8, x2 - x1 - 20, h / 2 - 8, 14, MUTED, F.GothamBold, CENTER)
	text(f, "⌄", 8, x2 - x1 - 20, h / 2 + 8, 14, MUTED, F.GothamBold, CENTER)
	tb.FocusLost:Connect(function()
		local n = tonumber((tb.Text:gsub("[%.,%s]", "")))
		if n then cb(n) end
	end)
end

-- judul (cy-11) + keterangan (cy+11); maxW = lebar tersedia
local function rowLabels(p, titleX, cy, title, sub, maxW)
	text(p, title, 15, titleX, cy - 11, maxW, TX, F.GothamMedium, LEFT, true)
	text(p, sub, 11, titleX, cy + 11, maxW, SUB, F.Gotham, LEFT, true)
end

local function toggleRow(p, tx, titleX, cy, title, sub, initial, cb, maxW)
	toggle(p, tx, cy, initial, safe(cb))
	rowLabels(p, titleX, cy, title, sub, maxW or 380)
end

local function iconRow(p, icon, ix, titleX, cy, title, sub, maxW)
	text(p, icon, 22, ix - 22, cy, 44, MUTED, F.GothamBold, CENTER)
	rowLabels(p, titleX, cy, title, sub, maxW or 260)
end

local function pill(p, x1, y1, x2, y2, t)
	local f = box(p, x1, y1, x2, y2, Color3.fromRGB(10, 10, 11), 16)
	local h = y2 - y1
	local d = new("Frame", {
		Position = UDim2.fromOffset(12, h / 2 - 7), Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.fromRGB(130, 130, 134), BorderSizePixel = 0,
	}, f)
	round(d, 7)
	return text(f, t, 11, 34, h / 2, x2 - x1 - 42, TX, F.Gotham, LEFT, true)
end

-- header panel: ikon + judul + subjudul + pill status (kanan)
local function panelHeader(p, icon, title, sub, top, status)
	text(p, icon, 24, 321, top + 35, 44, TX, F.GothamBold, CENTER)
	text(p, title, 19, 380, top + 27, 400, TX, F.GothamMedium, LEFT, true)
	text(p, sub, 12, 380, top + 51, 640, SUB, F.Gotham, LEFT, true)
	return pill(p, 1072, top + 19, 1212, top + 51, status)
end

-- baris statistik: ikon | nama | nilai
local function stat(p, icon, name, value, cy, ix, nx, nw, vx, vw, size, align)
	text(p, icon, size + 2, ix - 11, cy, 22, MUTED, F.Gotham, CENTER)
	text(p, name, size, nx, cy, nw, Color3.fromRGB(205, 205, 208), F.Gotham, LEFT, true)
	return text(p, value, size, vx, cy, vw, TX, F.Gotham, align or LEFT, true)
end

