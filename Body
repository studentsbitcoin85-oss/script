-- Helpers
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) new("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
local function stroke(o, c, t) new("UIStroke", {Color = c or LINE, Thickness = t or 1}, o) end

local twCache, twCount = {}, 0
local function tw(t, size, font)
	font = font or F.Gotham
	local key = font.Value .. "|" .. size .. "|" .. t
	local hit = twCache[key]
	if hit then return hit end
	local ok, v = pcall(function()
		return TextService:GetTextSize(t, size, font, Vector2.new(10000, 1000)).X
	end)
	local w = math.ceil(ok and v or (#t * size * 0.6))
	if #t <= 60 then
		if twCount > 500 then twCache, twCount = {}, 0 end
		twCache[key] = w
		twCount += 1
	end
	return w
end

local function box(p, x, y, w, h, bg, r, noStroke)
	local f = new("Frame", {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = bg, BorderSizePixel = 0,
	}, p)
	round(f, r or 12)
	if not noStroke then stroke(f) end
	return f
end

local function text(p, t, size, x, cy, w, color, font, align)
	local h = size + 10
	return new("TextLabel", {
		BackgroundTransparency = 1, Text = t, TextSize = size, Font = font or F.Gotham,
		Position = UDim2.fromOffset(math.floor(x), math.floor(cy - h / 2)), Size = UDim2.fromOffset(w, h),
		TextColor3 = color or TX, TextXAlignment = align or LEFT, TextYAlignment = Enum.TextYAlignment.Center,
		AutoLocalize = false,
	}, p)
end

local function autoFit(lbl, maxSize, minSize, avail)
	minSize = minSize or 8
	avail = avail or lbl.Size.X.Offset
	local target = maxSize
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	lbl.TextWrapped = false
	lbl.TextScaled = false
	local function shown()
		local ok, ct = pcall(function() return lbl.ContentText end)
		if ok and type(ct) == "string" and ct ~= "" then return ct end
		return lbl.Text
	end
	local function apply()
		if avail <= 0 then return end
		local txt, sz = shown(), maxSize
		while sz > minSize and tw(txt, sz, lbl.Font) > avail do sz -= 1 end
		target = sz
		if lbl.TextSize ~= sz then lbl.TextSize = sz end
	end
	lbl:GetPropertyChangedSignal("Text"):Connect(apply)
	pcall(function() lbl:GetPropertyChangedSignal("ContentText"):Connect(apply) end)
	lbl:GetPropertyChangedSignal("TextScaled"):Connect(function()
		if lbl.TextScaled then lbl.TextScaled = false end
		apply()
	end)
	lbl:GetPropertyChangedSignal("TextWrapped"):Connect(function()
		if lbl.TextWrapped then lbl.TextWrapped = false end
	end)
	lbl:GetPropertyChangedSignal("TextSize"):Connect(function()
		if lbl.TextSize ~= target then lbl.TextSize = target end
	end)
	apply()
	return lbl
end

