    local function slicer()
        local t0 = os.clock()
        return function()
            if os.clock() - t0 > 0.004 then
                task.wait()
                t0 = os.clock()
            end
        end
    end

    local function walk(root, fn)
        local step = slicer()
        local stack, n = {root}, 1
        while n > 0 do
            local inst = stack[n]
            stack[n] = nil
            n -= 1
            local ok, children = pcall(inst.GetChildren, inst)
            if ok then
                for _, child in ipairs(children) do
                    local okFn, stop = pcall(fn, child)
                    if okFn and stop then return end
                    n += 1
                    stack[n] = child
                    step()
                end
            end
            step()
        end
    end

