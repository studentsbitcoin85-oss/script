local function selectPage(name)
    for pageName, page in pairs(Pages) do
        page.Visible = pageName == name
    end

    for _, button in ipairs(Sidebar:GetChildren()) do
        if button:IsA("TextButton") then
            local isActive = button.Name == name

            button.BackgroundTransparency = isActive and 0 or 1

            local border = button:FindFirstChildOfClass("UIStroke")
            if border then
                border.Enabled = isActive
            end
        end
    end

    local page = Pages[name]
    if not page then return end

    local contentWidth = page.CanvasSize.X.Offset
    local contentHeight = page.CanvasSize.Y.Offset

    local viewportHeight = math.min(
        contentHeight,
        MAX_PAGE_HEIGHT
    )

    page.Size = UDim2.fromOffset(
        contentWidth,
        viewportHeight
    )

    currentWidth = CONTENT_X + contentWidth + PAD
    currentHeight = HEADER_H + PAD + viewportHeight + PAD

    local viewport = workspace.CurrentCamera
        and workspace.CurrentCamera.ViewportSize

    if viewport then
        local sidebarHeight = math.max(
            viewportHeight,
            300
        )

        Sidebar.Size = UDim2.fromOffset(
            SIDEBAR_W,
            sidebarHeight
        )
    end

    minimized = false
    Body.Visible = true

    TweenService:Create(Window, TweenInfo.new(0.2), {
        Size = UDim2.fromOffset(currentWidth, currentHeight),
    }):Play()

    page.CanvasPosition = Vector2.zero
    fitWindow()
end

for _, item in ipairs(NavItems) do
    local button = Sidebar:FindFirstChild(item[2])

    if button then
        button.MouseButton1Click:Connect(function()
            selectPage(item[2])
        end)
    end
end

