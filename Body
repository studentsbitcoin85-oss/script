-- Black & white theme + font
do
	local WHITE = Color3.fromRGB(235, 235, 235)
	local function mono(color)
		local _, s, v = color:ToHSV()
		if s > 0.2 then return WHITE, true end
		return Color3.new(v, v, v), false
	end
	local applying = false
	local function recolor(obj, prop, hook)
		local ok, current = pcall(function() return obj[prop] end)
		if not ok or typeof(current) ~= "Color3" then return end
		local target, accent = mono(current)
		if target ~= current then
			applying = true
			pcall(function() obj[prop] = target end)
			applying = false
		end
		if accent and hook then
			obj:GetPropertyChangedSignal(prop):Connect(function()
				if applying then return end
				recolor(obj, prop, false)
			end)
		end
	end
	local function paint(obj)
		if obj:IsA("GuiObject") then recolor(obj, "BackgroundColor3", true) end
		if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
			recolor(obj, "TextColor3", true)
			pcall(function()
				obj.Font = obj.TextSize >= 17 and Enum.Font.GothamBold or Enum.Font.GothamMedium
			end)
		elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			recolor(obj, "ImageColor3", true)
		elseif obj:IsA("UIStroke") then
			recolor(obj, "Color", true)
		elseif obj:IsA("UIGradient") then
			pcall(function()
				local points = {}
				for _, key in ipairs(obj.Color.Keypoints) do
					table.insert(points, ColorSequenceKeypoint.new(key.Time, (mono(key.Value))))
				end
				obj.Color = ColorSequence.new(points)
			end)
		end
	end
	task.defer(function()
		for _, obj in ipairs(gui:GetDescendants()) do paint(obj) end
		gui.DescendantAdded:Connect(function(obj) task.defer(paint, obj) end)
	end)
end

