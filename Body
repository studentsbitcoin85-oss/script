-- Helper
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local function round(o, r) new("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
local function stroke(o, c) new("UIStroke", {Color = c or LINE, Thickness = 1}, o) end

local function box(parent, x, y, w, h, bg, r)
	local f = new("Frame", {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = bg or CARD, BorderSizePixel = 0,
	}, parent)
	round(f, r or 10)
	stroke(f)
	return f
end

local function label(parent, t, size, x, y, w, h, color, font, align)
	return new("TextLabel", {
		BackgroundTransparency = 1, Text = t, TextSize = size,
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		TextColor3 = color or TX, Font = font or Enum.Font.Gotham,
		TextXAlignment = align or L, TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
end

local function toggle(parent, x, y, initial, cb)
	local state = initial
	local track = new("TextButton", {
		Text = "", AutoButtonColor = false,
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(42, 22),
		BackgroundColor3 = state and ONBG or OFFBG, BorderSizePixel = 0,
	}, parent)
	round(track, 11)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = state and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3),
		BackgroundColor3 = state and Color3.new(1, 1, 1) or Color3.fromRGB(215, 215, 215),
		BorderSizePixel = 0,
	}, track)
	round(knob, 8)
	track.MouseButton1Click:Connect(function()
		state = not state
		local info = TweenInfo.new(0.15)
		TweenService:Create(track, info, {BackgroundColor3 = state and ONBG or OFFBG}):Play()
		TweenService:Create(knob, info, {
			Position = state and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3),
			BackgroundColor3 = state and Color3.new(1, 1, 1) or Color3.fromRGB(215, 215, 215),
		}):Play()
		cb(state)
	end)
	return track
end

local function numberBox(parent, x, y, w, text, cb)
	local f = new("Frame", {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, 28),
		BackgroundColor3 = PANEL, BorderSizePixel = 0,
	}, parent)
	round(f, 7)
	stroke(f, Color3.fromRGB(70, 70, 74))
	local tb = new("TextBox", {
		BackgroundTransparency = 1, Text = text, TextSize = 13, Font = Enum.Font.Gotham,
		TextColor3 = TX, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0),
		TextXAlignment = L, ClearTextOnFocus = false,
	}, f)
	tb.FocusLost:Connect(function()
		local n = tonumber((tb.Text:gsub("%.", "")))
		if n then cb(n) end
	end)
	return tb
end

-- Baris opsi: judul + deskripsi + kontrol di kanan
local function optionRow(parent, y, w, title, sub, kind, value, cb, icon)
	local left = 14
	if icon then
		label(parent, icon, 18, 8, y + 12, 28, 28, MUTED, Enum.Font.Gotham, C)
		left = 44
	end
	label(parent, title, 13, left, y + 8, w - left - 100, 18, TX, Enum.Font.GothamMedium)
	label(parent, sub, 10, left, y + 27, w - left - 70, 16, MUTED)
	if kind == "toggle" then
		toggle(parent, w - 56, y + 15, value, cb)
	else
		numberBox(parent, w - 92, y + 12, 80, value, cb)
	end
end

local function divider(parent, y, w)
	new("Frame", {
		Position = UDim2.fromOffset(10, y), Size = UDim2.fromOffset(w - 20, 1),
		BackgroundColor3 = LINE, BorderSizePixel = 0,
	}, parent)
end

local function statRow(parent, y, w, icon, name, value, size)
	label(parent, icon, 13, 12, y, 20, 22, MUTED, Enum.Font.Gotham, C)
	label(parent, name, size or 12, 38, y, 90, 22, Color3.fromRGB(205, 205, 208))
	return label(parent, value, size or 12, 130, y, w - 142, 22, TX, Enum.Font.Gotham, R)
end

local function pill(parent, x, y, text)
	local p = box(parent, x, y, 130, 28, Color3.fromRGB(10, 10, 11), 14)
	local dot = new("Frame", {
		Position = UDim2.fromOffset(12, 9), Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Color3.fromRGB(120, 120, 124), BorderSizePixel = 0,
	}, p)
	round(dot, 5)
	local t = label(p, text, 11, 30, 0, 96, 28, TX)
	return t, dot
end

local function sectionHeader(parent, icon, title, sub, status, w)
	label(parent, icon, 22, 12, 8, 34, 36, TX, Enum.Font.GothamBold, C)
	label(parent, title, 17, 52, 6, 250, 22, TX, Enum.Font.GothamMedium)
	label(parent, sub, 11, 52, 28, 300, 16, MUTED)
	return pill(parent, w - 144, 12, status)
end

