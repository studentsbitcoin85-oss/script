-- Helper (ukuran kartu dihitung dari panjang teks, jadi tidak ada ruang kosong)
local TextService = game:GetService("TextService")

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) new("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
local function stroke(o, c, t) new("UIStroke", {Color = c or LINE, Thickness = t or 1}, o) end

-- lebar teks (px)
local function tw(t, size, font)
	local ok, v = pcall(function()
		return TextService:GetTextSize(t, size, font or F.Gotham, Vector2.new(10000, 1000)).X
	end)
	return math.ceil(ok and v or (#t * size * 0.6))
end

local function box(p, x, y, w, h, bg, r, noStroke)
	local f = new("Frame", {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = bg, BorderSizePixel = 0,
	}, p)
	round(f, r or 12)
	if not noStroke then stroke(f) end
	return f
end

-- x = kiri, cy = titik tengah vertikal
local function text(p, t, size, x, cy, w, color, font, align)
	local h = size + 10
	return new("TextLabel", {
		BackgroundTransparency = 1, Text = t, TextSize = size, Font = font or F.Gotham,
		Position = UDim2.fromOffset(x, cy - h / 2), Size = UDim2.fromOffset(w, h),
		TextColor3 = color or TX, TextXAlignment = align or LEFT, TextYAlignment = Enum.TextYAlignment.Center,
	}, p)
end

local function hline(p, x, y, w)
	new("Frame", {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, 1),
		BackgroundColor3 = LINE, BorderSizePixel = 0}, p)
end

-- Loader gambar: ImageLabel langsung tampil. Urutan percobaan tiap 4 detik kalau belum termuat:
-- Thumbs -> rbxassetid -> rbxthumb.
local THUMB = "https://www.roblox.com/Thumbs/Asset.ashx?width=420&height=420&assetId="

local function image(p, id, x, y, w, h, fallback, fsize, holder)
	if holder then box(p, x - 6, y - 6, w + 12, h + 12, BLACK, 10, true) end
	local numId = id ~= "" and id:match("%d+") or nil
	if not numId then
		return text(p, fallback, fsize or 20, x, y + h / 2, w, TX, F.GothamBlack, CENTER)
	end
	local urls = {
		THUMB .. numId,
		"rbxassetid://" .. numId,
		"rbxthumb://type=Asset&id=" .. numId .. "&w=420&h=420",
	}
	local img = new("ImageLabel", {
		BackgroundTransparency = 1, Image = urls[1],
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		ScaleType = Enum.ScaleType.Fit,
	}, p)
	task.spawn(function()
		for i = 2, #urls do
			task.wait(4)
			if not img.Parent or img.IsLoaded then return end
			img.Image = urls[i]
		end
	end)
	return img
end

local function toggle(p, x, cy, initial, cb)
	local state = initial
	local tr = new("TextButton", {
		Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(x, cy - 13),
		Size = UDim2.fromOffset(44, 26), BackgroundColor3 = state and ONBG or OFFBG, BorderSizePixel = 0,
	}, p)
	round(tr, 13)
	local kn = new("Frame", {
		Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(state and 21 or 3, 3),
		BackgroundColor3 = state and Color3.new(1, 1, 1) or Color3.fromRGB(225, 225, 225), BorderSizePixel = 0,
	}, tr)
	round(kn, 10)
	tr.MouseButton1Click:Connect(function()
		state = not state
		local i = TweenInfo.new(0.15)
		TweenService:Create(tr, i, {BackgroundColor3 = state and ONBG or OFFBG}):Play()
		TweenService:Create(kn, i, {Position = UDim2.fromOffset(state and 21 or 3, 3),
			BackgroundColor3 = state and Color3.new(1, 1, 1) or Color3.fromRGB(225, 225, 225)}):Play()
		cb(state)
	end)
end

local function numberBox(p, x, y, w, h, value, cb)
	local f = box(p, x, y, w, h, Color3.fromRGB(12, 12, 13), 8, true)
	stroke(f, Color3.fromRGB(85, 85, 90))
	local tb = new("TextBox", {
		BackgroundTransparency = 1, Text = value, TextSize = 16, Font = F.GothamBold, TextColor3 = TX,
		Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -30, 1, 0), TextXAlignment = LEFT,
		ClearTextOnFocus = false,
	}, f)
	text(f, "▲", 8, w - 20, h / 2 - 6, 14, MUTED, F.GothamBold, CENTER)
	text(f, "▼", 8, w - 20, h / 2 + 6, 14, MUTED, F.GothamBold, CENTER)
	tb.FocusLost:Connect(function()
		local n = tonumber((tb.Text:gsub("%.", "")))
		if n then cb(n) end
	end)
end

-- Baris opsi (toggle/ikon di kiri, judul + deskripsi, kotak angka opsional di kanan)
local RH = 58
local function rowW(title, sub, icon, num)
	local w = 14 + (icon and 38 or 56) + math.max(tw(title, 17, F.GothamBold), tw(sub, 13, F.GothamMedium)) + 14
	if num then w = w + 98 end
	return w
end
local function optRow(p, w, y, title, sub, state, cb, icon, numVal, numCb)
	local left = 14
	if icon then
		text(p, icon, 26, left - 2, y + RH / 2, 34, MUTED, F.GothamBold, CENTER)
		left = left + 38
	else
		toggle(p, left, y + RH / 2, state, cb)
		left = left + 56
	end
	text(p, title, 17, left, y + 20, 400, TX, F.GothamBold)
	text(p, sub, 13, left, y + 41, 400, SUB, F.GothamMedium)
	if numVal then numberBox(p, w - 14 - 84, y + 15, 84, 28, numVal, numCb) end
end

-- Pill status
local function pillW(t, dot) return tw(t, 14, F.GothamMedium) + (dot and 52 or 26) end
local function pill(p, x, y, t, dot, wOverride)
	local w = wOverride or pillW(t, dot)
	local f = box(p, x, y, w, 32, Color3.fromRGB(10, 10, 11), 16)
	if dot then
		local d = new("Frame", {Position = UDim2.fromOffset(12, 9), Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = Color3.fromRGB(130, 130, 134), BorderSizePixel = 0}, f)
		round(d, 7)
	end
	return text(f, t, 14, dot and 34 or 13, 16, w, TX, F.GothamMedium), w
end

local PAD, GAP, HH, SW = 14, 10, 78, 200
local CX, CY = PAD + SW + PAD, HH + PAD -- asal halaman di dalam jendela
local CONTENT_Y = PAD + 44 + GAP        -- isi kartu mulai di bawah header kartu

-- Header kartu: ikon + judul + subjudul, pill di kanan (status, lalu extra)
local function cardHeader(card, icon, title, sub, status, extra)
	local cw = card.Size.X.Offset
	text(card, icon, 28, PAD, PAD + 22, 36, TX, F.GothamBold, CENTER)
	text(card, title, 22, PAD + 44, PAD + 12, 400, TX, F.GothamBold)
	text(card, sub, 13, PAD + 44, PAD + 36, 600, SUB, F.GothamMedium)
	local sLbl, eLbl
	local x = cw - PAD
	if status then
		x = x - pillW(status, true)
		sLbl = pill(card, x, PAD + 6, status, true)
	end
	if extra then
		local w = pillW(extra, false) + 30
		x = x - 8 - w
		eLbl = pill(card, x, PAD + 6, extra, false, w)
	end
	return sLbl, eLbl
end

