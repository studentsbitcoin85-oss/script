-- Utilitas sisi klien: Anti AFK & Anti Lag (hanya pengaturan lokal, bisa dibatalkan)
local VirtualUser = game:GetService("VirtualUser")
local Lighting = game:GetService("Lighting")

-- Anti AFK: respon sinyal Idled supaya tidak di-kick karena diam
local afkConn
Callbacks.AntiAFK = function(state)
	if afkConn then afkConn:Disconnect() afkConn = nil end
	if state then
		afkConn = Players.LocalPlayer.Idled:Connect(function()
			pcall(function()
				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.new())
			end)
		end)
	end
end

-- Anti Lag: matikan efek visual (partikel, cahaya, bayangan) tanpa menghapus apa pun.
-- Semua nilai asli disimpan dan dikembalikan saat dimatikan.
local antiLag = {on = false, conn = nil, saved = setmetatable({}, {__mode = "k"}), lighting = nil, quality = nil}
local EFFECTS = {
	ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true, Sparkles = true,
	PointLight = true, SpotLight = true, SurfaceLight = true,
}

local function dampen(obj)
	if EFFECTS[obj.ClassName] then
		antiLag.saved[obj] = {effect = true, enabled = obj.Enabled}
		obj.Enabled = false
	elseif obj:IsA("BasePart") and not obj:IsA("Terrain") then
		antiLag.saved[obj] = {material = obj.Material, reflectance = obj.Reflectance}
		obj.Material = Enum.Material.SmoothPlastic
		obj.Reflectance = 0
	end
end

Callbacks.AntiLag = function(state)
	if state == antiLag.on then return end
	antiLag.on = state
	if state then
		antiLag.lighting = {
			GlobalShadows = Lighting.GlobalShadows,
			EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
			EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
		}
		pcall(function() antiLag.quality = settings().Rendering.QualityLevel end)
		Lighting.GlobalShadows = false
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.EnvironmentSpecularScale = 0
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

		antiLag.conn = workspace.DescendantAdded:Connect(function(d)
			if antiLag.on then pcall(dampen, d) end
		end)
		task.spawn(function()
			local n = 0
			for _, d in ipairs(workspace:GetDescendants()) do
				if not antiLag.on then return end
				pcall(dampen, d)
				n += 1
				if n % 400 == 0 then task.wait() end
			end
		end)
	else
		if antiLag.conn then antiLag.conn:Disconnect() antiLag.conn = nil end
		if antiLag.lighting then
			for k, v in pairs(antiLag.lighting) do pcall(function() Lighting[k] = v end) end
		end
		if antiLag.quality then
			pcall(function() settings().Rendering.QualityLevel = antiLag.quality end)
		end
		for obj, info in pairs(antiLag.saved) do
			pcall(function()
				if info.effect then
					obj.Enabled = info.enabled
				else
					obj.Material = info.material
					obj.Reflectance = info.reflectance
				end
			end)
		end
		antiLag.saved = setmetatable({}, {__mode = "k"})
	end
end

