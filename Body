-- Format angka
local SUFFIX = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}

local function abbr(n)
	local neg = n < 0
	n = math.abs(n)
	local i = 1
	while n >= 1000 and i < #SUFFIX do
		n /= 1000
		i += 1
	end
	local shown = i == 1 and math.floor(n + 0.5) or tonumber(string.format("%.2f", n))
	if shown >= 1000 and i < #SUFFIX then
		n /= 1000
		i += 1
		shown = tonumber(string.format("%.2f", n))
	end
	local s = i == 1 and tostring(shown) or string.format("%.2f", shown)
	return (neg and "-" or "") .. s .. SUFFIX[i]
end

-- angka penuh dengan titik: 150000 -> 150.000
local function full(n)
	local s = string.format("%.0f", math.abs(n))
	s = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	s = s:gsub("^%.", "")
	return (n < 0 and "-" or "") .. s
end

local SUFFIX_MULT = {
	k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18,
	sx = 1e21, sp = 1e24, oc = 1e27, no = 1e30, dc = 1e33,
}
local function parseNumber(s)
	s = tostring(s):lower():gsub("[%s_,]", "")
	local num, suf = s:match("^([%d%.]+)(%a*)$")
	if not num then return nil end
	local parts = {}
	for p in (num .. "."):gmatch("([^%.]*)%.") do parts[#parts + 1] = p end
	if #parts >= 2 then
		local grouped = #parts[1] >= 1 and #parts[1] <= 3 and parts[1] ~= "0"
		for i = 2, #parts do
			if #parts[i] ~= 3 then grouped = false end
		end
		if grouped then
			num = table.concat(parts)
		elseif #parts > 2 then
			return nil
		end
	end
	local n = tonumber(num)
	if not n then return nil end
	if suf ~= "" then
		local m = SUFFIX_MULT[suf]
		if not m then return nil end
		n *= m
	end
	return n
end
local MAX_INPUT = 1e18

local function isNum(v) return v:IsA("IntValue") or v:IsA("NumberValue") end
