-- Toggle: kunci = judul (sama persis dengan yang dipakai setToggle() di farming)
local Toggles = {}
local shown = {} -- status terakhir yang diketahui; callback yang nilainya sama (mis. dari :Set) diabaikan

local function addToggle(tab, name, desc, initial, cbName)
	initial = initial and true or false
	shown[name] = initial
	local el
	el = tab:CreateToggle({
		Name = name,
		Description = desc,
		CurrentValue = initial,
		Callback = function(v)
			v = v and true or false
			if shown[name] == v then return end
			shown[name] = v
			Callbacks[cbName](v)
		end,
	})
	Toggles[name] = function(state, silent)
		state = state and true or false
		shown[name] = state
		if el then pcall(function() el:Set({CurrentValue = state}) end) end
		if not silent then Callbacks[cbName](state) end
	end
end

-- Kotak angka: Enter untuk menyimpan. Teks diganti dengan nilai yang benar-benar dipakai.
local function addNumberInput(tab, name, desc, initial, cbName, minVal, default, maxVal)
	local lastText = string.format("%.0f", initial)
	local lastNum = initial
	local el
	el = tab:CreateInput({
		Name = name,
		Description = desc,
		PlaceholderText = lastText,
		CurrentValue = lastText,
		Numeric = false,
		Enter = true,
		Callback = function(text)
			if text == lastText then return end
			local n = parseNumber(text)
			if not n or n < (minVal or 0) then n = default or lastNum end
			n = math.min(math.floor(n), maxVal or MAX_INPUT)
			lastNum = n
			lastText = string.format("%.0f", n)
			if lastText ~= text and el then
				pcall(function() el:Set({CurrentValue = lastText}) end)
			end
			Callbacks[cbName](n)
		end,
	})
end

