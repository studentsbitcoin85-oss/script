-- STATUS FUNCTION
local function setStatus(message, color)
    statusText.Text = message
    statusText.TextColor3 = color
end
-- KEY VALIDATION
local function validateKey(key)
    return key == "RTXonTOP"
end
-- VERIFY ACTION
verify.Activated:Connect(function()
    local key = input.Text:match("^%s*(.-)%s*$")
    if key == "" then
        setStatus("Please enter your key.", RED)
        return
    end
    verify.Text = "VERIFYING..."
    verify.Active = false
    verify.Selectable = false
    setStatus("Checking key...", MUTED)
    task.wait(0.4)
    local ok, valid = pcall(validateKey, key)
    verify.Text = "VERIFY KEY"
    verify.Active = true
    verify.Selectable = true
    if not ok then
        setStatus("Verification error. Try again.", RED)
    elseif valid then
        setStatus(
            "Key accepted!",
            Color3.fromRGB(70, 210, 120)
        )
        -- Tambahkan aksi setelah key berhasil diverifikasi di sini.
    else
        setStatus("Invalid key. Please try again.", RED)
    end
end)
