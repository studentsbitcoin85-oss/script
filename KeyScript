local busy = false

local function setStatus(message, color)
    status.Text = message
    status.TextColor3 = color
end

local function onVerified()
    setStatus(
        "Key accepted!",
        Color3.fromRGB(80, 220, 120)
    )

    verify.Text = "SUCCESS"
    verify.Active = false

    task.wait(0.7)
    gui:Destroy()

    -- Tempat menjalankan fitur proyek milik sendiri.
    print("Key verified; callback executed.")
end

local function submitKey()
    if busy then
        return
    end

    busy = true
    verify.Text = "CHECKING..."
    verify.Active = false

    local ok, valid = pcall(function()
        return KeySystem.Verify(input.Text)
    end)

    if not ok then
        setStatus(
            "Verification error. Check Output.",
            Color3.fromRGB(255, 75, 75)
        )
        warn("Key verification error:", valid)
        verify.Text = "TRY AGAIN"
        verify.Active = true
        busy = false
        return
    end

    if valid == true then
        onVerified()
    else
        setStatus(
            "Wrong key. Try again.",
            Color3.fromRGB(255, 75, 75)
        )
        verify.Text = "VERIFY KEY"
        verify.Active = true
        busy = false
        input:CaptureFocus()
    end
end

verify.Activated:Connect(submitKey)

input.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        submitKey()
    end
end)

print("RTX Key UI loaded successfully.")
