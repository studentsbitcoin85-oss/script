
local KeySystem = {}

local CORRECT_KEY = "RTXOnTop"

function KeySystem.Init()
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer

    local gui = Instance.new("ScreenGui")
    gui.Name = "MuhavesKeySystem"
    gui.ResetOnSpawn = false

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(320, 190)
    frame.Position = UDim2.new(0.5, -160, 0.5, -95)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    frame.BorderSizePixel = 0
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 45)
    title.BackgroundTransparency = 1
    title.Text = "MUHAVES | KEY SYSTEM"
    title.TextColor3 = Color3.fromRGB(0, 255, 120)
    title.TextSize = 17
    title.Font = Enum.Font.GothamBold
    title.Parent = frame

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, -40, 0, 38)
    input.Position = UDim2.fromOffset(20, 55)
    input.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    input.TextColor3 = Color3.new(1, 1, 1)
    input.PlaceholderText = "Masukkan key..."
    input.PlaceholderColor3 = Color3.fromRGB(140, 140, 140)
    input.Text = ""
    input.TextSize = 14
    input.Font = Enum.Font.Gotham
    input.ClearTextOnFocus = false
    input.Parent = frame

    local inputCorner = Instance.new("UICorner")
    inputCorner.CornerRadius = UDim.new(0, 7)
    inputCorner.Parent = input

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -40, 0, 20)
    status.Position = UDim2.fromOffset(20, 96)
    status.BackgroundTransparency = 1
    status.Text = "Masukkan key untuk melanjutkan"
    status.TextColor3 = Color3.fromRGB(170, 170, 170)
    status.TextSize = 11
    status.Font = Enum.Font.Gotham
    status.Parent = frame

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -40, 0, 38)
    button.Position = UDim2.fromOffset(20, 128)
    button.BackgroundColor3 = Color3.fromRGB(0, 210, 100)
    button.Text = "VERIFY KEY"
    button.TextColor3 = Color3.fromRGB(10, 10, 10)
    button.TextSize = 14
    button.Font = Enum.Font.GothamBold
    button.Parent = frame

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 7)
    buttonCorner.Parent = button

    local finished = false

    local function cleanup()
        if gui then
            gui:Destroy()
        end
    end

    button.MouseButton1Click:Connect(function()
        if input.Text == CORRECT_KEY then
            finished = true
            status.Text = "KEY BERHASIL!"
            status.TextColor3 = Color3.fromRGB(0, 255, 120)
            task.wait(0.4)
            cleanup()
        else
            status.Text = "KEY SALAH, COBA LAGI!"
            status.TextColor3 = Color3.fromRGB(255, 75, 75)
            input.Text = ""
        end
    end)

    gui.Parent = player:WaitForChild("PlayerGui")

    while not finished and gui.Parent do
        task.wait(0.1)
    end

    return finished
end

return KeySystem
