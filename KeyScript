local KeySystem = {}
local CORRECT_KEY = "RTXOnTop"
function KeySystem.Init()
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    -- TEMA RTX: HITAM, PUTIH, MERAH
    local BLACK = Color3.fromRGB(12, 12, 14)
    local DARK = Color3.fromRGB(25, 25, 29)
    local WHITE = Color3.fromRGB(245, 245, 245)
    local GRAY = Color3.fromRGB(165, 165, 170)
    local RED = Color3.fromRGB(220, 35, 50)
    local DARK_RED = Color3.fromRGB(145, 20, 30)
    local gui = Instance.new("ScreenGui")
    gui.Name = "MuhavesKeySystem"
    gui.ResetOnSpawn = false
    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(320, 190)
    frame.Position = UDim2.new(0.5, -160, 0.5, -95)
    frame.BackgroundColor3 = BLACK
    frame.BorderSizePixel = 0
    frame.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame
    -- GARIS MERAH
    local stroke = Instance.new("UIStroke")
    stroke.Color = RED
    stroke.Thickness = 1.5
    stroke.Parent = frame
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 45)
    title.BackgroundTransparency = 1
    title.Text = "RTX | KEY SYSTEM"
    title.TextColor3 = WHITE
    title.TextSize = 17
    title.Font = Enum.Font.GothamBold
    title.Parent = frame
    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, -40, 0, 38)
    input.Position = UDim2.fromOffset(20, 55)
    input.BackgroundColor3 = DARK
    input.TextColor3 = WHITE
    input.PlaceholderText = "Masukkan key..."
    input.PlaceholderColor3 = GRAY
    input.Text = ""
    input.TextSize = 14
    input.Font = Enum.Font.Gotham
    input.ClearTextOnFocus = false
    input.BorderSizePixel = 0
    input.Parent = frame
    local inputCorner = Instance.new("UICorner")
    inputCorner.CornerRadius = UDim.new(0, 7)
    inputCorner.Parent = input
    local inputStroke = Instance.new("UIStroke")
    inputStroke.Color = DARK_RED
    inputStroke.Thickness = 1
    inputStroke.Parent = input
    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -40, 0, 20)
    status.Position = UDim2.fromOffset(20, 96)
    status.BackgroundTransparency = 1
    status.Text = "Masukkan key untuk melanjutkan"
    status.TextColor3 = GRAY
    status.TextSize = 11
    status.Font = Enum.Font.Gotham
    status.Parent = frame
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -40, 0, 38)
    button.Position = UDim2.fromOffset(20, 128)
    button.BackgroundColor3 = RED
    button.Text = "VERIFY KEY"
    button.TextColor3 = WHITE
    button.TextSize = 14
    button.Font = Enum.Font.GothamBold
    button.BorderSizePixel = 0
    button.AutoButtonColor = true
    button.Parent = frame
    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 7)
    buttonCorner.Parent = button
    local finished = false
    local function cleanup()
        if gui then
            gui:Destroy()
        end
    end
    button.MouseButton1Click:Connect(function()
        if input.Text == CORRECT_KEY then
            finished = true
            status.Text = "KEY BERHASIL!"
            status.TextColor3 = RED
            task.wait(0.4)
            cleanup()
        else
            status.Text = "KEY SALAH, COBA LAGI!"
            status.TextColor3 = RED
            input.Text = ""
        end
    end)
    gui.Parent = player:WaitForChild("PlayerGui")
    while not finished and gui.Parent do
        task.wait(0.1)
    end
    return finished
end
return KeySystem
