
-- KeySystem.lua
-- ModuleScript untuk proyek Roblox Studio milik sendiri

local KeySystem = {}

local CORRECT_KEY = "RTXonTOP"

function KeySystem.Verify(input)
    return input == CORRECT_KEY
end

function KeySystem.Init(onVerified)
    if type(onVerified) ~= "function" then
        warn("Callback verifikasi belum diberikan.")
        return false
    end

    -- Panggil dari UI milik proyek lu setelah
    -- pengguna memasukkan key dan menekan Verify.
    local function SubmitKey(input)
        if not KeySystem.Verify(input) then
            return false
        end

        onVerified()
        return true
    end

    return SubmitKey
end

return KeySystem
