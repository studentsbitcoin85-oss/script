
local KeySystem = {}

function KeySystem.Init()
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    local verified = false
    local finished = false

    local gui = Instance.new("ScreenGui")
    gui.Name = "MuhavesKeySystem"
    gui.ResetOnSpawn = false
    gui.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromOffset(320, 180)
    frame.Position = UDim2.new(0.5, -160, 0.5, -90)
    frame.Parent = gui

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, -30, 0, 40)
    input.Position = UDim2.fromOffset(15, 20)
    input.PlaceholderText = "Enter key"
    input.Text = ""
    input.Parent = frame

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -30, 0, 40)
    button.Position = UDim2.fromOffset(15, 75)
    button.Text = "VERIFY KEY"
    button.Parent = frame

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -30, 0, 25)
    status.Position = UDim2.fromOffset(15, 125)
    status.Text = ""
    status.Parent = frame

    button.Activated:Connect(function()
        if input.Text == "RTXonTOP" then
            verified = true
            finished = true
            status.Text = "Key accepted!"
        else
            status.Text = "Invalid key!"
        end
    end)

    repeat
        task.wait()
    until finished

    gui:Destroy()
    return verified
end

return KeySystem
