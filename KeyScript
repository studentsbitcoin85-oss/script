local Players = game:GetService("Players")
local player = Players.LocalPlayer

local CORRECT_KEY = "RTXonTOP"

local gui = Instance.new("ScreenGui")
gui.Name = "MuhavesKeySystem"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame")
main.Name = "MainFrame"
main.Size = UDim2.fromOffset(260, 280)
main.Position = UDim2.new(0.5, -130, 0.5, -140)
main.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
main.BorderSizePixel = 0
main.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = main

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(220, 35, 45)
stroke.Thickness = 1.5
stroke.Parent = main

local function makeLabel(text, size, pos, font, color)
    local label = Instance.new("TextLabel")
    label.Size = size
    label.Position = pos
    label.BackgroundTransparency = 1
    label.Text = text
    label.Font = font or Enum.Font.Gotham
    label.TextColor3 = color or Color3.new(1, 1, 1)
    label.TextSize = 12
    label.Parent = main
    return label
end

makeLabel(
    "MUHAVES",
    UDim2.new(1, -20, 0, 25),
    UDim2.fromOffset(10, 16),
    Enum.Font.GothamBold,
