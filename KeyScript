makeLabel(
    "MUHAVES  •  KEY SYSTEM",
    UDim2.new(1, -20, 0, 18),
    UDim2.fromOffset(10, 244),
    Enum.Font.Gotham,
    Color3.fromRGB(100, 100, 110)
)

local busy = false

verify.Activated:Connect(function()
    if busy then return end
    busy = true
    verify.Active = false

    if input.Text == CORRECT_KEY then
        status.Text = "Key accepted!"
        status.TextColor3 = Color3.fromRGB(70, 220, 120)
        verify.Text = "SUCCESS"

        task.wait(0.6)
        gui:Destroy()
    else
        status.Text = "Invalid key. Try again."
        status.TextColor3 = Color3.fromRGB(255, 75, 75)
        inputStroke.Color = Color3.fromRGB(220, 35, 45)

        task.wait(0.2)
        verify.Active = true
        busy = false
    end
end)
