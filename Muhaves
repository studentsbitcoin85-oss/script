end)

-- ========== MAIN LOOP: AUTO REBIRTH ==========
task.spawn(function()
    local cachedReb = nil
    while alive do
        if S.AutoReb then
            pcall(function()
                local rebs = getStat("Rebirths")
                if rebs == 0 then rebs = getStat("Rebirth") end
                local str = getStat("Strength")
                if str == 0 then str = getStat("Kekuatan") end
                
                local targetReq = 10000 + (5000 * rebs)
                if (S.TargetReb <= 0 or rebs < S.TargetReb) and str >= targetReq then
                    if not cachedReb then cachedReb = getRem("rebirthRemote") end
                    if cachedReb then
                        if cachedReb:IsA("RemoteFunction") then
                            pcall(function() cachedReb:InvokeServer("rebirthRequest") end)
                        elseif cachedReb:IsA("RemoteEvent") then
                            cachedReb:FireServer("rebirthRequest")
                        end
                    end
                end
            end)
        end
        task.wait(S.Delay)
    end
end)
