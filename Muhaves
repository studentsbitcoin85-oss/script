local function Hex(parent, w, h, fill, line, thick, alpha, z)
    alpha = alpha or 0
    local tip = h / 2
    local d = h / math.sqrt(2)

    local root = Instance.new("Frame")
    root.BackgroundTransparency = 1
    root.Size = UDim2.fromOffset(w, h)
    root.ZIndex = z or 1
    root.Parent = parent

    local sqs, lines = {}, {}
    for i = 0, 1 do
        local sq = Instance.new("Frame")
        sq.AnchorPoint = Vector2.new(0.5, 0.5)
        sq.Size = UDim2.fromOffset(d, d)
        sq.Position = UDim2.new(i, i == 0 and tip or -tip, 0.5, 0)
        sq.Rotation = 45
        sq.BackgroundColor3 = fill
        sq.BackgroundTransparency = alpha
        sq.BorderSizePixel = 0
        sq.ZIndex = 1
        sq.Parent = root
        local st = Instance.new("UIStroke")
        st.Color, st.Thickness = line, thick
        st.Parent = sq
        table.insert(sqs, sq)
    end

    local mid = Instance.new("Frame")
    mid.Position = UDim2.fromOffset(tip, 0)
    mid.Size = UDim2.new(1, -h, 1, 0)
    mid.BackgroundColor3 = fill
    mid.BackgroundTransparency = alpha
    mid.BorderSizePixel = 0
    mid.ZIndex = 2
    mid.Parent = root

    for i = 0, 1 do
        local ln = Instance.new("Frame")
        ln.AnchorPoint = Vector2.new(0, i)
        ln.Position = UDim2.new(0, 0, i, 0)
        ln.Size = UDim2.new(1, 0, 0, thick)
        ln.BackgroundColor3 = line
        ln.BorderSizePixel = 0
        ln.ZIndex = 3
        ln.Parent = mid
        table.insert(lines, ln)
    end

    local function paint(f, l)
        for _, sq in ipairs(sqs) do
            sq.BackgroundColor3 = f
            sq.UIStroke.Color = l
        end
        mid.BackgroundColor3 = f
        for _, ln in ipairs(lines) do ln.BackgroundColor3 = l end
    end

    return root, paint
end

local function fmt(n)
    n = tonumber(n) or 0
    local units = { "", "K", "M", "B", "T", "Qa", "Qi" }
    local i = 1
    while n >= 1000 and i < #units do n = n / 1000 i += 1 end
    if i == 1 then return tostring(math.floor(n)) end
    return string.format("%.1f%s", n, units[i])
end

