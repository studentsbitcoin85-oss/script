-- ========== PERFORMA (Flat Graphics & Perbaikan) ==========
local Perf = { antiLag = false, fps = false }
local saved = setmetatable({}, { __mode = "k" })
local pconns = {}
local token = 0
local CHUNK = 400
local origShadows = Lighting.GlobalShadows
local origQuality, origMeshDetail, terrainOrig, terrainDec, techOrig
local origFpsCap = nil
local lightOrig = {}
local LIGHT_PROPS = { "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "ShadowSoftness" }

local function applyShadows()
    pcall(function()
        Lighting.GlobalShadows = origShadows and not (Perf.antiLag or Perf.fps)
    end)
end

local function optimize(o)
    pcall(function()
        if o:IsA("Terrain") then return end
        if o:IsDescendantOf(workspace) then
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character and o:IsDescendantOf(player.Character) then
                    return
                end
            end
        end
        
        if o:IsA("BasePart") then
            if not saved[o] then
                local d = { k = "p", m = o.Material, r = o.Reflectance, s = o.CastShadow }
                if o:IsA("MeshPart") then d.t, d.f = o.TextureID, o.RenderFidelity end
                saved[o] = d
            end
            o.Material = Enum.Material.SmoothPlastic
            o.Reflectance = 0
            o.CastShadow = false
            if o:IsA("MeshPart") then
                o.TextureID = ""
                o.RenderFidelity = Enum.RenderFidelity.Performance
            end
        elseif o:IsA("Decal") or o:IsA("Texture") then
            if not saved[o] then saved[o] = { k = "d", t = o.Transparency } end
            o.Transparency = 1
        elseif o:IsA("SurfaceAppearance") then
            if not saved[o] then
                saved[o] = { k = "sa", c = o.ColorMap, n = o.NormalMap, m = o.MetalnessMap, r = o.RoughnessMap }
            end
            o.ColorMap, o.NormalMap, o.MetalnessMap, o.RoughnessMap = "", "", "", ""
        elseif o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Fire") or o:IsA("Smoke") or o:IsA("Sparkles") then
            if not saved[o] then saved[o] = { k = "fx", e = o.Enabled } end
            o.Enabled = false
        end
    end)
end

local function restore(o, d)
    pcall(function()
        if not o.Parent then return end
        if d.k == "p" then
            o.Material, o.Reflectance, o.CastShadow = d.m, d.r, d.s
            if d.t ~= nil then o.TextureID, o.RenderFidelity = d.t, d.f end
        elseif d.k == "d" then
            o.Transparency = d.t
        elseif d.k == "sa" then
            o.ColorMap, o.NormalMap, o.MetalnessMap, o.RoughnessMap = d.c, d.n, d.m, d.r
        elseif d.k == "at" then
            o.Density, o.Haze = d.d, d.h
        else
            o.Enabled = d.e
        end
    end)
end

local function runChunked(list, fn, myToken)
    for i, o in ipairs(list) do
        if myToken ~= token or not alive then return end
        fn(o)
        if i % CHUNK == 0 then task.wait() end
    end
end

local function flatWorld(on)
    pcall(function()
        local T = workspace.Terrain
        if on then
            for _, e in ipairs(Lighting:GetChildren()) do
                if not saved[e] then
                    if e:IsA("PostEffect") then
                        saved[e] = { k = "fx", e = e.Enabled }
                        e.Enabled = false
                    elseif e:IsA("Atmosphere") then
                        saved[e] = { k = "at", d = e.Density, h = e.Haze }
                        e.Density, e.Haze = 0, 0
                    end
                end
            end
            local cl = T:FindFirstChildOfClass("Clouds")
            if cl and not saved[cl] then
                saved[cl] = { k = "fx", e = cl.Enabled }
                cl.Enabled = false
            end
            terrainOrig = terrainOrig or {
                WaterWaveSize = T.WaterWaveSize, WaterWaveSpeed = T.WaterWaveSpeed, WaterReflectance = T.WaterReflectance,
            }
            T.WaterWaveSize, T.WaterWaveSpeed, T.WaterReflectance = 0, 0, 0
        else
            if terrainOrig then
                for k, val in pairs(terrainOrig) do T[k] = val end
            end
        end
    end)

    for _, n in ipairs(LIGHT_PROPS) do
        pcall(function()
            if on then
                if lightOrig[n] == nil then lightOrig[n] = Lighting[n] end
                Lighting[n] = 0
            elseif lightOrig[n] ~= nil then
                Lighting[n] = lightOrig[n]
            end
        end)
    end

    pcall(function()
        if not (sethiddenproperty and gethiddenproperty) then return end
        if on then
            if techOrig == nil then techOrig = gethiddenproperty(Lighting, "Technology") end
            sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility)
        elseif techOrig ~= nil then
            sethiddenproperty(Lighting, "Technology", techOrig)
        end
    end)
    pcall(function()
        if not (sethiddenproperty and gethiddenproperty) then return end
        local T = workspace.Terrain
        if on then
            if terrainDec == nil then terrainDec = gethiddenproperty(T, "Decoration") end
            sethiddenproperty(T, "Decoration", false)
        elseif terrainDec ~= nil then
            sethiddenproperty(T, "Decoration", terrainDec)
        end
    end)
end

local function setAntiLag(v)
    Perf.antiLag = v
    token += 1
    local my = token
    for _, c in ipairs(pconns) do c:Disconnect() end
    table.clear(pconns)

    flatWorld(v)

    if v then
        table.insert(pconns, workspace.DescendantAdded:Connect(optimize))
        table.insert(pconns, Lighting.ChildAdded:Connect(function(child)
            if child:IsA("PostEffect") or child:IsA("Atmosphere") then
                saved[child] = { k = "fx", e = child.Enabled }
                child.Enabled = false
            end
        end))
        task.spawn(function() runChunked(workspace:GetDescendants(), optimize, my) end)
    else
        local list = {}
        for o in pairs(saved) do list[#list + 1] = o end
        task.spawn(function()
            runChunked(list, function(o)
                local d = saved[o]
                if d then restore(o, d) saved[o] = nil end
            end, my)
        end)
    end
    applyShadows()
end

local function setFps(v)
    Perf.fps = v
    pcall(function()
        local r = settings().Rendering
        if v then
            origQuality = origQuality or r.QualityLevel
            r.QualityLevel = Enum.QualityLevel.Level01
            if getfpscap and setfpscap then
                if not origFpsCap then origFpsCap = getfpscap() end
                setfpscap(60)
            end
        elseif origQuality then
            r.QualityLevel = origQuality
            if setfpscap and origFpsCap then
                setfpscap(origFpsCap)
            end
        end
    end)
    pcall(function()
        local r = settings().Rendering
        if v then
            origMeshDetail = origMeshDetail or r.MeshPartDetailLevel
            r.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
        elseif origMeshDetail then
            r.MeshPartDetailLevel = origMeshDetail
        end
    end)
    applyShadows()
end

local function set3D(off)
    pcall(function() Run:Set3dRenderingEnabled(not off) end)
end

local function restoreAll()
    token += 1
    Perf.antiLag, Perf.fps = false, false
    for _, c in ipairs(pconns) do c:Disconnect() end
    table.clear(pconns)
    for o, d in pairs(saved) do restore(o, d) end
    table.clear(saved)
    flatWorld(false)
    pcall(function()
        local r = settings().Rendering
        if origQuality then r.QualityLevel = origQuality end
        if origMeshDetail then r.MeshPartDetailLevel = origMeshDetail end
        if setfpscap and origFpsCap then setfpscap(origFpsCap) end
    end)
    pcall(function() Lighting.GlobalShadows = origShadows end)
    set3D(false)
end

