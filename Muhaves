-- ========== MAIN LOOP: AUTO LIFT ==========
task.spawn(function()
    local cachedEv = nil
    while alive do
        if S.AutoLift then
            pcall(function()
                local char = LP.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                
                if hum and hum.Health > 0 then
                    local tool = char:FindFirstChildOfClass("Tool") or LP.Backpack:FindFirstChild("Weight") or LP.Backpack:FindFirstChildOfClass("Tool")
                    if tool and tool.Parent ~= char then
                        pcall(function() hum:EquipTool(tool) end)
                    end
                    if not cachedEv then cachedEv = getRem("muscleEvent") end
                    if cachedEv then
                        for i = 1, S.Burst do
                            cachedEv:FireServer("rep")
                        end
                    end
                    if tool and tool.Parent == char then
                        pcall(function() tool:Activate() end)
                    end
                end
            end)
        end
        task.wait(S.Delay)
    end
end)

-- ========== MAIN LOOP: LOCK POSITION ==========
