local function Toggle(txt, x, y, group, cb)
    local root, paint = Hex(Main, 124, 26, C.Btn, C.Line, 2, 0, 5)
    root.Position = UDim2.fromOffset(x, y)

    local b = Instance.new("TextButton")
    b.BackgroundTransparency = 1
    b.Size = UDim2.fromScale(1, 1)
    b.Font, b.TextSize, b.TextColor3, b.Text = Enum.Font.GothamBold, 12, C.Text, txt
    b.TextStrokeTransparency, b.TextStrokeColor3 = 0.5, Color3.new(0, 0, 0)
    b.ZIndex = 6
    b.Parent = root

    local on = false
    local function set(v)
        if v == on then return end
        on = v
        paint(on and C.BtnOn or C.Btn, on and C.LineOn or C.Line)
        b.TextColor3 = on and C.LineOn or C.Text
        cnt[group] += on and 1 or -1
        refresh()
        cb(on)
    end
    b.MouseButton1Click:Connect(function() set(not on) end)
    table.insert(toggles, set)
end

