local prot = {AntiFling = false, Lock = false, LockPos = nil}
local function enableAntiFling()
	local r = root()
	if not prot.AntiFling or not r then return end
	local old = r:FindFirstChild("BodyVelocity")
	if old and old.MaxForce == Vector3.new(100000, 0, 100000) then old:Destroy() end
	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(100000, 0, 100000) bv.Velocity = Vector3.zero bv.P = 1250 bv.Parent = r
end
local function disableAntiFling()
	local r = root()
	local old = r and r:FindFirstChild("BodyVelocity")
	if old and old.MaxForce == Vector3.new(100000, 0, 100000) then old:Destroy() end
end
switch(TMain, "Anti Fling", function(b) prot.AntiFling = b if b then enableAntiFling() else disableAntiFling() end end, true)
local function lockPosition()
	enableAntiFling()
	local r = root()
	if not prot.Lock or not prot.LockPos or not r then return end
	local bp = r:FindFirstChild("PositionLocker")
	if bp then bp.Position = prot.LockPos
	else
		disableAntiFling()
		bp = Instance.new("BodyPosition")
		bp.Name = "PositionLocker" bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bp.Position = prot.LockPos bp.P = 100000 bp.Parent = r
	end
end
