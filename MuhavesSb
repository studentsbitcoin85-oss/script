local MAX_PET_SLOTS = 12
local TARGET_REP_SPEED = 150

local function unequipConfiguredPets()
	local pf = lp:FindFirstChild(NAMES.petsFolder)
	if not pf then return end
	for _, folder in ipairs(pf:GetChildren()) do
		if folder:IsA("Folder") then
			for _, pet in ipairs(folder:GetChildren()) do
				equipPetEvent:FireServer("unequipPet", pet)
			end
		end
	end
	task.wait(0.1)
end

local equippedSet = nil
local petLock = false

local function syncPets(desired)
	while petLock do task.wait(0.05) end
	petLock = true
	local ok, err = pcall(function()
		local ev = equipPetEvent
		local want = {}
		for _, inst in ipairs(desired) do want[inst] = true end
		if equippedSet == nil then
			unequipConfiguredPets()
			equippedSet = {}
		else
			for inst in pairs(equippedSet) do
				if not want[inst] then
					if inst.Parent then ev:FireServer("unequipPet", inst) end
					equippedSet[inst] = nil
				end
			end
		end
		for _, inst in ipairs(desired) do
			if not equippedSet[inst] then
				ev:FireServer("equipPet", inst)
				equippedSet[inst] = true
			end
		end
	end)
	petLock = false
	if not ok then
		equippedSet = nil
		error(err, 0)
	end
end

local function getOwnedConfiguredPets()
	local owned = {}
	local pf = lp:FindFirstChild(NAMES.petsFolder)
	if not pf then return owned end
	for _, folder in ipairs(pf:GetChildren()) do
		if folder:IsA("Folder") then
			for _, pet in ipairs(folder:GetChildren()) do
				local config = PETS[pet.Name]
				if config then
					table.insert(owned, {
						instance = pet, name = pet.Name,
						repSpeed = config.repSpeed or 0, strength = config.strength or 0,
						durability = config.durability or 0, rebirth = config.rebirth or 0,
					})
				end
			end
		end
	end
	return owned
end

local function sRep(p) return p.repSpeed end
local function sStr(p) return p.strength + p.durability end
local function sReb(p) return p.rebirth end

local function total(chosen, score)
	local t = 0
	for _, p in ipairs(chosen.list) do t += score(p) end
	return t
end

local function pick(pets, score, chosen, limit, stopWhen)
	local list = {}
	for _, p in ipairs(pets) do
		if not chosen.set[p.instance] and score(p) > 0 then list[#list + 1] = p end
	end
	table.sort(list, function(a, b) return score(a) > score(b) end)
	for _, p in ipairs(list) do
		if #chosen.list >= limit or (stopWhen and stopWhen(chosen)) then break end
		chosen.set[p.instance] = true
		chosen.list[#chosen.list + 1] = p
	end
end

local function equipBy(passes)
	local chosen = {set = {}, list = {}}
	local pets = getOwnedConfiguredPets()
	for _, pass in ipairs(passes) do
		pick(pets, pass[1], chosen, MAX_PET_SLOTS, pass[2])
	end
	local inst = {}
	for i, p in ipairs(chosen.list) do inst[i] = p.instance end
	syncPets(inst)
	return chosen
end

local function equipBestFarmingPets()
	local c = equipBy({
		{sRep, function(ch) return total(ch, sRep) >= TARGET_REP_SPEED end},
		{sStr},
	})
	return total(c, sRep), #c.list
end

local function equipBestRebirthPets()
	local c = equipBy({{sReb}})
	return total(c, sReb), #c.list
end

local function equipBestStrengthPets()
	local c = equipBy({{sStr}, {sRep}})
	return #c.list
end

local petMode = "reps"
local petChosen = false
local function equipFarmingPets()
	if petMode == "strength" then return equipBestStrengthPets() end
	return equipBestFarmingPets()
end

