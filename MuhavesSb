-- EXTRAS

local function eatEgg()
	local tool = findTool(NAMES.tools.egg)
	if tool then
		for _ = 1, 10 do muscleEvent:FireServer("proteinEgg", tool) end
	end
end

local nextShake = 0
local function eatShake()
	local tool = findTool(NAMES.tools.shake)
	if tool then
		muscleEvent:FireServer("tropicalShake", tool)
		return true
	end
	return false
end

loop(function()
	if flag.eggs then eatEgg() task.wait(0.5) else task.wait(1) end
end)

loop(function()
	if flag.shake and os.clock() >= nextShake and eatShake() then
		nextShake = os.clock() + 150
	end
	task.wait(1)
end)

task.spawn(function()
	local fails = 0
	while alive() do
		if flag.spin then
			local okCall = pcall(function()
				if not fortuneRemote then error("remote not found: " .. NAMES.remote.fortune) end
				local chances = resolvePath(services.replicatedstorage, NAMES.fortuneChances)
				local okInv, _, why = invokeWithTimeout(fortuneRemote, 5, "openFortuneWheel", chances)
				if why == "busy" then return end
				if not okInv then error(why or "invoke failed") end
			end)
			fails = okCall and 0 or fails + 1
			if fails >= 3 then
				fails = 0
				warn("[Muhaves] Fortune Wheel: no answer from the server, trying again in 20 s.")
				for _ = 1, 80 do
					if not (alive() and flag.spin) then break end
					task.wait(0.25)
				end
			end
		else
			fails = 0
		end
		task.wait(1)
	end
end)

local BOOSTS = {
	{NAMES.tools.shake, "tropicalShake"}, {"Energy Shake", "energyShake"}, {"Protein Bar", "proteinBar"},
	{"TOUGH Bar", "toughBar"}, {"Protein Shake", "proteinShake"}, {"ULTRA Shake", "ultraShake"},
	{"Energy Bar", "energyBar"},
}
loop(function()
	if flag.boosts then
		for _, b in ipairs(BOOSTS) do
			if not (flag.boosts and alive()) then break end
			if not (flag.shake and b[1] == NAMES.tools.shake) then
				local tool = findTool(b[1])
				if tool then
					for _ = 1, 10 do muscleEvent:FireServer(b[2], tool) end
				end
			end
		end
		task.wait(0.5)
	else
		task.wait(1)
	end
end)

Callbacks.EatEggs = function(s) flag.eggs = s end
Callbacks.EatShake = function(s)
	flag.shake = s
	if s then nextShake = 0 end
end
Callbacks.SpinWheel = function(s) flag.spin = s end
Callbacks.EatAllBoosts = function(s) flag.boosts = s end

-- Equip Reps Pets / Equip Strength Pets: dua set pet yang saling mematikan (hanya satu aktif).
local PET_TILES = {
	reps = "Equip Reps Pets", strength = "Equip Strength Pets",
}
local function choosePets(mode, equipFn)
	petMode, petChosen = mode, true
	equippedSet = nil
	for m, title in pairs(PET_TILES) do
		if m ~= mode then setToggle(title, false) end
	end
	task.spawn(equipFn)
end
Callbacks.EquipRepsPets = function(state)
	if state then
		choosePets("reps", equipBestFarmingPets)
	elseif petMode == "reps" then
		petChosen = false
	end
	persist("PetMode", petChosen and petMode or "none")
end
Callbacks.EquipStrengthPets = function(state)
	if state then
		choosePets("strength", equipBestStrengthPets)
	elseif petMode == "strength" then
		petChosen = false
	end
	persist("PetMode", petChosen and petMode or "none")
end

