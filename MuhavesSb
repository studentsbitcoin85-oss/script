-- HIDE PETS
do
	local on = false
	local gen = 0
	local saved = {}
	local hiddenModels = {}
	local names, conns = {}, {}

	local function hideInst(d)
		local prop, value
		if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
			prop, value = "Transparency", 1
		elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
			prop, value = "Enabled", false
		end
		if not prop or saved[d] ~= nil then return end
		if pcall(Shared.hold, d, prop, "pets", value) then
			saved[d] = true
		end
	end
	local function hideModel(m)
		if hiddenModels[m] or services.players:GetPlayerFromCharacter(m) then return end
		hiddenModels[m] = true
		hideInst(m)
		for _, d in ipairs(m:GetDescendants()) do hideInst(d) end
	end
	local function inHiddenModel(d)
		local a = d.Parent
		while a and a ~= workspace do
			if hiddenModels[a] then return true end
			a = a.Parent
		end
		return false
	end
	local function isPet(d)
		return (d:IsA("Model") or d:IsA("BasePart")) and names[d.Name] == true
	end
	local function refreshNames()
		local added = false
		for _, p in ipairs(services.players:GetPlayers()) do
			local pf = p:FindFirstChild(NAMES.petsFolder)
			if pf then
				for _, folder in ipairs(pf:GetChildren()) do
					if folder:IsA("Folder") then
						for _, pet in ipairs(folder:GetChildren()) do
							if not names[pet.Name] then names[pet.Name] = true added = true end
						end
					end
				end
			end
		end
		return added
	end
	local function scan(my)
		walk(workspace, function(d)
			if not on or gen ~= my then return true end
			if isPet(d) then pcall(hideModel, d) end
		end)
	end
	local function sweep()
		for d in pairs(saved) do
			if not d:IsDescendantOf(game) then saved[d] = nil end
		end
		for m in pairs(hiddenModels) do
			if not m:IsDescendantOf(game) then hiddenModels[m] = nil end
		end
	end

	local function setHidden(state)
		if state == on then return end
		on = state
		gen += 1
		local my = gen
		if on then
			for k in pairs(PETS) do names[k] = true end
			refreshNames()
			conns[#conns + 1] = workspace.DescendantAdded:Connect(function(d)
				if not on then return end
				if isPet(d) then
					pcall(hideModel, d)
				elseif inHiddenModel(d) then
					pcall(hideInst, d)
				end
			end)
			task.spawn(scan, my)
			task.spawn(function()
				local n = 0
				while on and gen == my and alive() do
					task.wait(3)
					n += 1
					if on and gen == my and refreshNames() then scan(my) end
					if n % 10 == 0 then sweep() end
				end
			end)
		else
			for _, c in ipairs(conns) do c:Disconnect() end
			table.clear(conns)
			for d in pairs(saved) do pcall(Shared.release, d, "pets") end
			table.clear(saved)
			table.clear(hiddenModels)
		end
	end

	local sentHide = false
	local wanted = false
	Callbacks.HidePets = function(state, serverOnly)
		wanted = state and true or false
		if showPetsEvent then
			showPetsEvent:FireServer(state and "hidePets" or "showPets")
			sentHide = wanted
		end
		if not serverOnly then setHidden(state) end
	end
	Callbacks.SyncPetsServer = function()
		if showPetsEvent and wanted and not sentHide then
			showPetsEvent:FireServer("hidePets")
			sentHide = true
		end
	end
	gui.Destroying:Connect(function()
		pcall(function()
			setHidden(false)
			if sentHide and showPetsEvent then
				showPetsEvent:FireServer("showPets")
			end
		end)
	end)
end

