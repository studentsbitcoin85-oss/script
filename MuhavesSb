local function alive()
	return _G.MuhavesFarmingSession == SESSION_ID and gui.Parent ~= nil
end

local function loop(fn)
	task.spawn(function()
		while alive() do
			local ok, err = pcall(fn)
			if not ok then
				warn("[Muhaves] " .. tostring(err))
				task.wait(1)
			end
		end
	end)
end

