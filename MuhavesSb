local toolSwitch, squatSwitch, liftSwitch
local function enterMachine(m, md, g)
	if not m or not m.Parent or not md.Running or md.Gen ~= g or os.clock() < math.max(md.ReenterAt, cooldownUntil) then return false end
	local c, r, h, ip = char(), root(), hum(), seatPart(m)
	if not r or not h or h.Health <= 0 or not ip then return false end
	r.CFrame = ip.CFrame * CFrame.new(0, 3, 0)
	r.AssemblyLinearVelocity = Vector3.zero r.AssemblyAngularVelocity = Vector3.zero
	task.wait(0.4)
	if not md.Running or md.Gen ~= g or md.Selected ~= m or char() ~= c or h.Health <= 0 or os.clock() < cooldownUntil then return false end
	md.Entering = m
	VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game) task.wait(0.1) VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	task.wait(0.4)
	return md.Running and md.Gen == g and md.Selected == m and os.clock() >= cooldownUntil and char() == c and h.Health > 0
end
local function machineDropdown(name, md, names)
	dropdown(TFarm, name, names, function(sel)
		if md.Active or md.Seat or md.Entering then
			cooldownUntil = math.max(cooldownUntil, os.clock() + 4)
			if hum() then hum().Jump = true end
		end
		md.Selected, md.Active, md.Seat = md.Choices[sel], nil, nil
		md.ReenterAt = math.max(md.ReenterAt, cooldownUntil)
	end)
end
local function setMachine(md, other, state)
	if not state and (md.Active or md.Seat or md.Entering) then
		md.ReenterAt = math.max(md.ReenterAt, os.clock() + 4)
		cooldownUntil = math.max(cooldownUntil, md.ReenterAt)
	end
	md.Running, md.Entering = state, nil
	md.Gen += 1 md.Active, md.Seat = nil, nil
	md.ReenterAt = math.max(md.ReenterAt, cooldownUntil)
	if not state then return end
	if toolSwitch and ex.Auto then toolSwitch:Set(false) end
	if other.Running then
		if md == MD.Squat and liftSwitch then liftSwitch:Set(false) elseif md == MD.Lift and squatSwitch then squatSwitch:Set(false) end
	end
	local g = md.Gen
	task.spawn(function()
		local last = char()
		while RT.Alive and md.Running and md.Gen == g do
			local c, h = char(), hum()
			if c ~= last then
				last, md.Active, md.Seat = c, nil, nil
				md.ReenterAt = math.max(md.ReenterAt, os.clock() + 4)
				cooldownUntil = math.max(cooldownUntil, md.ReenterAt)
			end
			if h and h.Health > 0 then
				local st = h:GetState()
				local jumped = md.Active and (st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall or (md.Seat and h.SeatPart ~= md.Seat))
				if jumped then
					md.Active, md.Seat = nil, nil
					md.ReenterAt = math.max(md.ReenterAt, os.clock() + 4)
					cooldownUntil = math.max(cooldownUntil, md.ReenterAt)
				end
				if md.Selected and not md.Active and os.clock() >= math.max(md.ReenterAt, cooldownUntil) then
					if enterMachine(md.Selected, md, g) then md.Active, md.Seat = md.Selected, h.SeatPart end
					if md.Gen == g then md.Entering = nil end
				end
			elseif md.Active then
				md.Active, md.Seat = nil, nil
				md.ReenterAt = math.max(md.ReenterAt, os.clock() + 4)
				cooldownUntil = math.max(cooldownUntil, md.ReenterAt)
			end
			task.wait(0.1)
		end
	end)
	task.spawn(function()
		while RT.Alive and md.Running and md.Gen == g do
			if md.Active then muscleEvent:FireServer("rep") end
			task.wait(0.1)
		end
	end)
end

