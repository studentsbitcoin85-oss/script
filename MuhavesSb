sec(TPets, "Auto Trading")
local trade = {Players = {}, Pets = {}, Run = false, Gen = 0}
local tradePlayerLabel = label(TPets, "Selected Players: None")
playerDropdown(TPets, "Trade: Choose Players (multi)", function(l)
	trade.Players = {}
	for _, x in ipairs(l) do table.insert(trade.Players, userFromLabel(x)) end
	tradePlayerLabel.Text = "Selected Players: " .. (#trade.Players > 0 and table.concat(trade.Players, ", ") or "None")
end, true)
button(TPets, "Add All Players", function()
	trade.Players = {}
	for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then table.insert(trade.Players, p.Name) end end
	tradePlayerLabel.Text = "Selected Players: " .. (#trade.Players > 0 and table.concat(trade.Players, ", ") or "None")
end)
local tradePetLabel = label(TPets, "Selected Pets: None")
dropdown(TPets, "Trade: Choose Pets (multi)", petList, function(l) trade.Pets = l tradePetLabel.Text = "Selected Pets: " .. (#l > 0 and table.concat(l, ", ") or "None") end, true)
switch(TPets, "Auto Trade", function(state)
	trade.Run = state trade.Gen += 1
	if not state then return end
	local g = trade.Gen
	local function go() return trade.Run and trade.Gen == g end
	while RT.Alive and go() do
		if #trade.Players > 0 and #trade.Pets > 0 then
			for _, username in ipairs(trade.Players) do
				local tp = Players:FindFirstChild(username)
				if not go() then break end
				if tp then
					local ev, unique = RS.rEvents.tradingEvent, LP.petsFolder.Unique
					ev:FireServer("sendTradeRequest", tp)
					task.wait(0.5)
					local offered, offeredPets = 0, {}
					repeat
						local added = false
						for _, sn in ipairs(trade.Pets) do
							for _, pet in ipairs(unique:GetChildren()) do
								if pet.Name == sn and not offeredPets[pet] then
									ev:FireServer("offerItem", pet) offeredPets[pet] = true offered += 1 added = true task.wait(0.01) break
								end
							end
							if not go() or offered >= 6 then break end
						end
					until not go() or offered >= 6 or not added
					task.wait(0.05)
					if go() then ev:FireServer("acceptTrade") task.wait(2) end
				end
			end
		end
		task.wait(2)
	end
end)
