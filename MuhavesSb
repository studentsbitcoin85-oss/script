-- REBIRTH (Auto Rebirth / Equip Rebirth Pets / Rebirth Target)
local repLimit = {max = REP_DEFAULT, controlled = true}

local rb = {
	rebirths = rebirthsV,
	strength = strengthV,
	running = false, workerActive = false,
	usePets = false,
	targetCount = 0,
}

UI.RbClock.active = function() return rb.running end

local function setRebirthStatus(text, color)
	UI.Rebirth.Status.Text = text
	UI.Rebirth.Status.TextColor3 = color
end

local function rebirthTargetReached()
	return rb.targetCount > 0 and rb.rebirths.Value >= rb.targetCount
end

local function stopAtTarget()
	rb.running = false
	setRebirthStatus("Status: Target reached", C_PAUSE)
	setToggle("Auto Rebirth", false)
end

-- Strength gained per rep, learned across cycles (Silence style).
local rbPerRep = nil
local RB_AD = {TargetSeconds = 3, MinRate = 3, MaxRate = 50, ProbeRate = 10, ProbeReps = 10, FeedbackTimeout = 1}
local RB_COOLDOWN = 6
local rbNextRequestAt = 0

-- Silence style: the 6 s cooldown is also counted from the moment a rebirth is confirmed (value went up).
local lastRebirthValue = rebirthsV.Value
track(rebirthsV.Changed:Connect(function(v)
	if v > lastRebirthValue then rbNextRequestAt = os.clock() + RB_COOLDOWN end
	lastRebirthValue = v
end))

local function performRebirth()
	local startReb = rb.rebirths.Value
	local target = 5000 + startReb * 2550
	local c = {
		StartStrength = rb.strength.Value, SampleStrength = rb.strength.Value,
		SampleAt = os.clock(), LastSentAt = os.clock(), Sent = 0,
		Tokens = 0, LastAt = os.clock(), StatusAt = -math.huge, Seconds = 0,
	}
	local rate = RB_AD.ProbeRate
	local function calcRate()
		if rbPerRep and rbPerRep > 0 then
			local reps = math.max(1, math.ceil(math.max(0, target - c.StartStrength) / rbPerRep))
			rate = math.clamp(reps / RB_AD.TargetSeconds, RB_AD.MinRate, RB_AD.MaxRate)
		else
			rate = RB_AD.ProbeRate
		end
	end
	local function learn(final)
		local now = os.clock()
		if not final and now - c.SampleAt < 0.25 then return end
		local str = rb.strength.Value
		local gain = str - c.StartStrength
		if gain > 0 and c.Sent > 0 and (final or str > c.SampleStrength) then
			rbPerRep = gain / c.Sent
			c.SampleStrength = str
		end
		calcRate()
		c.SampleAt = now
	end
	calcRate()
	c.Budget = rbPerRep and math.max(RB_AD.ProbeReps,
		math.ceil(math.max(0, target - c.StartStrength) / rbPerRep)) or RB_AD.ProbeReps

	local function needs()
		return rb.running and alive() and not rebirthTargetReached()
			and rb.rebirths.Value == startReb and rb.strength.Value < target
	end

	local lastT = os.clock()
	while needs() do
		local now = os.clock()
		if charAlive() then
			c.Seconds += math.max(0, now - lastT)
			learn()
			if c.Sent >= c.Budget then
				c.Tokens, c.LastAt = 0, now
				if now - c.LastSentAt >= RB_AD.FeedbackTimeout then
					local missingStr = math.max(0, target - rb.strength.Value)
					local extra = rbPerRep and math.ceil(missingStr / rbPerRep) or RB_AD.ProbeReps
					c.Budget = c.Sent + math.clamp(extra, math.ceil(RB_AD.ProbeReps / 2), RB_AD.ProbeReps)
				end
			else
				local budget = c.Budget - c.Sent
				local sent = sendReps(c, rate, 5, function()
					if budget <= 0 or not needs() then return false end
					budget -= 1
					return true
				end)
				c.Sent += sent
				if sent > 0 then c.LastSentAt = now end
			end
			if now - c.StatusAt >= 0.25 then
				setRebirthStatus("Status: Rebirthing", C_ON)
				c.StatusAt = now
			end
		else
			c.Tokens, c.LastAt = 0, now
			setRebirthStatus("Status: Waiting for respawn", C_PAUSE)
		end
		lastT = now
		services.runservice.Heartbeat:Wait()
	end

	if not (rb.running and alive()) or rb.rebirths.Value ~= startReb or rebirthTargetReached() then return end
	learn(true)
	if rb.usePets then
		equipBestRebirthPets()
		task.wait(0.25)
	end
	while rb.running and alive() and rb.rebirths.Value == startReb and not rebirthTargetReached() do
		local remaining = rbNextRequestAt - os.clock()
		if remaining > 0 then
			task.wait(math.min(remaining, 0.1))
		else
			rbNextRequestAt = os.clock() + RB_COOLDOWN
			pcall(function() rebirthRemote:InvokeServer("rebirthRequest") end)
		end
	end
end

local function startRebirthWorker()
	if rb.workerActive then return end
	rb.workerActive = true
	task.spawn(function()
		while rb.running and alive() do
			if rebirthTargetReached() then
				stopAtTarget()
				break
			end
			local ok, err = pcall(function()
				if petChosen then equipFarmingPets() end
				performRebirth()
			end)
			if not ok then
				warn("[Muhaves] Rebirth error: " .. tostring(err))
				if rb.running and alive() then
					setRebirthStatus("Status: Retrying", C_PAUSE)
					task.wait(2)
					if rb.running and alive() then setRebirthStatus("Status: Rebirthing", C_ON) end
				end
			end
			task.wait(0.1)
		end
		rb.workerActive = false
	end)
end

Callbacks.AutoRebirth = function(state)
	if not state and not rb.running then return end
	if state and rebirthTargetReached() then
		stopAtTarget()
		return
	end
	if state then
		-- Auto Rebirth and Auto Farm Strength both send reps: never run them together
		Callbacks.AutoFarmStrength(false)
		setToggle("Auto Farm Strength", false)
	end
	rb.running = state
	if state then
		equippedSet = nil
		setRebirthStatus("Status: Rebirthing", C_ON)
		startRebirthWorker()
	else
		setRebirthStatus("Status: Paused", C_PAUSE)
	end
end
Callbacks.EquipRebirthPets = function(state)
	rb.usePets = state
	equippedSet = nil
	persist("EquipRebirthPets", state)
end
Callbacks.RebirthTarget = function(v)
	rb.targetCount = math.max(0, math.floor(tonumber(v) or 0))
	persist("RebirthTarget", rb.targetCount)
end

