-- STRENGTH (Auto Farm Strength / Controlled Speed / Max Reps)
local st = {
	strength = strengthV,
	durability = duraV,
	running = false,
	runId = 0,
	controlled = true,
	startedAt = 0, totalElapsed = 0, timerStarted = false, baselineSet = false,
	calcInterval = 10,
	maxRate = REP_DEFAULT, rate = REP_DEFAULT,
	last = {str = 0, dura = 0},
	gain = {str = 0, dura = 0},
	run  = {str = 0, dura = 0},
	win  = {str = 0, dura = 0},
	lastCalcAt = 0,
}
st.last.str, st.last.dura = st.strength.Value, st.durability.Value
st.lastCalcAt = os.clock()

local function setStrengthStatus(text, color)
	UI.Strength.Status.Text = text
	UI.Strength.Status.TextColor3 = color
end

local function onValue(key, new)
	local d = new - st.last[key]
	st.last[key] = new
	if d <= 0 then return end
	if st.running or rb.running then progress.n += 1 end
	if not st.running or not st.timerStarted then return end
	st.gain[key] += d
	st.run[key] += d
end
track(st.strength.Changed:Connect(function(v) onValue("str", v) end))
track(st.durability.Changed:Connect(function(v) onValue("dura", v) end))

local function runElapsed()
	local e = st.totalElapsed
	if st.running and st.timerStarted then e += os.clock() - st.startedAt end
	return e
end

local function updateRuntime()
	local e = runElapsed()
	UI.Strength.Runtime.Text = string.format("🕒 %dd %dh %dm %ds",
		math.floor(e / 86400), math.floor((e % 86400) / 3600), math.floor((e % 3600) / 60), math.floor(e % 60))
end

local function updateStats()
	UI.Strength.Strength.Text = formatNumber(st.strength.Value)
	UI.Strength.StrengthGain.Text = "+" .. formatNumber(st.gain.str)
	UI.Strength.Durability.Text = formatNumber(st.durability.Value)
	UI.Strength.DurabilityGain.Text = "+" .. formatNumber(st.gain.dura)
end

local function updateAverages()
	local e = runElapsed()
	if e < 1 then return end
	setPace(UI.Strength.StrAverage, st.run.str / e)
	setPace(UI.Strength.DuraAverage, st.run.dura / e)
end

local function calculatePace()
	if not st.running or not st.timerStarted then return end
	local now = os.clock()
	local elapsed = now - st.lastCalcAt
	if elapsed < st.calcInterval then return end

	setPace(UI.Strength.StrPace, (st.run.str - st.win.str) / elapsed)
	setPace(UI.Strength.DuraPace, (st.run.dura - st.win.dura) / elapsed)
	st.win.str, st.win.dura = st.run.str, st.run.dura
	st.lastCalcAt = now
	updateAverages()
end

-- Strength rate control (Silence style): start at 200 reps/s, +12% every 0.5 s while the server answers,
-- -35% after 2 silent intervals. Max Reps is the ceiling.
local ST_INITIAL, ST_BURST = 200, 24
local stState = {Tokens = 0, LastAt = os.clock()}
local ctl = {at = os.clock(), prog = 0, stalled = 0}

local function resetStrengthCtl()
	st.rate = st.controlled and math.min(ST_INITIAL, st.maxRate) or st.maxRate
	stState.Tokens, stState.LastAt = 0, os.clock()
	ctl.at, ctl.prog, ctl.stalled = os.clock(), progress.n, 0
end

local function updateAdaptiveRate()
	local now = os.clock()
	st.rate = math.min(st.rate, st.maxRate)
	if now - ctl.at < 0.5 then return end
	if progress.n ~= ctl.prog then
		ctl.stalled = 0
		st.rate = math.min(st.maxRate, st.rate * 1.12)
		setStrengthStatus(st.timerStarted and "Status: Farming" or "Status: Preparing", C_ON)
	else
		ctl.stalled += 1
	end
	if ctl.stalled >= 2 then
		st.rate = math.max(math.min(ST_INITIAL, st.maxRate), st.rate * 0.65)
		stState.Tokens = 0
		setStrengthStatus("Status: Slowing", C_PAUSE)
	end
	ctl.at, ctl.prog = now, progress.n
end

-- Timer and gain counting start only once the rate has reached Max Reps (warm-up is not measured).
local function startMeasurement()
	if not st.running or st.timerStarted or st.rate < st.maxRate then return end
	local now = os.clock()
	st.timerStarted = true
	st.startedAt, st.lastCalcAt = now, now
	st.win.str, st.win.dura = st.run.str, st.run.dura
end

local function strengthLoop(myId)
	resetStrengthCtl()
	local function canSend() return st.running and st.runId == myId and alive() end
	while canSend() do
		if st.controlled then updateAdaptiveRate() else st.rate = st.maxRate end
		startMeasurement()
		sendReps(stState, st.rate, ST_BURST, canSend)
		services.runservice.Heartbeat:Wait()
	end
end

Callbacks.AutoFarmStrength = function(state)
	state = state and true or false
	if state == st.running then return end
	if state and rb.running then
		Callbacks.AutoRebirth(false)
		setToggle("Auto Rebirth", false)
	end
	st.running = state
	st.runId += 1
	if state then
		if not st.baselineSet then
			st.gain.str, st.gain.dura = 0, 0
			st.baselineSet = true
		end
		st.timerStarted, st.startedAt = false, 0
		st.win.str, st.win.dura = st.run.str, st.run.dura
		st.lastCalcAt = os.clock()
		setStrengthStatus(st.controlled and "Status: Preparing" or "Status: Farming", C_ON)
		equippedSet = nil
		if petChosen then task.spawn(equipFarmingPets) end
		task.spawn(strengthLoop, st.runId)
	else
		if st.timerStarted and st.startedAt > 0 then
			st.totalElapsed += os.clock() - st.startedAt
		end
		st.startedAt, st.timerStarted = 0, false
		updateAverages()
		if st.baselineSet then setStrengthStatus("Status: Paused", C_PAUSE)
		else setStrengthStatus("Status: Inactive", C_IDLE) end
		updateRuntime()
	end
end

Callbacks.ControlledSpeed = function(state)
	state = state and true or false
	st.controlled = state
	repLimit.controlled = state
	resetStrengthCtl()
	if st.running then setStrengthStatus(st.timerStarted and "Status: Farming" or "Status: Preparing", C_ON) end
	if rb.running then setRebirthStatus("Status: Rebirthing", C_ON) end
end

gui.Destroying:Connect(function()
	st.running = false
	st.runId += 1
	rb.running = false
end)

-- Max Reps / Second: clamped to [1, REP_CAP]. Input 0 / kosong -> default (REP_DEFAULT).
Callbacks.MaxReps = function(v)
	v = tonumber(v) or REP_DEFAULT
	if v <= 0 then v = REP_DEFAULT end
	v = math.clamp(math.floor(v), 1, REP_CAP)
	st.maxRate = v
	repLimit.max = v
	st.rate = math.min(st.rate, v)
	persist("MaxReps", v)
end

local tickCount = 0
loop(function()
	updateStats()
	tickCount += 1
	if tickCount % 4 == 0 then
		updateRuntime()
		calculatePace()
	end
	task.wait(0.25)
end)

