sec(TPets, "Crystals")
local Cr = {Catalog = RS.shared.catalogs:WaitForChild("crystalChances"), Remote = RS.rEvents:WaitForChild("openCrystalRemote"),
	Settings = {}, Dirty = {}, RetryAt = {}, Selected = nil, Amount = 1, Running = false, Rendering = false, Options = {}}
local function crystalEntries(name)
	local entries, rarest = {}, math.huge
	local folder = name and Cr.Catalog:FindFirstChild(name)
	if not folder then return entries end
	for _, item in ipairs(folder:GetChildren()) do
		local obj = item:IsA("ObjectValue") and item.Value
		local iname, kind, chance = item:GetAttribute("ItemName") or (obj and obj.Name), item:GetAttribute("ItemKind"), item:FindFirstChild("chanceValue")
		if type(iname) == "string" and (kind == "Pet" or kind == "Aura") then
			local e = {Name = iname, Kind = kind, Chance = chance and chance.Value or 0, Eligible = item:GetAttribute("AutoSellEligible") == true, Protected = item:GetAttribute("AutoSellProtected") == true}
			table.insert(entries, e)
			if kind == "Pet" then rarest = math.min(rarest, e.Chance) end
		end
	end
	for _, e in ipairs(entries) do if e.Kind == "Pet" and e.Chance == rarest then e.Protected = true end end
	table.sort(entries, function(a, b) return a.Name:lower() < b.Name:lower() end)
	return entries
end
local function normalizeSetting(name, value)
	value = type(value) == "table" and value or {}
	local res = {Enabled = value.Enabled == true, Pets = {}, Auras = {}}
	for _, e in ipairs(crystalEntries(name)) do
		local key = e.Kind == "Pet" and "Pets" or "Auras"
		if e.Eligible and not e.Protected and type(value[key]) == "table" and value[key][e.Name] == true then res[key][e.Name] = true end
	end
	return res
end
local function getSetting(name)
	if not Cr.Settings[name] then
		local ok2, s = pcall(function() return require(RS.packages.ReplicatorClient).get("Data"):TryIndex({"crystalAutoSell", name}) end)
		Cr.Settings[name] = normalizeSetting(name, ok2 and s or nil)
	end
	return Cr.Settings[name]
end
