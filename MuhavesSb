local blockedIds = {["3638729053"]=1,["3638767427"]=1,["507768375"]=1,["522635514"]=1,["522638767"]=1,["182393478"]=1,["129967390"]=1,["129967478"]=1}
local function attackToolEquipped(c)
	if not c then return false end
	for _, t in ipairs(c:GetChildren()) do
		if t:IsA("Tool") then
			local n = t.Name:lower()
			if n:find("punch") or n:find("attack") or n:find("right") then return true end
		end
	end
	return false
