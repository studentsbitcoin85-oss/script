	local names = {}
	for _, l in ipairs(list) do if Cr.Options[l] then table.insert(names, Cr.Options[l].Name) end end
	sellSelection.Text = "Auto Sell Items: " .. (#names > 0 and table.concat(names, ", ") or "None")
end, true)
sellSwitch = switch(TPets, "Auto Sell", function(e)
	if Cr.Rendering then return end
	if not Cr.Selected then sellStatus.Text = "Auto Sell: Select a crystal first" return end
	getSetting(Cr.Selected).Enabled = e
	markDirty(Cr.Selected)
end)
local function saveSetting(name)
	local rev = Cr.Dirty[name]
	local setting = normalizeSetting(name, getSetting(name))
	local ok2, res = pcall(function() return Cr.Remote:InvokeServer("saveAutoSell", name, setting) end)
	if not RT.Alive then return end
	if ok2 and type(res) == "table" and res.Ok == true and type(res.Setting) == "table" then
		if Cr.Dirty[name] == rev then
			Cr.Settings[name] = normalizeSetting(name, res.Setting)
			Cr.Dirty[name] = nil
			if Cr.Selected == name then sellStatus.Text = "Auto Sell: Saved" end
		end
	else
		Cr.RetryAt[name] = os.clock() + 5
		if Cr.Selected == name then sellStatus.Text = "Auto Sell: Save failed, retrying" end
	end
end
local function hatchCrystal(name, amount)
	if amount > 1 then
		local av, en = pcall(function() return require(RS.shared.modules.GlobalFunctions).isBulkCrystalOpenEnabled() end)
		if not av or not en then return false, "Bulk hatch is unavailable" end
		local res = Cr.Remote:InvokeServer("openCrystalBulk", name, amount)
		if type(res) ~= "table" then return false, "No hatch result" end
		return type(res.Results) == "table" and #res.Results > 0, res.StopReason
	end
	local item, rarity, image, _, _, _, reason = Cr.Remote:InvokeServer("openCrystal", name)
	return item ~= nil and rarity ~= nil and image ~= nil, reason
end
RT.loop(1, function()
	for name in pairs(Cr.Dirty) do if os.clock() >= (Cr.RetryAt[name] or 0) then saveSetting(name) end end
	if Cr.Running then
		local name, amount = Cr.Selected, Cr.Amount
		if not name then hatchStatus.Text = "Hatch: Select a crystal"
		elseif Cr.Dirty[name] then hatchStatus.Text = "Hatch: Waiting for auto-sell settings"
		else
			local s, opened, reason = pcall(hatchCrystal, name, amount)
			if Cr.Running and Cr.Selected == name then
				hatchStatus.Text = s and opened and ("Hatch: " .. name .. " | " .. amount .. "x")
					or ("Hatch: Waiting | " .. tostring(s and (reason or "Check currency, capacity and crystal access") or opened))
			end
		end
	end
end)

