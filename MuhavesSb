-- REPLAY klik yang terjadi saat objek game masih dicari (UI.Pending).
local queue = {}
for name, e in pairs(UI.Pending) do queue[#queue + 1] = {name = name, t = e.t, v = e.v} end
table.sort(queue, function(a, b) return a.t < b.t end)
for _, e in ipairs(queue) do
	local fn = Callbacks[e.name]
	if fn then
		local ok, err = pcall(fn, e.v)
		if not ok then warn("[Muhaves] Replay " .. e.name .. ": " .. tostring(err)) end
	end
end
table.clear(UI.Pending)

return UI
