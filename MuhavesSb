local repLimit = {max = REP_DEFAULT, controlled = true}
local rbGov = Gov.new()
local rb = {
	rebirths = rebirthsV, strength = strengthV,
	running = false, workerActive = false, usePets = false, targetCount = 0, timeouts = 0, backoff = 10,
}
UI.RbClock.active = function() return rb.running end

local function setRebirthStatus(text, color)
	UI.Rebirth.Status.Text = text
	UI.Rebirth.Status.TextColor3 = color
end

local function rebirthTargetReached()
	return rb.targetCount > 0 and rb.rebirths.Value >= rb.targetCount
end

local function stopAtTarget()
	rb.running = false
	setRebirthStatus("Status: Target reached", C_PAUSE)
	setToggle("Auto Rebirth", false)
end

local rbPerRep = nil
local function performRebirth()
	local target = 5000 + rb.rebirths.Value * 2550
	local tokens, last = 0, os.clock()
	local gov = rbGov
	gov.stalled, gov.lastAt = 0, os.clock()
	local held = false
	local startStr, sent = rb.strength.Value, 0
	local lastSentAt = os.clock()
	local limit = rbPerRep and math.max(10, math.ceil(math.max(0, target - startStr) / rbPerRep)) or 10

	while rb.running and alive() and not rebirthTargetReached() and rb.strength.Value < target do
		gov.max = repLimit.max
		local hold
		if not charAlive() then
			hold = "Status: Waiting for respawn"
		else
			local paused, ev = PingGuard.update(repLimit.controlled)
			if ev == "pause" then gov:backoff() elseif ev == "resume" then gov:rearm(progress.n) end
			if paused then hold = "Status: Waiting (ping)" end
		end
		if hold then
			held = true
			tokens, last = 0, os.clock()
			setRebirthStatus(hold, C_PAUSE)
			services.runservice.Heartbeat:Wait()
			continue
		end
		if held then
			held = false
			gov:rearm(progress.n)
			setRebirthStatus("Status: Rebirthing", C_ON)
		end

		local str = rb.strength.Value
		if sent > 0 and str > startStr then
			rbPerRep = (str - startStr) / sent
		end
		if sent >= limit then
			tokens, last = 0, os.clock()
			gov:rearm(progress.n)
			services.runservice.Heartbeat:Wait()
			continue
		end

		local s = gov:update(progress.n, repLimit.controlled)
		local now = os.clock()
		tokens = math.min(MAX_REP_PER_FRAME, tokens + gov.rate * math.min(MAX_DT, now - last))
		last = now
		local n = math.min(math.floor(tokens), MAX_REP_PER_FRAME, limit - sent)
		if n > 0 then
			tokens -= n
			sent += n
			lastSentAt = now
			pcall(function()
				for _ = 1, n do muscleEvent:FireServer("rep") end
			end)
		end
		services.runservice.Heartbeat:Wait()
	end

	if rb.running and alive() and not rebirthTargetReached() and rb.strength.Value >= target then
		if rb.usePets then
			equipBestRebirthPets()
			task.wait(0.1)
		end
		local before = rb.rebirths.Value
		invokeWithTimeout(rebirthRemote, 5, "rebirthRequest")
	end
end

Callbacks.AutoRebirth = function(state)
	if not state and not rb.running then return end
	if state and rebirthTargetReached() then
		stopAtTarget()
		return
	end
	if state then
		Callbacks.AutoFarmStrength(false)
		setToggle("Auto Farm Strength", false)
	end
	rb.running = state
	if state then
		equippedSet = nil
		rb.timeouts, rb.backoff = 0, 10
		rbGov:reset(repLimit.max, progress.n, repLimit.controlled)
		setRebirthStatus("Status: Rebirthing", C_ON)
		task.spawn(function()
			while rb.running and alive() do
				pcall(performRebirth)
				task.wait(0.1)
			end
		end)
	else
		setRebirthStatus("Status: Paused", C_PAUSE)
	end
end

Callbacks.EquipRebirthPets = function(state)
	rb.usePets = state
	equippedSet = nil
	persist("EquipRebirthPets", state)
end
Callbacks.RebirthTarget = function(v)
	rb.targetCount = math.max(0, math.floor(tonumber(v) or 0))
	persist("RebirthTarget", rb.targetCount)
end

---------------------------------------------------------------------
-- STRENGTH SETUP & MAX REPS (Maksimal 500, Default 50)
---------------------------------------------------------------------
local st = {
	strength = strengthV, durability = duraV,
	running = false, runId = 0, controlled = true,
	startedAt = 0, totalElapsed = 0, timerStarted = false, baselineSet = false,
	calcInterval = 10,
	maxRate = REP_DEFAULT, rate = REP_DEFAULT,
	tokens = 0, last = {str = 0, dura = 0}, gain = {str = 0, dura = 0}, run = {str = 0, dura = 0}, win = {str = 0, dura = 0},
}
st.last.str, st.last.dura = st.strength.Value, st.durability.Value

local function setStrengthStatus(text, color)
	UI.Strength.Status.Text = text
	UI.Strength.Status.TextColor3 = color
end

local function onValue(key, new)
	local d = new - st.last[key]
	st.last[key] = new
	if d <= 0 then return end
	if st.running or rb.running then progress.n += 1 end
	if not st.running then return end
	st.gain[key] += d
	if not st.timerStarted then
		st.timerStarted = true
		st.startedAt = os.clock()
		st.win.str, st.win.dura = st.run.str, st.run.dura
	else
		st.run[key] += d
	end
end
track(st.strength.Changed:Connect(function(v) onValue("str", v) end))
track(st.durability.Changed:Connect(function(v) onValue("dura", v) end))

local strGov = Gov.new()
local function strengthLoop(myId)
	local lastLoopAt = os.clock()
	while st.running and st.runId == myId and alive() do
		local now = os.clock()
		local dt = math.min(MAX_DT, now - lastLoopAt)
		lastLoopAt = now

		if not charAlive() then
			services.runservice.Heartbeat:Wait()
			continue
		end

		if st.controlled then
			strGov.max = st.maxRate
			strGov:update(progress.n, true)
			st.rate = strGov.rate
		else
			st.rate = st.maxRate
		end

		st.tokens = math.min(MAX_REP_PER_FRAME, st.tokens + st.rate * dt)
		local n = math.min(math.floor(st.tokens), MAX_REP_PER_FRAME)
		if n > 0 then
			pcall(function()
				for _ = 1, n do muscleEvent:FireServer("rep") end
			end)
			st.tokens -= n
		end
		services.runservice.Heartbeat:Wait()
	end
end

Callbacks.AutoFarmStrength = function(state)
	state = state and true or false
	if state == st.running then return end
	if state and rb.running then
		Callbacks.AutoRebirth(false)
		setToggle("Auto Rebirth", false)
	end
	st.running = state
	st.runId += 1
	if state then
		if not st.baselineSet then
			st.gain.str, st.gain.dura = 0, 0
			st.baselineSet = true
		end
		strGov:reset(st.maxRate, progress.n, st.controlled)
		setStrengthStatus("Status: Farming", C_ON)
		task.spawn(strengthLoop, st.runId)
	else
		setStrengthStatus("Status: Paused", C_PAUSE)
	end
end

Callbacks.ControlledSpeed = function(state)
	st.controlled = state and true or false
	repLimit.controlled = st.controlled
end

-- PENGATURAN MAX REPS (Max: 500, Default: 50, Reset ke default jika kosong/0)
Callbacks.MaxReps = function(v)
	local num = tonumber(v)
	if not num or num <= 0 then
		v = REP_DEFAULT
	else
		v = math.clamp(math.floor(num), 1, REP_CAP)
	end
	st.maxRate = v
	repLimit.max = v
	st.rate = math.min(st.rate, v)
	persist("MaxReps", v)
end

-- Inisialisasi konfigurasi tersimpan
if tonumber(Saved.MaxReps) then
	Callbacks.MaxReps(Saved.MaxReps)
else
	Callbacks.MaxReps(REP_DEFAULT)
end

return UI
