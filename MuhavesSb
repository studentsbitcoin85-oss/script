-- REP SENDING (gaya Silence)
local REP_CAP = CONST.REP_CAP
local REP_DEFAULT = CONST.REP_DEFAULT

-- progress.n counts every gain of Strength / Durability WHILE a farming loop is running (see onValue).
local progress = {n = 0}

-- Token bucket: sends reps at `rate` per second, at most `maxBurst` per call.
local function sendReps(state, rate, maxBurst, canSend)
	local now = os.clock()
	local elapsed = math.clamp(now - (state.LastAt or now), 0, 0.1)
	state.LastAt = now
	state.Tokens = math.min(maxBurst, (state.Tokens or 0) + rate * elapsed)
	local sent = 0
	while state.Tokens >= 1 and canSend() do
		muscleEvent:FireServer("rep")
		state.Tokens -= 1
		sent += 1
	end
	return sent
end

local function charAlive()
	local c = lp.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0
end

