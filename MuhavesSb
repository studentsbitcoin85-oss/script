-- Time slicer for background scans: yields one frame whenever the scan has used more than 4 ms.
local function slicer()
	local t0 = os.clock()
	return function()
		if os.clock() - t0 > 0.004 then
			task.wait()
			t0 = os.clock()
		end
	end
end

-- Incremental tree walk: replaces GetDescendants() on big roots. fn(instance) may return true to stop the walk.
local function walk(root, fn)
	local step = slicer()
	local stack, n = {root}, 1
	while n > 0 do
		local inst = stack[n]
		stack[n] = nil
		n -= 1
		local ok, children = pcall(inst.GetChildren, inst)
		if ok then
			for _, child in ipairs(children) do
				local okFn, stop = pcall(fn, child)
				if okFn and stop then return end
				n += 1
				stack[n] = child
				step()
			end
		end
		step()
	end
end

-- InvokeServer with a time limit. At most MAX_INFLIGHT calls can be waiting at the same time.
local inflight, MAX_INFLIGHT = 0, 4
local function invokeWithTimeout(remote, timeout, ...)
	if inflight >= MAX_INFLIGHT then return false, nil, "busy" end
	local args = table.pack(...)
	local done, ok, result = false, false, nil
	inflight += 1
	local released = false
	local function release()
		if not released then
			released = true
			inflight -= 1
		end
	end
	task.spawn(function()
		ok, result = pcall(function() return remote:InvokeServer(table.unpack(args, 1, args.n)) end)
		done = true
		release()
	end)
	task.delay(15, release)
	local t0 = os.clock()
	while not done and os.clock() - t0 < timeout do task.wait(0.05) end
	if not done then return false, nil, "timeout" end
	return ok, result, nil
end

