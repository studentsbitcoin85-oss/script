sec(TBoss, "Halloween Boss Farming")
local Hal = {D = HW, Status = label(TBoss, "Status: Waiting for Halloween Boss"), BossL = label(TBoss, "Halloween Boss: None"),
	HealthL = label(TBoss, "Health: 0 / 0"), Prefix = "Halloween Boss: "}
local hNext = label(TBoss, "Next Halloween Boss: Waiting for spawn")
function Hal.name(m) return HW.Bosses[m:GetAttribute("BossId") or m.Name] or m.Name end
function Hal.hp(_, m) return tonumber(m:GetAttribute("Health")) or 0 end
function Hal.max(_, m) return tonumber(m:GetAttribute("MaxHealth")) or 0 end
local hSelLabel = label(TBoss, "Targeted Halloween Bosses: All")
local hNames = {}
for _, id in ipairs(HW.Order) do HW.ByDisplay[HW.Bosses[id]] = id HW.Selected[id] = true table.insert(hNames, HW.Bosses[id]) end
dropdown(TBoss, "Target Halloween Bosses (multi)", hNames, function(list)
	for _, id in ipairs(HW.Order) do HW.Selected[id] = false end
	for _, d in ipairs(list) do local id = HW.ByDisplay[d] if id then HW.Selected[id] = true end end
	local sel = {}
	for _, id in ipairs(HW.Order) do if HW.Selected[id] then table.insert(sel, HW.Bosses[id]) end end
	hSelLabel.Text = "Targeted Halloween Bosses: " .. (#sel > 0 and table.concat(sel, ", ") or "None")
end, true, hNames)
local function findHalloween(selectedOnly)
	local r = root()
	local model, hitbox, closest = nil, nil, math.huge
	for _, c in ipairs(CS:GetTagged("HalloweenBoss")) do
		if c:IsA("Model") and c:IsDescendantOf(WS) and Hal.hp(nil, c) > 0 and (not selectedOnly or HW.Selected[c:GetAttribute("BossId") or c.Name] == true) then
			local hb = c:FindFirstChild("BossDamageHitbox", true) or c.PrimaryPart or c:FindFirstChild("HumanoidRootPart")
			if hb and hb:IsA("BasePart") then
				if selectedOnly and c == HW.Target then return c, nil, nil, hb end
				local d = r and (r.Position - hb.Position).Magnitude or 0
				if not model or d < closest then model, hitbox, closest = c, hb, d end
			end
		end
	end
	return model, nil, nil, hitbox
end
RT.loop(0.25, function()
	local m = HW.Target
	if not m or not m.Parent or Hal.hp(nil, m) <= 0 then m = findHalloween() end
	if m then
		Hal.BossL.Text = "Halloween Boss: " .. Hal.name(m)
		Hal.HealthL.Text = "Health: " .. fmt(Hal.hp(nil, m)) .. " / " .. fmt(Hal.max(nil, m))
		hNext.Text = "Next Halloween Boss: Current boss active"
	else
		Hal.BossL.Text, Hal.HealthL.Text = "Halloween Boss: None", "Health: 0 / 0"
		hNext.Text = "Next Halloween Boss: Waiting for spawn"
	end
end)
hwAutoSwitch = switch(TBoss, "Auto Farm Halloween Boss", function(state)
	if state and BossData.Running then bossAutoSwitch:Set(false) end
	HW.Running = state HW.Gen += 1
	if not state then
		Hal.Preparation, HW.Target, HW.Phase = nil, nil, "Waiting"
		Hal.Status.Text = "Status: Disabled"
		resumeTraining()
		return
	end
	local g, wasFighting = HW.Gen, false
	while RT.Alive and HW.Running and HW.Gen == g do
		local model
		pcall(function()
			local health, maxHealth, hitbox
			model, health, maxHealth, hitbox = findHalloween(true)
			if model then
				if wasFighting and needsRetrain(Hal) then wasFighting = false end
				if not wasFighting then
					if not prepareForBoss(Hal) then return end
					wasFighting = true
					pauseTraining()
				end
				if not HW.Running or HW.Gen ~= g or needsRetrain(Hal) then return end
				if HW.Target ~= model then HW.Target, HW.AttackSeq, HW.EvadeUntil, HW.DodgeStomps = model, nil, 0, false end
				local h = hum()
				if h and h.Health > 0 then
					Hal.Status.Text = "Status: Fighting"
					bossAttack(Hal, model, health, maxHealth, hitbox)
				else Hal.Status.Text = "Status: Waiting for Respawn" end
			else
				HW.Target = nil
				if Hal.Preparation then Hal.Preparation = nil resumeTraining()
				elseif wasFighting then resumeTraining() end
				wasFighting = false
				Hal.Status.Text = "Status: Waiting for Halloween Boss"
			end
		end)
		task.wait(model and 0.03 or 0.25)
	end
end)
