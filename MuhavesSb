local function evade(b, model, hitbox, r, h)
	local d = b.D
	local seq, kind, cf, impact = model:GetAttribute("BossAttackSequence"), model:GetAttribute("BossAttackKind"), model:GetAttribute("BossAttackCFrame"), model:GetAttribute("BossAttackImpactTime")
	if typeof(seq) == "number" and seq ~= d.AttackSeq then
		d.AttackSeq = seq
		if typeof(kind) == "string" and typeof(cf) == "CFrame" and typeof(impact) == "number" then d.EvadeUntil = impact + 0.6 end
	end
	if typeof(cf) ~= "CFrame" or WS:GetServerTimeNow() > d.EvadeUntil then return end
	kind = string.lower(tostring(kind or ""))
	if kind:find("punch", 1, true) then
		local center = bossHead(model, hitbox)
		local dir = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		if dir.Magnitude < 1 then dir = Vector3.new(hitbox.CFrame.LookVector.X, 0, hitbox.CFrame.LookVector.Z) end
		if dir.Magnitude < 1 then dir = Vector3.new(0, 0, 1) end
		r.CFrame = CFrame.lookAt(center - dir.Unit * (BossData.PunchBehind), center)
		r.AssemblyLinearVelocity, r.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
		b.Status.Text = "Status: Dodging Punch"
		return "Punch"
	end
	if not kind:find("stomp", 1, true) then return end
	if h.Health / math.max(h.MaxHealth, 1) <= BossData.StompThreshold then d.DodgeStomps = true end
	if not d.DodgeStomps then return end
	local dir = Vector3.new(r.Position.X - cf.Position.X, 0, r.Position.Z - cf.Position.Z)
	if dir.Magnitude < 1 then dir = Vector3.new(-cf.LookVector.X, 0, -cf.LookVector.Z) end
	if dir.Magnitude < 1 then dir = Vector3.new(1, 0, 0) end
	r.CFrame = CFrame.lookAt(cf.Position + dir.Unit * BossData.EvadeDistance + Vector3.new(0, 18, 0), cf.Position)
	r.AssemblyLinearVelocity, r.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
	b.Status.Text = "Status: Dodging Stomp"
	return "Stomp"
end
local function bossAttack(b, model, health, maxHealth, hitbox)
	local c, r, h = char(), root(), hum()
	if not r or not h or h.Health <= 0 then return end
	local mode = evade(b, model, hitbox, r, h)
	if mode == "Stomp" then return end
	local punch = c:FindFirstChild("Punch") or Backpack:FindFirstChild("Punch")
	if punch and punch.Parent ~= c then h:EquipTool(punch) end
	local lh, rh = c:FindFirstChild("LeftHand"), c:FindFirstChild("RightHand")
	if mode ~= "Punch" then
		local pos = bossHead(model, hitbox)
		r.CFrame = CFrame.lookAt(pos, pos + hitbox.CFrame.LookVector)
	end
	r.AssemblyLinearVelocity, r.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
	pcall(function()
		if lh then touch(hitbox, lh, 0) touch(hitbox, lh, 1) end
		if rh then touch(hitbox, rh, 0) touch(hitbox, rh, 1) end
	end)
	if os.clock() - BossData.LastPunch >= BossData.PunchInterval then
		BossData.LastPunch = os.clock()
		pcall(function()
			muscleEvent:FireServer("punch", "leftHand") muscleEvent:FireServer("punch", "rightHand")
			if punch then punch:Activate() end
		end)
	end
	b.BossL.Text = b.Prefix .. b.name(model)
	b.HealthL.Text = "Health: " .. fmt(b.hp(health, model)) .. " / " .. fmt(b.max(maxHealth, model))
end
local function aliveChar(g, timeout)
	local t0 = os.clock()
	repeat
		local c, r, h = char(), root(), hum()
		if r and h and h.Health > 0 then return c, r, h end
		bStatus.Text = "Status: Waiting for Respawn"
		task.wait(0.1)
	until not BossData.Running or BossData.Gen ~= g or (timeout and os.clock() - t0 >= timeout)
end
local function findChest()
	local chest
	for _, c in ipairs(CS:GetTagged("BossEventChest")) do if c:IsDescendantOf(WS) then chest = c break end end
	if not chest then chest = WS:FindFirstChild("BossChest", true) end
	if not chest then
		for _, c in ipairs(WS:GetDescendants()) do
			if c:IsA("ProximityPrompt") and c.Name == "bossChestPrompt" then chest = c.Parent break end
		end
	end
	if not chest then return end
	local prompt = chest:FindFirstChild("bossChestPrompt", true)
	local part = prompt and prompt.Parent or (chest:IsA("Model") and (chest.PrimaryPart or chest:FindFirstChildWhichIsA("BasePart", true))) or chest
	if part and part:IsA("BasePart") then return chest, prompt, part end
end
local function collectChest(g)
	bStatus.Text = "Status: Waiting for Chest"
	local t0, chest, prompt, part = os.clock()
	repeat
		chest, prompt, part = findChest()
		if chest and chest:GetAttribute("BossChestEmerging") ~= true then break end
		task.wait(0.1)
	until not BossData.Running or BossData.Gen ~= g or os.clock() - t0 >= 12
	if not BossData.Running or BossData.Gen ~= g or not chest or not part then return end
	bStatus.Text = "Status: Collecting Chest"
	t0 = os.clock()
	repeat
		local c, r = aliveChar(g, 2)
		if c and r and chest.Parent and part.Parent then
			pcall(function() r.CFrame = CFrame.lookAt(part.Position + Vector3.new(0, 3, 4), part.Position) r.AssemblyLinearVelocity = Vector3.zero end)
			task.wait(0.15)
			if not BossData.Running or BossData.Gen ~= g then return end
			if not (prompt and prompt.Parent and type(fireproximityprompt) == "function" and pcall(fireproximityprompt, prompt)) then
				pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game) task.wait(0.1) VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
			end
		end
		task.wait(0.25)
	until not BossData.Running or BossData.Gen ~= g or LP:GetAttribute("BossChestPending") == false or not chest.Parent or os.clock() - t0 >= 12
end

switch(TBoss, "Continue Farming after Boss Kill", function(s)
	BossData.Continue = s
	if s and BossData.Phase == "Waiting" and not HW.Running then resumeTraining() end
end, true)

local bossAutoSwitch, hwAutoSwitch
bossAutoSwitch = switch(TBoss, "Auto Farm Boss", function(state)
	if state and HW.Running then hwAutoSwitch:Set(false) end
	BossData.Running = state BossData.Gen += 1
	if not state then
		Normal.Preparation, BossData.Phase = nil, "Waiting"
		bStatus.Text = "Status: Disabled"
		resumeTraining()
		return
	end
	local g, wasFighting = BossData.Gen, false
	while RT.Alive and BossData.Running and BossData.Gen == g do
		local model, selected
		pcall(function()
			local health, maxHealth, hitbox
			model, health, maxHealth, hitbox = findActiveBoss()
			selected = model and shouldFarmBoss(model)
			if model and not selected then
				if wasFighting or Normal.Preparation then Normal.Preparation, wasFighting = nil, false resumeTraining() end
				BossData.Phase = "Waiting"
				bStatus.Text = "Status: Skipping " .. (WS:GetAttribute("BossDisplayName") or model.Name)
			elseif model then
				if wasFighting and needsRetrain(Normal) then wasFighting = false end
				if not wasFighting then
					if not prepareForBoss(Normal) then return end
					wasFighting, BossData.Phase = true, "Fighting"
					BossData.AttackSeq, BossData.EvadeUntil, BossData.DodgeStomps = nil, 0, false
					pauseTraining()
				end
				if not BossData.Running or BossData.Gen ~= g or needsRetrain(Normal) then return end
				local h = hum()
				if h and h.Health > 0 then
					bStatus.Text = "Status: Fighting"
					bossAttack(Normal, model, health, maxHealth, hitbox)
				else bStatus.Text = "Status: Waiting for Respawn" end
			elseif wasFighting then
				wasFighting, BossData.Phase = false, "Collecting"
				pcall(collectChest, g)
				if not BossData.Running or BossData.Gen ~= g then return end
				bBoss.Text, bHealth.Text = "Boss: None", "Health: 0 / 0"
				if BossData.Continue then resumeTraining() end
				BossData.Phase = "Waiting"
				bStatus.Text = "Status: Waiting for Boss"
			else
				if Normal.Preparation then Normal.Preparation = nil resumeTraining() end
				bStatus.Text = "Status: Waiting for Boss"
			end
		end)
		task.wait(model and selected and 0.03 or 0.25)
	end
end)

-- Webhook
sec(TBoss, "Boss Webhook")
local WH = {Queue = {}, Pending = {}, Failed = {}, ChestKeys = setmetatable({}, {__mode = "k"})}
_G.SilenceBossWebhookHistory = _G.SilenceBossWebhookHistory or {Seen = {}, Order = {}}
local whStatus = label(TBoss, "Webhook: Disabled")
local whInput
local function webhookUrl()
	local text = (whInput and whInput.Text or ""):match("^%s*(.-)%s*$")
	if text == "" then return nil end
	local host, path = text:match("^https://([^/]+)(/.*)$")
	local allowed = {["discord.com"] = true, ["discordapp.com"] = true, ["canary.discord.com"] = true, ["ptb.discord.com"] = true}
	if not host or not allowed[host] or not path:match("^/api/webhooks/%d+/[%w_-]+$") then return nil, "Invalid Discord webhook URL" end
	return text
end
local function httpFn()
	if type(request) == "function" then return request end
	if type(http_request) == "function" then return http_request end
	if type(syn) == "table" and type(syn.request) == "function" then return syn.request end
	if type(http) == "table" and type(http.request) == "function" then return http.request end
end
local function whNumber(v)
	v = tonumber(v) or 0
	for _, u in ipairs({{1e18,"qi"},{1e15,"qa"},{1e12,"t"},{1e9,"b"},{1e6,"m"},{1e3,"k"}}) do
		if v >= u[1] then return (string.format("%.2f", v / u[1]):gsub("0+$", ""):gsub("%.$", "")) .. u[2] end
	end
	return v == math.floor(v) and string.format("%.0f", v) or tostring(v)
end
local function queueWebhook(kind, seq, content)
	local url = webhookUrl()
	if not url then return end
	if not httpFn() then whStatus.Text = "Webhook: HTTP requests unavailable" return end
	local key = url .. "|" .. game.JobId .. "|" .. kind .. "|" .. tostring(seq)
	if WH.Pending[key] or WH.Failed[key] or _G.SilenceBossWebhookHistory.Seen[key] then return end
	if #WH.Queue >= 32 then whStatus.Text = "Webhook: Queue full" return end
	WH.Pending[key] = true
	table.insert(WH.Queue, {Url = url, Key = key, Content = content:sub(1, 2000), Attempts = 0, NextAt = 0})
	whStatus.Text = "Webhook: Queued"
end
local function rarityName(r)
	local entry = BossData.Config and BossData.Config.RARITIES and BossData.Config.RARITIES[r]
	local fb = ({"Common", "Rare", "Epic", "Legendary", "Mythic", "Rainbow"})[r]
	return entry and (entry.DisplayName or entry.Name) or (fb and fb .. " Boss")
end
local function observeSpawn()
	if WS:GetAttribute("BossActive") ~= true then return end
	local seq, name, hp = WS:GetAttribute("BossSpawnSequence"), WS:GetAttribute("BossDisplayName"), tonumber(WS:GetAttribute("BossMaxHealth"))
	if seq == nil or type(name) ~= "string" or not hp or hp <= 0 then return end
	queueWebhook("spawn", seq, name .. " Spawned!\nHealth: " .. whNumber(hp))
end
local function observeRewards(chest, rewards)
	if typeof(chest) ~= "Instance" or not chest:IsA("Model") then return end
	local rarity = chest:GetAttribute("BossRarityIndex")
	if type(rarity) ~= "number" or type(rewards) ~= "table" then return end
	local lines = {}
	for _, rw in ipairs(rewards) do
		if type(rw) == "table" and type(rw.DisplayName) == "string" and type(rw.Amount) == "number" and rw.Amount > 0 then
			local q = (rw.Amount == 1 and rw.Guaranteed ~= true) and "" or whNumber(rw.Amount) .. " "
			table.insert(lines, "- " .. q .. rw.DisplayName)
		end
	end
	if #lines == 0 then return end
	local name = rarityName(rarity)
	if not name then return end
	WH.ChestKeys[chest] = WH.ChestKeys[chest] or tostring(WS:GetAttribute("BossResultSequence") or WS:GetAttribute("BossSpawnSequence")) .. ":" .. rarity
	queueWebhook("defeated", WH.ChestKeys[chest], name .. " Defeated!\nRewards:\n" .. table.concat(lines, "\n"))
end
WH.ResultSeq = WS:GetAttribute("BossResultSequence")
local function observeDespawn()
	local seq = WS:GetAttribute("BossResultSequence")
	if seq == nil or seq == WH.ResultSeq then return end
	WH.ResultSeq = seq
	if WS:GetAttribute("BossResultKind") ~= "Survived" then return end
	local r = WS:GetAttribute("BossResultRarity")
	if type(r) ~= "number" then return end
	local name = rarityName(r)
	if name then queueWebhook("despawn", seq, name .. " Despawned!") end
end
whInput = input(TBoss, "Discord Webhook URL (optional)", function()
	local url, msg = webhookUrl()
	whStatus.Text = url and "Webhook: Ready" or ("Webhook: " .. (msg or "Disabled"))
	if url then task.defer(observeSpawn) end
end, "https://discord.com/api/webhooks/...")
RT.c(WS:GetAttributeChangedSignal("BossResultSequence"), observeDespawn)
RT.c(WS:GetAttributeChangedSignal("BossSpawnSequence"), observeSpawn)
RT.c(WS:GetAttributeChangedSignal("BossActive"), observeSpawn)
RT.c(WS:GetAttributeChangedSignal("BossMaxHealth"), observeSpawn)
task.spawn(function()
	local ev = RS:WaitForChild("rEvents"):WaitForChild("bossChestOpenedEvent", 15)
	if ev and ev:IsA("RemoteEvent") then RT.c(ev.OnClientEvent, observeRewards) end
end)
RT.loop(0.5, function()
	local item = WH.Queue[1]
	if not item or os.clock() < item.NextAt then return end
	if item.Url ~= webhookUrl() then WH.Pending[item.Key] = nil table.remove(WH.Queue, 1) return end
	local send = httpFn()
	if not send then whStatus.Text = "Webhook: HTTP requests unavailable" return end
	item.Attempts += 1
	local success, resp = pcall(function()
		return send({Url = item.Url .. "?wait=true", Method = "POST", Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode({content = item.Content, allowed_mentions = {parse = {}}})})
	end)
	local code = success and type(resp) == "table" and tonumber(resp.StatusCode or resp.Status)
	if code and code >= 200 and code < 300 then
		local hst = _G.SilenceBossWebhookHistory
		hst.Seen[item.Key] = true table.insert(hst.Order, item.Key)
		if #hst.Order > 200 then hst.Seen[table.remove(hst.Order, 1)] = nil end
		WH.Pending[item.Key] = nil table.remove(WH.Queue, 1)
		whStatus.Text = "Webhook: Sent"
		return
	end
	if (not code or code == 408 or code == 429 or code >= 500) and item.Attempts < 3 then
		local delay = 5 * item.Attempts
		if code == 429 then
			local ok2, body = pcall(function() return HttpService:JSONDecode(resp.Body) end)
			if ok2 and type(body) == "table" then delay = math.max(delay, tonumber(body.retry_after) or 0) end
		end
		item.NextAt = os.clock() + delay
		whStatus.Text = "Webhook: Retrying"
	else
		WH.Pending[item.Key], WH.Failed[item.Key] = nil, true
		table.remove(WH.Queue, 1)
		whStatus.Text = "Webhook: " .. (code and ("HTTP " .. code) or "Request failed")
	end
end)

