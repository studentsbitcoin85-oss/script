-- GOVERNOR & PING GUARD (Silence Standard)
---------------------------------------------------------------------
local REP_CAP = CONST.REP_CAP
local REP_DEFAULT = CONST.REP_DEFAULT
local MAX_DT = 0.5
local MAX_REP_PER_FRAME = math.ceil(REP_CAP * MAX_DT)
local progress = {n = 0}

local Gov = {}
Gov.__index = Gov
local function govFloor(maxRate) return math.min(maxRate, math.max(10, math.floor(maxRate * 0.3))) end
local CAP_CREEP_EVERY, CAP_CREEP_STEP = 60, 2
function Gov.new()
	return setmetatable({rate = 0, max = REP_CAP, min = 10, cap = REP_CAP, capAt = 0, lastMax = REP_CAP,
		stalled = 0, lastAt = 0, lastProg = 0, interval = 0.5}, Gov)
end
function Gov:reset(maxRate, prog, controlled)
	self.max, self.lastMax = maxRate, maxRate
	self.min = govFloor(maxRate)
	self.cap, self.capAt = maxRate, os.clock()
	self.rate = controlled and math.max(self.min, math.floor(maxRate * 0.3)) or maxRate
	self.stalled, self.lastAt, self.lastProg = 0, os.clock(), prog
end
function Gov:backoff()
	self.cap = math.max(self.min, self.rate * 0.9)
	self.capAt = os.clock()
	self.rate = math.max(self.min, self.rate * 0.65)
end
function Gov:rearm(prog)
	self.stalled, self.lastAt, self.lastProg = 0, os.clock(), prog
end
function Gov:update(prog, controlled)
	if not controlled then
		self.rate = self.max
		return nil
	end
	local now = os.clock()
	if self.max ~= self.lastMax then
		self.lastMax, self.cap, self.capAt = self.max, self.max, now
	end
	self.min = govFloor(self.max)
	self.cap = math.clamp(self.cap, self.min, self.max)
	self.rate = math.clamp(self.rate, self.min, self.cap)
	if now - self.lastAt < self.interval then return nil end
	self.lastAt = now
	local state
	if prog ~= self.lastProg then
		self.stalled = 0
		if self.rate < self.cap then self.rate = math.min(self.cap, self.rate * 1.12) end
		if self.cap < self.max and now - self.capAt >= CAP_CREEP_EVERY then
			self.cap = math.min(self.max, self.cap + CAP_CREEP_STEP)
			self.capAt = now
		end
		state = "ok"
	else
		self.stalled += 1
		if self.stalled >= 2 then
			self.cap = math.max(self.min, self.rate * 0.9)
			self.capAt = now
			self.rate = math.max(self.min, self.rate * 0.65)
			state = "slow"
		end
	end
	self.lastProg = prog
	return state
end

local function charAlive()
	local c = lp.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0
