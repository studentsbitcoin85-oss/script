-- Training pause/resume
local function leaveMachine()
	local h, r = hum(), root()
	if not h or h.Health <= 0 then return end
	pcall(function()
		VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
		h.Sit = false h.Jump = true h:ChangeState(Enum.HumanoidStateType.Jumping)
		if r then r.AssemblyLinearVelocity = Vector3.new(0, math.max(r.AssemblyLinearVelocity.Y, 50), 0) end
	end)
	pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
	cooldownUntil = math.max(cooldownUntil, os.clock() + 4)
	for _, md in pairs(MD) do md.ReenterAt = math.max(md.ReenterAt, cooldownUntil) end
	task.wait(0.2)
end
local function captureTraining()
	BossData.ResumeGen += 1
	if BossData.Snapshot then return end
	if BossData.Restore then BossData.Snapshot, BossData.Restore = BossData.Restore, nil return end
	local s = {Rebirth = reb.Auto, Size = sizeActive, King = king.On, Tool = ex.Auto, SelectedTool = ex.Tool,
		Squat = MD.Squat.Running, Lift = MD.Lift.Running,
		SquatMachine = MD.Squat.Active or MD.Squat.Selected, LiftMachine = MD.Lift.Active or MD.Lift.Selected,
		AutoRep = autoRep, Rock = rockRunning, Configs = {}}
	for _, c in ipairs(betterConfigs) do s.Configs[c.name] = activeCfg[c.name] == true end
	BossData.Snapshot = s
end
local function pauseTraining()
	captureTraining()
	local onMachine = MD.Squat.Active or MD.Squat.Entering or MD.Lift.Active or MD.Lift.Entering
	if reb.Auto then reb.Switch:Set(false) end
	if sizeActive then sizeSwitch:Set(false) end
	if king.On then kingSwitch:Set(false) end
	if ex.Auto then toolSwitch:Set(false) end
	if MD.Squat.Running then squatSwitch:Set(false) end
	if MD.Lift.Running then liftSwitch:Set(false) end
	if autoRep then autoRepSwitch:Set(false) end
	if rockRunning then rockSwitch:Set(false) end
	for _, c in ipairs(betterConfigs) do if activeCfg[c.name] then c.Switch:Set(false) end end
	if onMachine then leaveMachine() end
end
local function startSaved(s, preparing)
	if s.Squat then
		MD.Squat.Selected = s.SquatMachine
		if not MD.Squat.Running then squatSwitch:Set(true) end
	elseif s.Lift then
		MD.Lift.Selected = s.LiftMachine
		if not MD.Lift.Running then liftSwitch:Set(true) end
	elseif s.Tool or preparing then
		ex.Tool = s.Tool and s.SelectedTool or "Pushups"
		if not ex.Auto then toolSwitch:Set(true) end
	end
end
local function trainingReady(s)
	local c, h = char(), hum()
	if not h or h.Health <= 0 or not c:FindFirstChild("HumanoidRootPart") then return false end
	if s.Squat or s.Lift then
		local md = s.Squat and MD.Squat or MD.Lift
		return md.Running and md.Active ~= nil and md.Active == md.Selected and (not md.Seat or h.SeatPart == md.Seat)
	end
	if s.Tool then return ex.Auto and c:FindFirstChild(s.SelectedTool) ~= nil end
	return true
end
local function resumeTraining()
	local s = BossData.Snapshot
	if not s then return end
	BossData.Snapshot, BossData.Restore = nil, s
	BossData.ResumeGen += 1
	if not s.Tool and ex.Auto then toolSwitch:Set(false) end
	ex.Tool = s.SelectedTool
	startSaved(s, false)
	if s.Size then sizeSwitch:Set(true) end
	if s.King then kingSwitch:Set(true) end
	if s.AutoRep then autoRepSwitch:Set(true) end
	if s.Rock then rockSwitch:Set(true) end
	for _, c in ipairs(betterConfigs) do if s.Configs[c.name] and c.Switch then c.Switch:Set(true) end end
	local g = BossData.ResumeGen
	task.spawn(function()
		while RT.Alive and BossData.ResumeGen == g do
			if trainingReady(s) then
				BossData.Restore = nil
				if s.Rebirth then reb.Switch:Set(true) end
				return
			end
			task.wait(0.1)
		end
	end)
end
local function hasTrainingStats()
	local st, du = leaderstats:FindFirstChild("Strength"), LP:FindFirstChild("Durability")
	return st and du and st.Value > 0 and du.Value > 0
end
local function prepareForBoss(b)
	if not b.Preparation then pauseTraining() b.Preparation = {LastRep = 0} end
	local prep, c, h = b.Preparation, char(), hum()
	if prep.Character ~= c or prep.Rebirths ~= reb.Rebirths.Value then
		prep.Character, prep.Rebirths, prep.StartedAt, prep.LastRep = c, reb.Rebirths.Value, nil, 0
		prep.Required = not hasTrainingStats()
	end
	if not h or h.Health <= 0 then prep.StartedAt = nil b.Status.Text = "Status: Waiting for Respawn" return false end
	if not prep.Required then b.FightChar, b.FightReb, b.Preparation = c, reb.Rebirths.Value, nil return true end
	local strength = leaderstats:FindFirstChild("Strength")
	if not strength then return false end
	local toolName = strength.Value < 2000 and "Weight" or "Pushups"
	if toolName == "Weight" then prep.StartedAt = nil end
	local tool = c:FindFirstChild(toolName) or Backpack:FindFirstChild(toolName)
	if not tool then prep.StartedAt = nil b.Status.Text = "Status: Waiting for " .. toolName return false end
	if tool.Parent ~= c then h:EquipTool(tool) end
	if tool.Parent ~= c then prep.StartedAt = nil return false end
	if toolName == "Pushups" then prep.StartedAt = prep.StartedAt or os.clock() end
	if os.clock() - prep.LastRep >= 0.1 then muscleEvent:FireServer("rep") prep.LastRep = os.clock() end
	if toolName == "Weight" then b.Status.Text = "Status: Weight Training | " .. fmt(strength.Value) .. " / 2K Strength" return false end
	b.Status.Text = "Status: Training before Boss (" .. string.format("%.1f", math.max(0, BossData.PrepSeconds - (os.clock() - prep.StartedAt))) .. "s)"
	if os.clock() - prep.StartedAt < BossData.PrepSeconds then return false end
	b.FightChar, b.FightReb, b.Preparation = c, reb.Rebirths.Value, nil
	return true
end
local function needsRetrain(b)
	local h = hum()
	return not h or h.Health <= 0 or b.FightChar ~= char() or b.FightReb ~= reb.Rebirths.Value
end
local function bossHead(model, hitbox)
	local head = model:FindFirstChild("Head", true) or model:FindFirstChild("head", true)
	if head and head:IsA("BasePart") then return head.Position end
	if head and head:IsA("Bone") then return head.WorldPosition end
	return hitbox.Position + Vector3.new(0, hitbox.Size.Y * 0.35, 0)
end
