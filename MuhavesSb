-- SHARED PROPERTY LOCKS
local Shared = {
	orig = setmetatable({}, {__mode = "k"}),
	holders = setmetatable({}, {__mode = "k"}),
}
function Shared.hold(inst, prop, owner, value)
	local h = Shared.holders[inst]
	local fresh = h == nil
	if fresh then
		local okRead, orig = pcall(function() return inst[prop] end)
		if not okRead then error(orig, 0) end
		h = {}
		Shared.holders[inst] = h
		Shared.orig[inst] = {prop, orig}
	end
	local ok, err = pcall(function() inst[prop] = value end)
	if not ok then
		if fresh then
			Shared.holders[inst], Shared.orig[inst] = nil, nil
		end
		error(err, 0)
	end
	h[owner] = true
end
function Shared.release(inst, owner)
	local h = Shared.holders[inst]
	if not h or not h[owner] then return end
	h[owner] = nil
	if next(h) == nil then
		local o = Shared.orig[inst]
		Shared.holders[inst], Shared.orig[inst] = nil, nil
		if o and inst.Parent then inst[o[1]] = o[2] end
	end
end

