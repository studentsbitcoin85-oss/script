local function label(tab, text)
	local cur, obj = text, tab:CreateLabel({Text = text, Style = 1})
	return setmetatable({}, {
		__index = function(_, k) if k == "Text" then return cur end end,
		__newindex = function(_, k, v)
			if k == "Text" and v ~= cur then cur = v pcall(function() obj:Set(v) end) end
		end})
end

local function button(tab, name, cb) tab:CreateButton({Name = name, Callback = function() task.spawn(cb) end}) end

local function switch(tab, name, cb, default)
	local S, state, silent, obj = {}, false, false, nil
	function S:Set(v)
		v = v == true
		if v == state then return end
		state = v
		if obj then silent = true pcall(function() obj:Set(v) end) silent = false end
		task.spawn(cb, v)
	end
	function S:Get() return state end
	obj = tab:CreateToggle({Name = name, CurrentValue = false, Callback = function(v)
		if silent then return end
		if v ~= state then state = v task.spawn(cb, v) end
	end})
	if default then S:Set(true) end
	return S
end

local function input(tab, name, cb, placeholder)
