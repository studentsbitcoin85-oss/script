local function syncVis(s)
	if not s.OnText or not s.OnText.Parent or not s.Button or not s.Button.Parent or s.Pending or s.OnText.Visible == s.Enabled then return end
	if type(firesignal) ~= "function" or type(getconnections) ~= "function" then return end
	for _, b in ipairs({s.Button, s.Button:FindFirstChild(s.OnText.Visible and "OnButton" or "OffButton")}) do
		if b then
			for _, ev in ipairs({"MouseButton1Click", "Activated"}) do
				local ok, conns = pcall(getconnections, b[ev])
				if ok and type(conns) == "table" then
					for _, cn in ipairs(conns) do
						if cn.Enabled ~= false then
							s.Pending = true
							if pcall(firesignal, b[ev]) then return end
							s.Pending = false
						end
					end
				end
			end
		end
	end
end
local function bindVis(s)
	local node = LP
	for _, n in ipairs({"PlayerGui", "gameGui", "settingsNewMenu", "Content", "ListLayout", "ScrollingFrame", s.GuiName}) do
		node = node:WaitForChild(n, 10) if not node then return end
	end
	local onText, btn = node:WaitForChild("OnText", 10), node:WaitForChild("Switch", 10)
	if not onText or not btn then return end
	if s.OnText ~= onText or s.Button ~= btn then
		if s.Conn then s.Conn:Disconnect() end
		s.OnText, s.Button, s.Pending = onText, btn, false
		s.Conn = RT.c(onText:GetPropertyChangedSignal("Visible"), function() s.Pending = false task.defer(syncVis, s) end)
	end
	syncVis(s)
end
for _, s in ipairs(visSettings) do
	switch(TMain, s.Name, function(st) s.Enabled = st syncVis(s) end)
	task.spawn(bindVis, s)
end
