do
local function isAlive(p)
	return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0
end
local function isProtected(p)
	if not p or not p.Character then return false end
	if p.Character:FindFirstChildOfClass("ForceField") or p.Character:FindFirstChild("spawnProtectionHighlight") then return true end
	local u = p.Character:GetAttribute("SpawnProtectedUntil")
	return typeof(u) == "number" and WS:GetServerTimeNow() < u
end
local function positionNear(target, h)
	if not isAlive(target) or isProtected(target) or isProtected(LP) then return false end
	local lr = root()
	local tr = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	local hh = hum()
	if not lr or not tr or not hh or hh.Health <= 0 then return false end
	lr.CFrame = tr.CFrame * CFrame.new(0, h, 0)
	lr.AssemblyLinearVelocity = Vector3.zero lr.AssemblyAngularVelocity = Vector3.zero
	return true
end
local function touchAndPunch(target, h)
	if not positionNear(target, h) then return false, false end
	RunService.Heartbeat:Wait()
	if not positionNear(target, h) then return false, false end
	local c = char()
	local tr = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	local th = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	if not c or not tr or not th or isProtected(target) then return false, false end
	local hand = c:FindFirstChild("LeftHand") or c:FindFirstChild("RightHand")
	if not hand then return false, false end
	local tool = c:FindFirstChild("Punch") or Backpack:FindFirstChild("Punch")
	if tool and tool.Parent ~= c and hum() then hum():EquipTool(tool) end
	local before = th.Health
	local ok = pcall(function()
		touch(tr, hand, 0) touch(tr, hand, 1)
		muscleEvent:FireServer("punch", hand.Name == "LeftHand" and "leftHand" or "rightHand")
	end)
	if not ok then return false, false end
	for _ = 1, 4 do
		RunService.Heartbeat:Wait()
		if not isAlive(target) or th.Health < before then return true, true end
		if isProtected(target) then return false, false end
	end
	return false, true
end
local function attackWithLimit(target, limit, cont, h, countAttempts)
	local hits = 0
	while hits < limit and cont() and isAlive(target) and not isProtected(target) do
		local reg, att = touchAndPunch(target, h)
		if countAttempts or reg then hits += 1 end
		if not att and not countAttempts then break end
		if not reg then task.wait(0.05) end
	end
	return hits
end
local function attackForDuration(target, dur, cont, h)
	local t0 = os.clock()
	while os.clock() - t0 < dur and cont() and isAlive(target) and not isProtected(target) do
		if positionNear(target, h) then
			local c = char()
			local tr = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
			local lh, rh = c and c:FindFirstChild("LeftHand"), c and c:FindFirstChild("RightHand")
			local tool = c and (c:FindFirstChild("Punch") or Backpack:FindFirstChild("Punch"))
			if tool and hum() and tool.Parent ~= c then hum():EquipTool(tool) end
			if tr and lh and rh then
				pcall(function()
					touch(tr, lh, 0) touch(tr, lh, 1) touch(tr, rh, 0) touch(tr, rh, 1)
					muscleEvent:FireServer("punch", "leftHand") muscleEvent:FireServer("punch", "rightHand")
				end)
			end
		end
		RunService.Heartbeat:Wait()
	end
end

