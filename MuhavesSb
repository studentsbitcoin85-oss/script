	tab:CreateInput({Name = name, PlaceholderText = placeholder or "Ketik disini...", CurrentValue = "",
		RemoveTextAfterFocusLost = false, Callback = function(t) I.Text = t cb(t) end})
	return I
end

-- dropdown: single atau multi. multi -> cb(list)
local function dropdown(tab, name, options, cb, multi, initial)
	local D = {Options = options or {}}
	local function safe(list) return #list > 0 and list or {"-"} end
	local current = multi and (initial or {}) or {(initial or safe(D.Options)[1])}
	local obj
	local ok = pcall(function()
		obj = tab:CreateDropdown({Name = name, Options = safe(D.Options), CurrentOption = current, MultipleOptions = multi == true,
			Callback = function(v)
				if multi then
					local out = {}
					for _, o in ipairs(type(v) == "table" and v or {v}) do if o ~= "-" then table.insert(out, o) end end
					cb(out)
				else
					local o = type(v) == "table" and v[1] or v
					if o and o ~= "-" then cb(o) end
				end
			end})
	end)
	function D:Refresh(list, selected)
		D.Options = list
		if obj then
			pcall(function() obj:Refresh(safe(list)) end)
			if selected then pcall(function() obj:Set(selected) end) end
		end
	end
	function D:Set(v) if obj then pcall(function() obj:Set(v) end) end end
	return D
end

