-- HIDE PLAYERS
do
	local on = false
	local saved = setmetatable({}, {__mode = "k"})
	local conns = {}
	local charConn = {}
	local descConn = {}

	local function hideInst(d)
		if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
			if saved[d] == nil then saved[d] = {"Transparency", d.Transparency} end
			d.Transparency = 1
		elseif d:IsA("BillboardGui") then
			if saved[d] == nil and pcall(Shared.hold, d, "Enabled", "players", false) then
				saved[d] = {"Enabled", true, true}
			end
		elseif d:IsA("Humanoid") then
			if saved[d] == nil then saved[d] = {"DisplayDistanceType", d.DisplayDistanceType} end
			d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end
	local function hideChar(p, c)
		if descConn[p] then descConn[p]:Disconnect() end
		for _, d in ipairs(c:GetDescendants()) do hideInst(d) end
		descConn[p] = c.DescendantAdded:Connect(function(d) if on then hideInst(d) end end)
	end
	local function watch(p)
		if p == lp then return end
		if p.Character then hideChar(p, p.Character) end
		if charConn[p] then charConn[p]:Disconnect() end
		charConn[p] = p.CharacterAdded:Connect(function(c) if on then hideChar(p, c) end end)
	end

	Callbacks.HidePlayers = function(state)
		if state == on then return end
		on = state
		if on then
			for _, p in ipairs(services.players:GetPlayers()) do watch(p) end
			conns[#conns + 1] = services.players.PlayerAdded:Connect(function(p) if on then watch(p) end end)
			conns[#conns + 1] = services.players.PlayerRemoving:Connect(function(p)
				if charConn[p] then
					charConn[p]:Disconnect()
					charConn[p] = nil
				end
				if descConn[p] then
					descConn[p]:Disconnect()
					descConn[p] = nil
				end
			end)
		else
			for _, c in ipairs(conns) do c:Disconnect() end
			table.clear(conns)
			for _, c in pairs(charConn) do c:Disconnect() end
			table.clear(charConn)
			for _, c in pairs(descConn) do c:Disconnect() end
			table.clear(descConn)
			for d, v in pairs(saved) do
				if v[3] then
					pcall(Shared.release, d, "players")
				elseif d.Parent then
					pcall(function() d[v[1]] = v[2] end)
				end
			end
			table.clear(saved)
		end
	end
	gui.Destroying:Connect(function() Callbacks.HidePlayers(false) end)
end

