end
local hatchStatus = label(TPets, "Hatch: Inactive")
local crystalNames = {}
for _, f in ipairs(Cr.Catalog:GetChildren()) do table.insert(crystalNames, f.Name) end
table.sort(crystalNames, function(a, b) return a:lower() < b:lower() end)
