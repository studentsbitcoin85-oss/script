local function fmt(n)
	n = tonumber(n) or 0
	if n >= 1e18 then return string.format("%.1fqi", n / 1e18) elseif n >= 1e15 then return string.format("%.1fqa", n / 1e15)
	elseif n >= 1e12 then return string.format("%.1ft", n / 1e12) elseif n >= 1e9 then return string.format("%.1fb", n / 1e9)
	elseif n >= 1e6 then return string.format("%.1fm", n / 1e6) elseif n >= 1e3 then return string.format("%.1fk", n / 1e3) end
	return tostring(n)
end
local function commas(n)
	local s, k = tostring(math.floor(n)), 0
	while true do s, k = s:gsub("^(-?%d+)(%d%d%d)", "%1.%2") if k == 0 then break end end
	return s
end
