local function isMovement(track, c)
	local a, animate = track.Animation, c and c:FindFirstChild("Animate")
	if not a or not animate or not a:IsDescendantOf(animate) then return false end
	local path, cur = "", a
	while cur and cur ~= animate.Parent do path = path .. " " .. cur.Name:lower() if cur == animate then break end cur = cur.Parent end
	for _, bad in ipairs({"tool", "punch", "attack", "equip", "hold"}) do if path:find(bad, 1, true) then return false end end
	for _, m in ipairs({"idle", "walk", "run", "jump", "fall", "climb", "swim", "sit"}) do if path:find(m, 1, true) then return true end end
	return false
end
local function shouldBlock(track)
	if not track or not track.Animation then return false end
	local id = tostring(track.Animation.AnimationId):match("%d+")
	local n = ((track.Name or "") .. " " .. (track.Animation.Name or "")):lower()
	if blockedIds[id] then return true end
	for _, w in ipairs({"punch", "attack", "right", "equip", "tool", "hold"}) do if n:find(w, 1, true) then return true end end
	return false
end
