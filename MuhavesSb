-- Setelah respawn: catatan pet di-reset dan pet farming dipasang lagi (kalau toggle pet ON).
track(lp.CharacterAdded:Connect(function()
	equippedSet = nil
	if (st.running or rb.running) and petChosen then
		task.delay(3, function()
			if alive() and (st.running or rb.running) and petChosen then pcall(equipFarmingPets) end
		end)
	end
end))

-- Terapkan setting tersimpan. Pet TIDAK dipasang sekarang, hanya saat farming mulai.
if tonumber(Saved.RebirthTarget) then rb.targetCount = math.max(0, math.floor(Saved.RebirthTarget)) end
if tonumber(Saved.MaxReps) then Callbacks.MaxReps(Saved.MaxReps) end
if Saved.EquipRebirthPets == true then rb.usePets = true end
if Saved.PetMode == "reps" or Saved.PetMode == "strength" then
	petMode, petChosen = Saved.PetMode, true
end

