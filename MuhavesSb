local sellSelection = label(TPets, "Auto Sell Items: None")
local sellDD, sellSwitch
local function markDirty(name) Cr.Dirty[name] = (Cr.Dirty[name] or 0) + 1 Cr.RetryAt[name] = 0 sellStatus.Text = "Auto Sell: Saving" end
local function renderSetting()
