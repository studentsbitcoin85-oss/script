local function findActiveBoss()
	local model
	for _, c in ipairs(CS:GetTagged("BossEventBoss")) do
		if c:IsA("Model") and c:IsDescendantOf(WS) then model = c break end
	end
	if not model then
		local ev = WS:FindFirstChild("Events")
		local bf = ev and (ev:FindFirstChild("BossEvent") or ev:FindFirstChild("BossArena"))
		if bf then
			for _, c in ipairs(bf:GetDescendants()) do
				if c:IsA("Model") and (c:FindFirstChild("BossDamageHitbox") or c:HasTag("BossEventBoss")) then model = c break end
			end
		end
	end
	if not model then return end
	local stats = model:FindFirstChild("stats")
	local health, maxHealth = stats and stats:FindFirstChild("Health"), stats and stats:FindFirstChild("MaxHealth")
	local hitbox = model:FindFirstChild("BossDamageHitbox", true)
	if not hitbox or not hitbox:IsA("BasePart") then return end
	local cur = health and health.Value or WS:GetAttribute("BossHealth")
	if typeof(cur) == "number" and cur <= 0 then return end
	return model, health, maxHealth, hitbox
end
local function bossHealthVal(h) return h and h.Value or WS:GetAttribute("BossHealth") or 0 end
local function bossMaxVal(m) return m and m.Value or WS:GetAttribute("BossMaxHealth") or 0 end
local function countdown(s)
	s = math.max(0, math.floor(s or 0))
	return string.format("%dh %dmin %ds", math.floor(s / 3600), math.floor(s % 3600 / 60), s % 60)
end
