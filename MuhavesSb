local function readDataPing()
	local ok, ping = pcall(function()
		return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	if ok and type(ping) == "number" and ping == ping and ping >= 0 and ping < math.huge then
		return ping
	end
end

local PingGuard = {limit = 350, resume = 300, recovery = 2, paused = false, okSince = nil, checkedAt = 0}
function PingGuard.update(controlled)
	if not controlled then
		local was = PingGuard.paused
		PingGuard.paused, PingGuard.okSince = false, nil
		return false, was and "resume" or nil
	end
	local now = os.clock()
	if now - PingGuard.checkedAt < 0.25 then return PingGuard.paused, nil end
	PingGuard.checkedAt = now
	local p = readDataPing()
	if not p then return PingGuard.paused, nil end
	if p > PingGuard.limit then
		local was = PingGuard.paused
		PingGuard.paused, PingGuard.okSince = true, nil
		return true, (not was) and "pause" or nil
	end
	if PingGuard.paused then
		if p < PingGuard.resume then
			PingGuard.okSince = PingGuard.okSince or now
			if now - PingGuard.okSince >= PingGuard.recovery then
				PingGuard.paused, PingGuard.okSince = false, nil
				return false, "resume"
			end
		else
			PingGuard.okSince = nil
		end
	end
	return PingGuard.paused, nil
end

