-- LOW RESOURCE MODE = Render 3D Off + FPS cap (20) + Anti Lag + black screen.
-- Each part is its own callback (Callbacks.AntiLag / FPSCap / Render3D) that can be switched and restored on its own,
-- and Callbacks.LowResource simply calls all of them. Everything is restored when it is turned off or the UI is closed.
do
	local on = {anti = false, fps = false, black = false, r3d = true, low = false}
	local saved = setmetatable({}, {__mode = "k"})
	local conns = {}
	local overlay, origQuality, origShadows, origFps

	local function dim(o)
		if o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Smoke")
			or o:IsA("Fire") or o:IsA("Sparkles") or o:IsA("PostEffect") then
			if saved[o] == nil then saved[o] = o.Enabled end
			o.Enabled = false
		end
	end

	-- Anti Lag: lowest graphics quality, no shadows, no particles / trails / beams / post effects
	Callbacks.AntiLag = function(state)
		state = state and true or false
		if state == on.anti then return end
		on.anti = state
		if state then
			pcall(function() origQuality = settings().Rendering.QualityLevel end)
			pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
			origShadows = services.lighting.GlobalShadows
			services.lighting.GlobalShadows = false
			for _, root in ipairs({workspace, services.lighting}) do
				conns[#conns + 1] = root.DescendantAdded:Connect(function(o)
					if on.anti then pcall(dim, o) end
				end)
			end
			task.spawn(function()
				for _, root in ipairs({workspace, services.lighting}) do
					walk(root, function(o)
						if not on.anti then return true end
						pcall(dim, o)
					end)
					if not on.anti then return end
				end
			end)
		else
			for _, c in ipairs(conns) do c:Disconnect() end
			table.clear(conns)
			for o, v in pairs(saved) do
				if o.Parent then pcall(function() o.Enabled = v end) end
			end
			table.clear(saved)
			if origShadows ~= nil then services.lighting.GlobalShadows = origShadows end
			if origQuality then pcall(function() settings().Rendering.QualityLevel = origQuality end) end
		end
	end

	-- FPS cap: true = limit to 20 FPS, false = back to the original cap
	Callbacks.FPSCap = function(state)
		state = state and true or false
		if state == on.fps then return end
		on.fps = state
		if state then
			if getfpscap then pcall(function() origFps = getfpscap() end) end
			if setfpscap then pcall(setfpscap, 20) end
		elseif setfpscap then
			pcall(setfpscap, (type(origFps) == "number" and origFps > 0) and origFps or 60)
		end
	end

	-- Render 3D: true = 3D rendering enabled (normal), false = disabled
	Callbacks.Render3D = function(enabled)
		enabled = enabled and true or false
		if enabled == on.r3d then return end
		on.r3d = enabled
		pcall(function() services.runservice:Set3dRenderingEnabled(enabled) end)
	end

	-- black screen on top of the game (not a public callback, only used by Low Resource Mode)
	local function setBlack(state)
		state = state and true or false
		if state == on.black then return end
		on.black = state
		if state then
			overlay = Instance.new("ScreenGui")
			overlay.Name = "MuhavesBlack"
			overlay.ResetOnSpawn = false
			overlay.IgnoreGuiInset = true
			overlay.DisplayOrder = 5
			local f = Instance.new("Frame")
			f.Size = UDim2.fromScale(1, 1)
			f.BackgroundColor3 = Color3.new(0, 0, 0)
			f.BorderSizePixel = 0
			f.Active = false
			f.Parent = overlay
			overlay.Parent = lp:WaitForChild("PlayerGui")
		elseif overlay then
			overlay:Destroy()
			overlay = nil
		end
	end

	Callbacks.LowResource = function(state)
		state = state and true or false
		if state == on.low then return end
		on.low = state
		if state then
			Callbacks.AntiLag(true)
			Callbacks.FPSCap(true)
			setBlack(true)
			Callbacks.Render3D(false)
		else
			Callbacks.Render3D(true)
			setBlack(false)
			Callbacks.FPSCap(false)
			Callbacks.AntiLag(false)
		end
	end
	gui.Destroying:Connect(function() Callbacks.LowResource(false) end)
end

