-- It appears a bit lower on the screen (below the strength bar) and can be dragged to a new position.
local MINI_SHOW = 0.08   -- background transparency while visible (0 = solid)
local STROKE_SHOW = 0.35 -- outline transparency while visible
-- Start position: centered, below the strength bar (17% of the screen height). A new dragged position is saved.
local mp = Saved.MiniPos
