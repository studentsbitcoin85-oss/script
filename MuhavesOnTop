-- Called on every change of Strength / Durability (cheap: only a few additions).
local function onValue(key, new)
	local d = new - st.last[key]
	st.last[key] = new
	if d <= 0 then return end          -- no change, or a reset (rebirth): not a gain
	st.gain[key] += d
	st.prog += 1
	if not st.running then return end
	if not st.timerStarted then
		-- the first gain only starts the timer (its time was not measured), so it is not counted in Pace / Average
		st.timerStarted = true
		st.startedAt = tick()
		st.lastCalcAt = st.startedAt
		st.win.str, st.win.dura = st.run.str, st.run.dura
	else
		st.run[key] += d
	end
end
track(st.strength.Changed:Connect(function(v) onValue("str", v) end))
track(st.durability.Changed:Connect(function(v) onValue("dura", v) end))

-- farming time in seconds (paused time is not counted)
local function runElapsed()
	local e = st.totalElapsed
	if st.running and st.timerStarted then e += tick() - st.startedAt end
	return e
end

local function updateRuntime()
	local e = runElapsed()
	UI.Strength.Runtime.Text = string.format("🕒 %dd %dh %dm %ds",
		math.floor(e / 86400), math.floor((e % 86400) / 3600), math.floor((e % 3600) / 60), math.floor(e % 60))
end

local function updateStats()
	UI.Strength.Strength.Text = formatNumber(st.strength.Value)
	UI.Strength.StrengthGain.Text = "+" .. formatNumber(st.gain.str)
	UI.Strength.Durability.Text = formatNumber(st.durability.Value)
	UI.Strength.DurabilityGain.Text = "+" .. formatNumber(st.gain.dura)
end

-- Average = everything gained while farming / farming time (the same data and the same clock)
local function updateAverages()
	local e = runElapsed()
	if e < 1 then return end
	UI.Strength.StrAverage.Text = formatPace(st.run.str / e)
	UI.Strength.DuraAverage.Text = formatPace(st.run.dura / e)
end

-- Pace = gain in the last window / the real length of that window (also shows 0 when nothing was gained)
local function calculatePace()
	if not st.running or not st.timerStarted then return end
	local now = tick()
	local elapsed = now - st.lastCalcAt
	if elapsed < st.calcInterval then return end

	UI.Strength.StrPace.Text = formatPace((st.run.str - st.win.str) / elapsed)
	UI.Strength.DuraPace.Text = formatPace((st.run.dura - st.win.dura) / elapsed)
	st.win.str, st.win.dura = st.run.str, st.run.dura
	st.lastCalcAt = now
	updateAverages()
end

-- Controlled Speed: slowly ramps up while the server accepts, slows down when the server stalls
local function updateAdaptiveRate()
	local now = tick()
	if now - st.lastCtrlAt < st.ctrlInterval then return end

	-- progress = at least one gain since the last check (a rebirth reset is not seen as a stall)
	local progress = st.prog ~= st.lastCtrlProg
	if progress then
		st.stalled = 0
		st.rate = math.min(st.maxRate, st.rate * 1.12)
		setStrengthStatus("Status: Farming", C_ON)
	else
		st.stalled += 1
	end
	if st.stalled >= 2 then
		st.rate = math.max(st.initialRate, st.rate * 0.65)
		st.tokens = 0
		setStrengthStatus("Status: Slowing", C_PAUSE)
	end

	st.lastCtrlAt = now
	st.lastCtrlProg = st.prog
end

-- The loop belongs to one run id. When the toggle is switched off (or on again) the id changes,
-- so the old loop stops at its next frame and two loops can never run at the same time.
local function strengthLoop(myId)
	st.lastLoopAt = os.clock()
	while st.running and st.runId == myId and alive() do
		local now = os.clock()
		local dt = math.min(0.1, now - st.lastLoopAt)
		st.lastLoopAt = now

		if st.controlled then updateAdaptiveRate() else st.rate = st.maxRate end

		st.tokens = math.min(st.maxBurst, st.tokens + st.rate * dt)
		local burstLimit = math.max(1, math.min(st.maxBurst, math.ceil(st.rate * 0.05)))
		local n = math.min(math.floor(st.tokens), burstLimit)
		for _ = 1, n do muscleEvent:FireServer("rep") end
		st.tokens -= n

		services.runservice.Heartbeat:Wait()
	end
end

Callbacks.AutoFarmStrength = function(state)
	state = state and true or false
	if state == st.running then return end  -- already in that state: never start a second loop
	st.running = state
	st.runId += 1
	if state then
		if not st.baselineSet then
			-- the start of the stats is recorded ONCE, on the first start
			st.gain.str, st.gain.dura = 0, 0
			st.baselineSet = true
		end
		st.timerStarted, st.startedAt = false, 0
		st.win.str, st.win.dura = st.run.str, st.run.dura
		st.lastCalcAt = tick()
		st.rate = st.initialRate
		st.tokens = 0
		st.lastLoopAt = os.clock()
		st.lastCtrlAt = tick()
		st.lastCtrlProg = st.prog
		st.stalled = 0
		setStrengthStatus("Status: Farming", C_ON)
		if petChosen then task.spawn(equipFarmingPets) end
		task.spawn(strengthLoop, st.runId)
	else
		if st.timerStarted and st.startedAt > 0 then
			st.totalElapsed += tick() - st.startedAt
		end
		st.startedAt, st.timerStarted = 0, false
		st.tokens = 0
		updateAverages()
		if st.baselineSet then setStrengthStatus("Status: Paused", C_PAUSE)
		else setStrengthStatus("Status: Inactive", C_IDLE) end
		updateRuntime()
	end
end

Callbacks.ControlledSpeed = function(state)
	st.controlled = state
	st.stalled = 0
	st.rate = math.min(st.rate, st.maxRate)
end

-- closing the UI also switches both farming workers off (a new run id makes any running loop exit at once)
gui.Destroying:Connect(function()
	st.running = false
	st.runId += 1
	rb.running = false
end)

-- Max Reps / Second: 0 or empty = default 650 (above 650 = lag)
Callbacks.MaxReps = function(v)
	v = tonumber(v) or 0
	if v <= 0 then v = 650 end
	st.maxRate = math.max(1, v)
	st.initialRate = math.min(200, st.maxRate)
	st.rate = math.min(st.rate, st.maxRate)
end

-- UI numbers are refreshed 4 times per second (not on every value change) to keep things light
task.spawn(function()
	local tickCount = 0
	while alive() do
		updateStats()
		tickCount += 1
		if tickCount % 4 == 0 then
			updateRuntime()
			calculatePace()
		end
		task.wait(0.25)
	end
end)

