-- HIDE PETS: pakai opsi bawaan game + sembunyikan pet SEMUA pemain di server (sisi client, bisa dikembalikan).
-- Pet dikenali dari nama pet di petsFolder tiap pemain + daftar PETS.
do
	local on = false
	local saved = setmetatable({}, {__mode = "k"}) -- instance -> {properti, nilai asli}
	local names, conns = {}, {}

	local function hideInst(d)
		local prop = (d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture")) and "Transparency"
			or ((d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")) and "Enabled")
		if not prop or saved[d] ~= nil then return end
		saved[d] = {prop, d[prop]}
		d[prop] = (prop == "Enabled") and false or 1
	end
	local function hideModel(m)
		if services.players:GetPlayerFromCharacter(m) then return end
		hideInst(m)
		for _, d in ipairs(m:GetDescendants()) do hideInst(d) end
		conns[#conns + 1] = m.DescendantAdded:Connect(function(d) if on then pcall(hideInst, d) end end)
	end
	local function isPet(d)
		return (d:IsA("Model") or d:IsA("BasePart")) and names[d.Name] == true
	end
	local function refreshNames()
		local added = false
		for _, p in ipairs(services.players:GetPlayers()) do
			local pf = p:FindFirstChild("petsFolder")
			if pf then
				for _, folder in ipairs(pf:GetChildren()) do
					if folder:IsA("Folder") then
						for _, pet in ipairs(folder:GetChildren()) do
							if not names[pet.Name] then names[pet.Name] = true added = true end
						end
					end
				end
			end
		end
		return added
	end
	local function scan()
		for i, d in ipairs(workspace:GetDescendants()) do
			if not on then return end
			if isPet(d) then pcall(hideModel, d) end
			if i % 500 == 0 then task.wait() end
		end
	end

	local function setHidden(state)
		if state == on then return end
		on = state
		if on then
			for k in pairs(PETS) do names[k] = true end
			refreshNames()
			conns[#conns + 1] = workspace.DescendantAdded:Connect(function(d)
				if on and isPet(d) then pcall(hideModel, d) end
			end)
			task.spawn(scan)
			task.spawn(function()
				while on and alive() do
					task.wait(3)
					if on and refreshNames() then scan() end
				end
			end)
		else
			for _, c in ipairs(conns) do c:Disconnect() end
			table.clear(conns)
			for d, v in pairs(saved) do
				if d.Parent then pcall(function() d[v[1]] = v[2] end) end
			end
			table.clear(saved)
		end
	end

	Callbacks.HidePets = function(state)
		if showPetsEvent then showPetsEvent:FireServer(state and "hidePets" or "showPets") end
		setHidden(state)
	end
	gui.Destroying:Connect(function() setHidden(false) end)
end
-- HIDE POPUPS (sisi client, bisa dikembalikan).
-- STRICT = true  : sembunyikan SEMUA GUI yang baru muncul (clone baru) atau yang tadinya mati lalu dinyalakan game,
--                  + teks gain "+1.5K" + GUI bernama popup/notif/toast. GUI HUD yang sudah tampil tidak diganggu.
-- STRICT = false : hanya yang cocok nama (POPUP_PATTERNS) atau teks gain.
-- Selama aktif, menu game (shop dll.) tidak bisa dibuka; matikan toggle kalau mau membukanya.
do
	local on = false
	local STRICT = true
	local POPUP_PATTERNS = {"popup", "pop_up", "pop up", "notif", "toast"}
	local GAIN = "^%s*%+%s*[%d%.,]"
	local saved = setmetatable({}, {__mode = "k"}) -- instance -> {properti, nilai asli}
	local conns = {}

	local function propOf(o)
		if o:IsA("ScreenGui") or o:IsA("BillboardGui") then return "Enabled" end
		if o:IsA("GuiObject") then return "Visible" end
	end
	local function nameMatch(n)
		n = n:lower()
		for _, p in ipairs(POPUP_PATTERNS) do
			if n:find(p, 1, true) then return true end
		end
		return false
	end
	-- UI Muhaves (UI utama + layar hitam Low Resource) tidak pernah disentuh
	local function mine(o)
		if o:IsDescendantOf(gui) then return true end
		local top = o:IsA("ScreenGui") and o or o:FindFirstAncestorWhichIsA("ScreenGui") or o
		return top.Name:sub(1, 7) == "Muhaves"
	end
	local function hide(o, orig)
		local prop = propOf(o)
		if not prop or saved[o] ~= nil then return end
		local original = orig
		if original == nil then original = o[prop] end
		saved[o] = {prop, original}
		o[prop] = false
		-- kalau game menyalakannya lagi, matikan lagi selama mode ini aktif
		conns[#conns + 1] = o:GetPropertyChangedSignal(prop):Connect(function()
			if on and o[prop] ~= false then o[prop] = false end
		end)
	end
	-- aturan nama / teks gain
	local function rules(o)
		if nameMatch(o.Name) then
			hide(o)
		elseif o:IsA("TextLabel") then
			local bb = o:FindFirstAncestorWhichIsA("BillboardGui")
			local function test()
				if on and o.Text:match(GAIN) then hide(bb or o) end
			end
			test()
			if bb then conns[#conns + 1] = o:GetPropertyChangedSignal("Text"):Connect(test) end
		end
	end
	-- GUI yang sudah ada: jangan disembunyikan, tapi kalau tadinya mati lalu dinyalakan game -> matikan lagi
	local function onExisting(o)
		local prop = propOf(o)
		if not prop or mine(o) then return end
		rules(o)
		if STRICT and not o:IsA("BillboardGui") and o[prop] == false then
			conns[#conns + 1] = o:GetPropertyChangedSignal(prop):Connect(function()
				if on and o[prop] == true then hide(o, false) end
			end)
		end
	end
	-- GUI yang baru muncul
	local function onNew(o)
		local prop = propOf(o)
		if not prop or mine(o) then return end
		if STRICT then hide(o) else rules(o) end
	end

	local function setHidden(state)
		if state == on then return end
		on = state
		if on then
			for _, root in ipairs({lp:WaitForChild("PlayerGui"), workspace}) do
				conns[#conns + 1] = root.DescendantAdded:Connect(function(o)
					if on then pcall(onNew, o) end
				end)
				task.spawn(function()
					for i, o in ipairs(root:GetDescendants()) do
						if not on then return end
						pcall(onExisting, o)
						if i % 500 == 0 then task.wait() end
					end
				end)
			end
		else
			for _, c in ipairs(conns) do c:Disconnect() end
			table.clear(conns)
			for o, v in pairs(saved) do
				if o.Parent then pcall(function() o[v[1]] = v[2] end) end
			end
			table.clear(saved)
		end
	end

	Callbacks.HidePopups = setHidden
	gui.Destroying:Connect(function() setHidden(false) end)
end

