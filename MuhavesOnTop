-- STRENGTH (tombol Auto Farm Strength / Controlled Speed / Max Reps)
local st = {
	strength = ls:WaitForChild("Strength"),
	durability = lp:WaitForChild("Durability"),
	running = false, workerActive = false,
	controlled = true,                 -- Controlled Speed
	startedAt = 0, totalElapsed = 0, timerStarted = false, baselineSet = false,
	calcInterval = 10,
	maxRate = 659, initialRate = 200, rate = 200,
	tokens = 0, maxBurst = 24,
	ctrlInterval = 0.5, stalled = 0,
}
st.startStrength, st.startDurability = st.strength.Value, st.durability.Value
st.lastCalcAt, st.lastCalcStr, st.lastCalcDura = tick(), st.strength.Value, st.durability.Value
st.lastCtrlAt, st.lastCtrlStr, st.lastCtrlDura = tick(), st.strength.Value, st.durability.Value
st.lastLoopAt = os.clock()

local function setStrengthStatus(text, color)
	UI.Strength.Status.Text = text
	UI.Strength.Status.TextColor3 = color
end

local function updateRuntime()
	local e = st.totalElapsed
	if st.running and st.timerStarted then e += tick() - st.startedAt end
	UI.Strength.Runtime.Text = string.format("🕒 %dd %dh %dm %ds",
		math.floor(e / 86400), math.floor((e % 86400) / 3600), math.floor((e % 3600) / 60), math.floor(e % 60))
end

local function updateStats()
	UI.Strength.Strength.Text = formatNumber(st.strength.Value)
	UI.Strength.StrengthGain.Text = "+" .. formatNumber(st.strength.Value - st.startStrength)
	UI.Strength.Durability.Text = formatNumber(st.durability.Value)
	UI.Strength.DurabilityGain.Text = "+" .. formatNumber(st.durability.Value - st.startDurability)
end

-- timer baru mulai saat angka pertama kali naik
local function updateTimer()
	if not st.running or st.timerStarted then return end
	if st.strength.Value == st.startStrength and st.durability.Value == st.startDurability then return end
	st.timerStarted = true
	st.startedAt = tick()
	st.lastCalcAt = tick()
	st.lastCalcStr, st.lastCalcDura = st.strength.Value, st.durability.Value
end

local function calculatePace()
	if not st.running or not st.timerStarted then return end
	local elapsed = tick() - st.lastCalcAt
	if elapsed < st.calcInterval then return end

	local dS = st.strength.Value - st.lastCalcStr
	local dD = st.durability.Value - st.lastCalcDura
	if dS > 0 then UI.Strength.StrPace.Text = formatPace(dS / elapsed) end
	if dD > 0 then UI.Strength.DuraPace.Text = formatPace(dD / elapsed) end

	local avgElapsed = st.totalElapsed + tick() - st.startedAt
	if avgElapsed > 0 then
		UI.Strength.StrAverage.Text = formatPace((st.strength.Value - st.startStrength) / avgElapsed)
		UI.Strength.DuraAverage.Text = formatPace((st.durability.Value - st.startDurability) / avgElapsed)
	end

	st.lastCalcAt = tick()
	st.lastCalcStr, st.lastCalcDura = st.strength.Value, st.durability.Value
end

-- Controlled Speed: naik pelan-pelan selama server menerima, turun kalau server macet
local function updateAdaptiveRate()
	local now = tick()
	if now - st.lastCtrlAt < st.ctrlInterval then return end

	local progress = st.strength.Value > st.lastCtrlStr or st.durability.Value > st.lastCtrlDura
	if progress then
		st.stalled = 0
		st.rate = math.min(st.maxRate, st.rate * 1.12)
		setStrengthStatus("Status: Farming", C_ON)
	else
		st.stalled += 1
	end
	if st.stalled >= 2 then
		st.rate = math.max(st.initialRate, st.rate * 0.65)
		st.tokens = 0
		setStrengthStatus("Status: Slowing", C_PAUSE)
	end

	st.lastCtrlAt = now
	st.lastCtrlStr, st.lastCtrlDura = st.strength.Value, st.durability.Value
end

local startStrengthWorker
local function strengthLoop()
	st.lastLoopAt = os.clock()
	while st.running and alive() do
		local now = os.clock()
		local dt = math.min(0.1, now - st.lastLoopAt)
		st.lastLoopAt = now

		if st.controlled then updateAdaptiveRate() else st.rate = st.maxRate end

		st.tokens = math.min(st.maxBurst, st.tokens + st.rate * dt)
		local burstLimit = math.max(1, math.min(st.maxBurst, math.ceil(st.rate * 0.05)))
		local n = math.min(math.floor(st.tokens), burstLimit)
		for _ = 1, n do muscleEvent:FireServer("rep") end
		st.tokens -= n

		services.runservice.Heartbeat:Wait()
	end
	st.workerActive = false
	if st.running and alive() then startStrengthWorker() end
end

startStrengthWorker = function()
	if st.workerActive then return end
	st.workerActive = true
	task.spawn(strengthLoop)
end

Callbacks.AutoFarmStrength = function(state)
	st.running = state
	if state then
		if not st.baselineSet then
			st.startStrength, st.startDurability = st.strength.Value, st.durability.Value
			st.baselineSet = true
		end
		st.timerStarted, st.startedAt = false, 0
		st.lastCalcAt = tick()
		st.lastCalcStr, st.lastCalcDura = st.strength.Value, st.durability.Value
		st.rate = st.initialRate
		st.tokens = 0
		st.lastLoopAt = os.clock()
		st.lastCtrlAt = tick()
		st.lastCtrlStr, st.lastCtrlDura = st.strength.Value, st.durability.Value
		st.stalled = 0
		setStrengthStatus("Status: Farming", C_ON)
		if petChosen then task.spawn(equipFarmingPets) end
		startStrengthWorker()
	else
		if st.timerStarted and st.startedAt > 0 then
			st.totalElapsed += tick() - st.startedAt
			st.startedAt, st.timerStarted = 0, false
		end
		st.tokens = 0
		if st.baselineSet then setStrengthStatus("Status: Paused", C_PAUSE)
		else setStrengthStatus("Status: Inactive", C_IDLE) end
		updateRuntime()
	end
end

Callbacks.ControlledSpeed = function(state)
	st.controlled = state
	st.stalled = 0
	st.rate = math.min(st.rate, st.maxRate)
end

-- Max Reps / Second: 0 atau kosong = default 659
Callbacks.MaxReps = function(v)
	v = tonumber(v) or 0
	if v <= 0 then v = 659 end
	st.maxRate = math.max(1, v)
	st.initialRate = math.min(200, st.maxRate)
	st.rate = math.min(st.rate, st.maxRate)
end

-- angka di UI di-refresh 4x per detik (bukan tiap nilai berubah) supaya ringan
task.spawn(function()
	local tickCount = 0
	while alive() do
		updateStats()
		updateTimer()
		tickCount += 1
		if tickCount % 4 == 0 then
			updateRuntime()
			calculatePace()
		end
		task.wait(0.25)
	end
end)

