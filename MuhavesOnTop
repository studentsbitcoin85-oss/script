local function loop(interval, fn)
    task.spawn(function()
        while alive() do
            local ok, err = pcall(fn)
            if not ok then warn("[Farming] " .. tostring(err)) end
            task.wait(interval)
        end
    end)
end

-- Log di layar: tetap terlihat walau notifikasi/console tidak tampil
local logGui, logLabel, logLines, hadError = nil, nil, {}, false
local function ensureLog()
    if logGui and logGui.Parent then return end
    logGui = Instance.new("ScreenGui")
    logGui.Name = "MuhavesDebug"
    logGui.ResetOnSpawn = false
    logGui.DisplayOrder = 999
    logGui.IgnoreGuiInset = true
    local placed = false
    if type(gethui) == "function" then
        placed = pcall(function() logGui.Parent = gethui() end) and logGui.Parent ~= nil
    end
    if not placed then
        placed = pcall(function() logGui.Parent = game:GetService("CoreGui") end) and logGui.Parent ~= nil
    end
    if not placed then logGui.Parent = player:WaitForChild("PlayerGui") end
    logLabel = Instance.new("TextLabel")
    logLabel.BackgroundColor3 = Color3.new(0, 0, 0)
    logLabel.BackgroundTransparency = 0.25
    logLabel.TextColor3 = Color3.new(1, 1, 1)
    logLabel.Font = Enum.Font.Code
    logLabel.TextSize = 14
    logLabel.TextWrapped = true
    logLabel.TextXAlignment = Enum.TextXAlignment.Left
    logLabel.TextYAlignment = Enum.TextYAlignment.Top
    logLabel.Position = UDim2.fromOffset(10, 40)
    logLabel.Size = UDim2.fromOffset(460, 170)
    logLabel.Parent = logGui
end

local function notify(text, isError)
    text = tostring(text)
    warn("[Muhaves] " .. text)
    if isError then hadError = true end
    table.insert(logLines, (isError and "[X] " or "[ok] ") .. text)
    if #logLines > 9 then table.remove(logLines, 1) end
    pcall(function()
        ensureLog()
        logLabel.Text = table.concat(logLines, "\n")
    end)
end

local function hideLog()
    if logGui and not hadError then pcall(function() logGui:Destroy() end) end
end

