-- Header greeting ("Muhaves V1 | Fast Farming - Hey, username!").
-- It is as BIG as possible (up to GREET_MAX) and stretches until just before the zoom buttons,
-- so it never gets cut off or overlaps the buttons. It is re-fitted every time the window size changes.
local greetLbl, greetX
local GREET_MAX, GREET_MIN = 22, 9
local BTN_ZONE = 186 -- space reserved on the right for the - / + / minimize / close buttons
local function fitGreet(W)
	if not greetLbl then return end
	local avail = math.max(60, W - BTN_ZONE - greetX)
	greetLbl.Size = UDim2.fromOffset(avail, 40)
	local txt, sz = greetLbl.Text, GREET_MAX
	while sz > GREET_MIN and tw(txt, sz, greetLbl.Font) > avail do sz -= 1 end
	greetLbl.TextSize = sz
end

-- Auto scale only follows the screen WIDTH and never goes below MINSCALE.
-- If the screen is still too small, the window content scrolls (it is not shrunk any further).
-- The - / + buttons in the header set a manual zoom (saved), capped at MAXSCALE.
local MINSCALE, MAXSCALE = 0.85, 2.5
local userScale = tonumber(Saved.Zoom)
if userScale then userScale = math.clamp(userScale, 0.5, MAXSCALE) end
local body, minimized = nil, false

local function layoutWindow(animate)
	local v = cam.ViewportSize
	local s = userScale or math.clamp((v.X - 16) / cur.w, MINSCALE, 1)
	local W = math.max(320, math.min(cur.w, (v.X - 16) / s))
	local H = minimized and HH or math.min(cur.h, math.max(HH + 160, (v.Y - 16) / s))
	if body then body.CanvasSize = UDim2.fromOffset(cur.w, cur.h - HH) end
	fitGreet(W)
	if animate then
		-- both the scale and the size are tweened, so zooming and resizing glide smoothly
		TweenService:Create(scale, SMOOTH, {Scale = s}):Play()
		TweenService:Create(win, SMOOTH, {Size = UDim2.fromOffset(W, H)}):Play()
	else
		scale.Scale = s
		win.Size = UDim2.fromOffset(W, H)
	end
end

