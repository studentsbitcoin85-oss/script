-- Live rebirth display: Rebirths (total, full number), Gained (since the script started), pace per hour / day.
-- Only reads values; it does not change anything in the game.
do
	local rbObj, startVal, startT, tries = nil, nil, 0, 0
	task.spawn(function()
		while gui.Parent do
			if not (rbObj and rbObj.Parent) then
				rbObj = nil
				if tries % 6 == 0 then pcall(function() rbObj = findRebirthObj() end) end
				tries += 1
			end
			local n
			if rbObj then
				n = tonumber(rbObj.Value)
			else
				local a = LocalPlayer:GetAttribute("Rebirths")
				if type(a) == "number" then n = a end
			end

			if n then
				if not startVal then startVal, startT = n, os.clock() end
				if n < startVal then startVal = n end -- the count went down (reset): start again from here, never a negative Gained
				local gained = n - startVal
				rbRebirths.Text = full(n)
				rbGained.Text = abbr(gained)
				local elapsed = os.clock() - startT
				if elapsed >= 10 then
					local perHour = gained / elapsed * 3600
					rbHour.Text = abbr(perHour)
					rbDay.Text = abbr(perHour * 24)
				else
					rbHour.Text, rbDay.Text = "--", "--"
				end
			else
				rbRebirths.Text, rbGained.Text, rbHour.Text, rbDay.Text = "N/A", "--", "--", "--"
			end
			task.wait(0.5)
		end
	end)
end

