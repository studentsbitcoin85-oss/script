-- HIDE PLAYERS: hides other players' characters (can be restored)
do
	local on = false
	local saved = setmetatable({}, {__mode = "k"})
	local conns = {}

	local function hideInst(d)
		if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
			if saved[d] == nil then saved[d] = d.Transparency end
			d.Transparency = 1
		end
	end
	local function hideChar(c)
		for _, d in ipairs(c:GetDescendants()) do hideInst(d) end
		conns[#conns + 1] = c.DescendantAdded:Connect(function(d) if on then hideInst(d) end end)
	end
	local function watch(p)
		if p == lp then return end
		if p.Character then hideChar(p.Character) end
		conns[#conns + 1] = p.CharacterAdded:Connect(function(c) if on then hideChar(c) end end)
	end

	Callbacks.HidePlayers = function(state)
		if state == on then return end
		on = state
		if on then
			for _, p in ipairs(services.players:GetPlayers()) do watch(p) end
			conns[#conns + 1] = services.players.PlayerAdded:Connect(function(p) if on then watch(p) end end)
		else
			for _, c in ipairs(conns) do c:Disconnect() end
			table.clear(conns)
			for d, v in pairs(saved) do
				if d.Parent then pcall(function() d.Transparency = v end) end
			end
			table.clear(saved)
		end
	end
	gui.Destroying:Connect(function() Callbacks.HidePlayers(false) end)
end

