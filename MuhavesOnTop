local miniScale = new("UIScale", {}, mini)
local miniLines = {}
for i = 1, 3 do
	local ln = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, (i - 2) * 6),
