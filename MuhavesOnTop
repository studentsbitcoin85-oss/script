-- Statistik rebirth (Rebirths, Gained, Pace) dihitung oleh tampilan live di UI.
local ls = lp:WaitForChild("leaderstats")
local rb = {
	rebirths = ls:WaitForChild("Rebirths"),
	strength = ls:WaitForChild("Strength"),
	running = false, workerActive = false,
	usePets = true,      -- Equip Rebirth Pets
	targetCount = 0,     -- Rebirth Target: berhenti saat rebirth >= angka ini (0 = tanpa batas)
}

local function setRebirthStatus(text, color)
	UI.Rebirth.Status.Text = text
	UI.Rebirth.Status.TextColor3 = color
end

local function rebirthTargetReached()
	return rb.targetCount > 0 and rb.rebirths.Value >= rb.targetCount
end

local function stopAtTarget()
	rb.running = false
	setRebirthStatus("Status: Target reached", C_PAUSE)
	local setter = UI.Toggles["opt:Auto Rebirth"]
	if setter then setter(false, true) end
end

local function performRebirth()
	local target = 5000 + rb.rebirths.Value * 2550
	local reps = lp.MembershipType == Enum.MembershipType.Premium and 6 or 12

	while rb.running and alive() and not rebirthTargetReached() and rb.strength.Value < target do
		for _ = 1, reps do muscleEvent:FireServer("rep") end
		task.wait(0.02)
	end

	if rb.running and alive() and not rebirthTargetReached() and rb.strength.Value >= target then
		if rb.usePets then
			equipBestRebirthPets()
			task.wait(0.25)
		end
		local before, started = rb.rebirths.Value, tick()
		-- dibatasi 10 detik supaya tidak nembak InvokeServer selamanya kalau syaratnya meleset
		repeat
			services.replicatedstorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest")
			task.wait(0.05)
		until rb.rebirths.Value > before or not rb.running or not alive() or tick() - started > 10
	end
end

local function startRebirthWorker()
	if rb.workerActive then return end
	rb.workerActive = true
	task.spawn(function()
		while rb.running and alive() do
			if rebirthTargetReached() then
				stopAtTarget()
				break
			end
			equipFarmingPets()
			performRebirth()
			task.wait(0.5)
		end
		rb.workerActive = false
	end)
end

Callbacks.AutoRebirth = function(state)
	if state and rebirthTargetReached() then
		stopAtTarget()
		return
	end
	rb.running = state
	if state then
		setRebirthStatus("Status: Rebirthing", C_ON)
		startRebirthWorker()
	else
		setRebirthStatus("Status: Paused", C_PAUSE)
	end
end
