local function eachPet(fn)
    local petsFolder = player:FindFirstChild("petsFolder")
    if not petsFolder then return end
    for _, folder in ipairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in ipairs(folder:GetChildren()) do fn(pet) end
        end
    end
end

local function unequipAllPets()
    eachPet(function(pet) equipPetEvent:FireServer("unequipPet", pet) end)
    task.wait(0.1)
end

local function getOwnedPets()
    local owned = {}
    eachPet(function(pet)
        local cfg = PETS[pet.Name]
        if cfg then
            table.insert(owned, {
                instance = pet,
                repSpeed = cfg.repSpeed or 0,
                strength = cfg.strength or 0,
                durability = cfg.durability or 0,
                rebirth = cfg.rebirth or 0,
            })
        end
    end)
    return owned
end

local function equipBestFarmingPets()
    unequipAllPets()
    local pets = getOwnedPets()
    local equipped, count, rep = {}, 0, 0

    table.sort(pets, function(a, b) return a.repSpeed > b.repSpeed end)
    for _, p in ipairs(pets) do
        if count >= MAX_PET_SLOTS or rep >= TARGET_REP_SPEED then break end
        if p.repSpeed > 0 then
            equipPetEvent:FireServer("equipPet", p.instance)
            equipped[p.instance] = true
            count = count + 1
            rep = rep + p.repSpeed
        end
    end

    local rest = {}
    for _, p in ipairs(pets) do
        if not equipped[p.instance] then table.insert(rest, p) end
    end
    table.sort(rest, function(a, b)
        return (a.strength + a.durability) > (b.strength + b.durability)
    end)
    for _, p in ipairs(rest) do
        if count >= MAX_PET_SLOTS then break end
        if p.strength > 0 or p.durability > 0 then
            equipPetEvent:FireServer("equipPet", p.instance)
            count = count + 1
        end
    end
end

local function equipBestRebirthPets()
    unequipAllPets()
    local pets = getOwnedPets()
    table.sort(pets, function(a, b) return a.rebirth > b.rebirth end)
    local count = 0
    for _, p in ipairs(pets) do
        if count >= MAX_PET_SLOTS then break end
        if p.rebirth > 0 then
            equipPetEvent:FireServer("equipPet", p.instance)
            count = count + 1
        end
    end
end

----------------------------------------------------------------------
-- Fast Rebirth
----------------------------------------------------------------------
do
    local st = {
        running = false, workerActive = false, hasStarted = false,
        timerStarted = false, startedAt = 0, totalElapsed = 0,
        gained = 0, lastSeen = rebirthVal.Value,
        paceReady = false, lastAt = tick(), lastValue = rebirthVal.Value,
        avgStartAt = 0, avgStartGained = 0,
        petMode = nil,
        base = 5000,           -- dari "Rebirth Target"
        useRebirthPets = true, -- dari "Equip Rebirth Pets"
    }

    local function refresh()
        setText(R.Rebirths, fmt(rebirthVal.Value))
        setText(R.Gained, fmt(st.gained))
    end
    refresh()

    local function updatePace()
        if not st.running then return end
        local now = tick()
        if not st.paceReady then
            st.paceReady = true
            st.timerStarted = true
            st.startedAt = now
            st.lastAt, st.lastValue = now, rebirthVal.Value
            st.avgStartAt, st.avgStartGained = now, st.gained
            return
        end
        if rebirthVal.Value <= st.lastValue then return end

        local secondsPer = (now - st.lastAt) / (rebirthVal.Value - st.lastValue)
        setText(R.PaceHour, fmt(3600 / secondsPer))
        setText(R.PaceDay, fmt(86400 / secondsPer))
        st.lastAt, st.lastValue = now, rebirthVal.Value
    end

    track(rebirthVal:GetPropertyChangedSignal("Value"):Connect(function()
        if not alive() then return end
        local v = rebirthVal.Value
        if st.running then st.gained = st.gained + (v - st.lastSeen) end
        st.lastSeen = v
        refresh()
        updatePace()
    end))

    local function performRebirth()
        local target = st.base + rebirthVal.Value * 2550
        local burst = player.MembershipType == Enum.MembershipType.Premium and 6 or 12

        while st.running and alive() and strengthVal.Value < target do
            fireRep(burst)
            task.wait(0.02)
        end
        if not (st.running and alive() and strengthVal.Value >= target) then return end

        if st.useRebirthPets then
            equipBestRebirthPets()
            st.petMode = "rebirth"
            task.wait(0.25)
        end

        local before = rebirthVal.Value
        local startedTry = tick()
        repeat
            rebirthRemote:InvokeServer("rebirthRequest")
            task.wait(0.05)
        until rebirthVal.Value > before
            or not st.running
            or not alive()
            or tick() - startedTry > 10
    end

    local function startWorker()
        if st.workerActive then return end
        st.workerActive = true
        task.spawn(function()
            while st.running and alive() do
                if st.petMode ~= "farm" then
                    equipBestFarmingPets()
                    st.petMode = "farm"
                end
                local ok, err = pcall(performRebirth)
                if not ok then warn("[Rebirth] " .. tostring(err)) task.wait(1) end
                task.wait(0.5)
            end
            st.workerActive = false
        end)
    end

    CB.AutoRebirth = function(state)
        st.running = state
        if state then
            st.hasStarted = true
            st.lastSeen = rebirthVal.Value
            st.startedAt, st.timerStarted = 0, false
            st.lastAt, st.lastValue = tick(), rebirthVal.Value
            st.paceReady = false
            setText(R.Status, "Status: Rebirth")
            startWorker()
        else
            if st.timerStarted and st.startedAt > 0 then
                st.totalElapsed = st.totalElapsed + tick() - st.startedAt
                st.startedAt, st.timerStarted = 0, false
            end
            setText(R.Status, st.hasStarted and "Status: Paused" or "Status: Inactive")
        end
    end

    CB.EquipRebirthPets = function(state) st.useRebirthPets = state end
    CB.RebirthTarget = function(v)
        if type(v) == "number" and v > 0 then st.base = v end
    end
end

----------------------------------------------------------------------
-- Fast Strength
----------------------------------------------------------------------
do
    local st = {
        running = false, workerActive = false,
        timerStarted = false, startedAt = 0, totalElapsed = 0,
        gainedStr = 0, gainedDur = 0,
        lastSeenStr = strengthVal.Value, lastSeenDur = durabilityVal.Value,
        calcInterval = 10, lastCalcAt = tick(), calcStr = 0, calcDur = 0,
        controlled = true,
    }
    local a = {
        initialRate = 200, maxRate = 659, rate = 200,
        tokens = 0, maxBurst = 24, controlInterval = 0.5,
        lastControlAt = tick(), lastStr = 0, lastDur = 0, stalled = 0,
    }

    local function refresh()
        setText(S.Strength, fmt(strengthVal.Value))
        setText(S.StrengthGain, "+" .. fmt(st.gainedStr))
        setText(S.Durability, fmt(durabilityVal.Value))
        setText(S.DurabilityGain, "+" .. fmt(st.gainedDur))
    end
    refresh()

    local function resetSample()
        st.lastCalcAt = tick()
        st.calcStr, st.calcDur = st.gainedStr, st.gainedDur
    end

    local function onChanged()
        local str, dur = strengthVal.Value, durabilityVal.Value
        local dStr, dDur = str - st.lastSeenStr, dur - st.lastSeenDur
        st.lastSeenStr, st.lastSeenDur = str, dur

        if st.running then
            st.gainedStr = st.gainedStr + dStr
            st.gainedDur = st.gainedDur + dDur
        end
        refresh()

        if not st.running or st.timerStarted then return end
        if dStr == 0 and dDur == 0 then return end
        st.timerStarted = true
        st.startedAt = tick()
        resetSample()
    end
    track(strengthVal:GetPropertyChangedSignal("Value"):Connect(function()
        if alive() then onChanged() end
    end))
    track(durabilityVal:GetPropertyChangedSignal("Value"):Connect(function()
        if alive() then onChanged() end
    end))

    local function updateRuntime()
        local e = st.totalElapsed
        if st.running and st.timerStarted then e = e + tick() - st.startedAt end
        setText(S.Runtime, "🕒 " .. duration(e))
    end

    local function calculatePace()
        if not st.running or not st.timerStarted then return end
        local now = tick()
        local dt = now - st.lastCalcAt
        if dt < st.calcInterval then return end

        local dStr, dDur = st.gainedStr - st.calcStr, st.gainedDur - st.calcDur
        if dStr > 0 then setText(S.StrPace, paceText(dStr / dt)) end
        if dDur > 0 then setText(S.DuraPace, paceText(dDur / dt)) end

        local avgElapsed = st.totalElapsed + now - st.startedAt
        if avgElapsed > 0 then
            setText(S.StrAverage, paceText(st.gainedStr / avgElapsed))
            setText(S.DuraAverage, paceText(st.gainedDur / avgElapsed))
        end
        resetSample()
    end

    loop(1, function()
        updateRuntime()
        calculatePace()
    end)

    local function resetControl()
        a.rate = a.initialRate
        a.tokens = 0
        a.lastControlAt = tick()
        a.lastStr, a.lastDur = strengthVal.Value, durabilityVal.Value
        a.stalled = 0
    end

    local function updateAdaptiveRate()
        local now = tick()
        if now - a.lastControlAt < a.controlInterval then return end

        local progress = strengthVal.Value > a.lastStr or durabilityVal.Value > a.lastDur
        if progress then
            a.stalled = 0
            a.rate = math.min(a.maxRate, a.rate * 1.12)
            setText(S.Status, "Status: Farming")
        else
            a.stalled = a.stalled + 1
        end
        if a.stalled >= 2 then
            a.rate = math.max(a.initialRate, a.rate * 0.65)
            a.tokens = 0
            setText(S.Status, "Status: Slowing")
        end

        a.lastControlAt = now
        a.lastStr, a.lastDur = strengthVal.Value, durabilityVal.Value
    end

    local function workerLoop()
        local last = os.clock()
        while st.running and alive() do
            local now = os.clock()
            local dt = math.min(0.1, now - last)
            last = now

            local rate
            if st.controlled then
                updateAdaptiveRate()
                rate = a.rate
            else
                rate = a.maxRate
            end

            a.tokens = math.min(a.maxBurst, a.tokens + rate * dt)
            local burstLimit = math.max(1, math.min(a.maxBurst, math.ceil(rate * 0.05)))
            local count = math.min(math.floor(a.tokens), burstLimit)
            fireRep(count)
            a.tokens = a.tokens - count

            RunService.Heartbeat:Wait()
        end
    end

    local function startWorker()
        if st.workerActive or not st.running or not alive() then return end
        st.workerActive = true
        task.spawn(function()
            local ok, err = pcall(workerLoop)
            if not ok then warn("[Strength] " .. tostring(err)) end
            st.workerActive = false
            if st.running and alive() then
                task.wait(0.5)
                startWorker()
            end
        end)
    end

    local hasStarted = false
    CB.AutoFarmStrength = function(state)
        st.running = state
        if state then
            hasStarted = true
            st.lastSeenStr, st.lastSeenDur = strengthVal.Value, durabilityVal.Value
            st.timerStarted, st.startedAt = false, 0
            resetSample()
            resetControl()
            setText(S.Status, "Status: Farming")
            startWorker()
        else
            if st.timerStarted and st.startedAt > 0 then
                st.totalElapsed = st.totalElapsed + tick() - st.startedAt
                st.startedAt, st.timerStarted = 0, false
            end
            a.tokens = 0
            setText(S.Status, hasStarted and "Status: Paused" or "Status: Inactive")
            updateRuntime()
        end
    end

    CB.ControlledSpeed = function(state) st.controlled = state end
    CB.MaxReps = function(v)
        if type(v) ~= "number" then return end
        a.maxRate = math.max(1, v)
        a.rate = math.min(a.rate, a.maxRate)
    end
end

----------------------------------------------------------------------
-- Other
----------------------------------------------------------------------
do
    local function findTool(name)
        local char = player.Character
        local backpack = player:FindFirstChild("Backpack")
        return (char and char:FindFirstChild(name))
            or (backpack and backpack:FindFirstChild(name))
    end

    local function useTool(name, action, times)
        local tool = findTool(name)
        if not tool then return end
        for _ = 1, times or 1 do
            muscleEvent:FireServer(action, tool)
        end
    end

    -- Eat eggs
    local autoEgg = false
    loop(0.5, function()
        if autoEgg then useTool("Protein Egg", "proteinEgg", 10) end
    end)
    CB.EatEggs = function(state)
        autoEgg = state
        if state then useTool("Protein Egg", "proteinEgg", 10) end
    end

    -- Eat shake (tiap 150 detik)
    local autoShake = false
    task.spawn(function()
        while alive() do
            if autoShake then
                pcall(useTool, "Tropical Shake", "tropicalShake", 1)
                for _ = 1, 150 do
                    if not autoShake or not alive() then break end
                    task.wait(1)
                end
            else
                task.wait(1)
            end
        end
    end)
    CB.EatShake = function(state) autoShake = state end

    -- Fortune wheel (generation counter: tidak ada loop ganda)
    local wheelGen = 0
    CB.SpinWheel = function(on)
        wheelGen = wheelGen + 1
        local gen = wheelGen
        if not on then return end
        task.spawn(function()
            local remote = rEvents:FindFirstChild("openFortuneWheelRemote")
            local ok, chances = pcall(function()
                return ReplicatedStorage.shared.catalogs.fortuneWheelChances["Fortune Wheel"]
            end)
            if not remote or not ok then return end
            while alive() and gen == wheelGen do
                pcall(function()
                    remote:InvokeServer("openFortuneWheel", chances)
                end)
                task.wait(1)
            end
        end)
    end

    -- Eat all boosts
    local eatAll = false
    task.spawn(function()
        while alive() do
            if eatAll then
                for _, b in ipairs(BOOSTS) do
                    if not eatAll or not alive() then break end
                    useTool(b[1], b[2], 10)
                end
                task.wait(0.1)
            else
                task.wait(1)
            end
        end
    end)
    CB.EatAllBoosts = function(state) eatAll = state end

    -- Hide pets (di UI default-nya ON)
    CB.HidePets = function(state)
        showPetsEvent:FireServer(state and "hidePets" or "showPets")
    end
    CB.HidePets(true)

    setText(O.Status, "Status: Ready")
end
