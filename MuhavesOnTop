----------------------------------------------------------------------
-- Formatter
----------------------------------------------------------------------
local SUFFIXES = {
    { 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" },
    { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" },
}
local function fmt(n)
    local sign = n < 0 and "-" or ""
    n = math.abs(n)
    for _, s in ipairs(SUFFIXES) do
        if n >= s[1] then
            return string.format("%s%.2f%s", sign, n / s[1], s[2])
        end
    end
    return string.format("%s%.0f", sign, n)
end

local function paceText(perSecond)
    return string.format("%s/s | %s/m | %s/h | %s/d",
        fmt(perSecond), fmt(perSecond * 60), fmt(perSecond * 3600), fmt(perSecond * 86400))
end

local function duration(sec)
    return string.format("%dd %dh %dm %ds",
        math.floor(sec / 86400), math.floor((sec % 86400) / 3600),
        math.floor((sec % 3600) / 60), math.floor(sec % 60))
end

----------------------------------------------------------------------
-- Load library UI (dengan patch callback)
----------------------------------------------------------------------
local function loadLibrary()
    local src = game:HttpGet(LIB_URL)
    local total = 0
    for _, name in ipairs(LATE) do
        local n
        src, n = src:gsub("Callbacks%." .. name .. "%f[%W]",
            'function(...) local f = Callbacks["' .. name .. '"] if f then return f(...) end end')
        total = total + n
    end
    if total == 0 then
        warn("[Connector] Patch callback tidak menemukan referensi (library mungkin sudah diperbaiki).")
    end
    local fn = assert(loadstring(src))
    return fn()
end

local UI = loadLibrary()
local R, S, O, CB = UI.Rebirth, UI.Strength, UI.Other, UI.Callbacks

local function setText(lbl, text)
    if lbl and lbl.Parent then lbl.Text = text end
end

-- Teks stat bisa lebih panjang dari placeholder: kecilkan otomatis agar muat
local function fit(lbl, maxSize)
    if not lbl then return end
    lbl.TextScaled = true
    local c = Instance.new("UITextSizeConstraint")
    c.MaxTextSize = maxSize
    c.MinTextSize = 8
    c.Parent = lbl
end
for _, l in ipairs({ S.StrPace, S.DuraPace, S.StrAverage, S.DuraAverage, S.Strength,
