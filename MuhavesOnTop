-- Time slicer for background scans: call step() inside a loop. It yields one frame whenever
-- the scan has used more than 4 ms, so scans never cause frame drops (better than "wait every N items").
local function slicer()
	local t0 = os.clock()
	return function()
		if os.clock() - t0 > 0.004 then
			task.wait()
			t0 = os.clock()
		end
	end
end

-- Incremental tree walk: replaces GetDescendants() on big roots (game / workspace). GetDescendants builds one huge
-- table in a single call (a frame drop that the slicer cannot split); this walks with GetChildren() and yields
-- through the slicer between nodes. fn(instance) may return true to stop the walk.
local function walk(root, fn)
	local step = slicer()
	local stack, n = {root}, 1
	while n > 0 do
		local inst = stack[n]
		stack[n] = nil
		n -= 1
		for _, child in ipairs(inst:GetChildren()) do
			if fn(child) then return end
			n += 1
			stack[n] = child
		end
		step()
	end
end

