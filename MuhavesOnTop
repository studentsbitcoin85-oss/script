-- ANTI AFK
do
	local afk = {conn = nil, token = 0}

	local function poke(kind)
		local ok = pcall(function()
			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.new(0, 0), workspace.CurrentCamera and workspace.CurrentCamera.CFrame)
		end)
		if ok then
			StatsInfo.afkPings += 1
			StatsInfo.afkLast = os.clock()
			if kind == "idled" then StatsInfo.afkIdled += 1 end
		end
	end

	Callbacks.AntiAFK = function(state)
		afk.token += 1
		if afk.conn then afk.conn:Disconnect() afk.conn = nil end
		StatsInfo.afkOn = state
		if not state then return end

		StatsInfo.afkSince, StatsInfo.afkPings, StatsInfo.afkIdled, StatsInfo.afkLast = os.clock(), 0, 0, 0
		afk.conn = LocalPlayer.Idled:Connect(function() poke("idled") end)

		local my = afk.token
		task.spawn(function()
			while afk.token == my do
				for _ = 1, 60 do
					if afk.token ~= my then return end
					task.wait(1)
				end
				poke("timer")
			end
		end)
	end
end

-- ANTI LAG: matikan efek visual (reversibel, nilai asli disimpan)
do
	local antiLag = {on = false, conn = nil, saved = setmetatable({}, {__mode = "k"}),
		lighting = nil, quality = nil, terrain = nil, token = 0}

	local EMITTERS = {ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true,
		Sparkles = true, PointLight = true, SpotLight = true, SurfaceLight = true, Highlight = true}
	local POST = {BloomEffect = true, BlurEffect = true, SunRaysEffect = true,
		ColorCorrectionEffect = true, DepthOfFieldEffect = true}

	local function dampen(obj)
		if antiLag.saved[obj] then return end
		local cls = obj.ClassName
		if EMITTERS[cls] or POST[cls] then
			antiLag.saved[obj] = {kind = "enabled", v = obj.Enabled}
			obj.Enabled = false
			StatsInfo.lagCount += 1
		elseif cls == "ForceField" then
			antiLag.saved[obj] = {kind = "ff", v = obj.Visible}
			obj.Visible = false
			StatsInfo.lagCount += 1
		elseif obj:IsA("BasePart") and not obj:IsA("Terrain") then
			local s = {kind = "part", mat = obj.Material, refl = obj.Reflectance, shadow = obj.CastShadow}
			if obj:IsA("MeshPart") then
				s.fid = obj.RenderFidelity
				obj.RenderFidelity = Enum.RenderFidelity.Performance
			end
			antiLag.saved[obj] = s
			obj.Material = Enum.Material.SmoothPlastic
			obj.Reflectance = 0
			obj.CastShadow = false
			StatsInfo.lagCount += 1
		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			antiLag.saved[obj] = {kind = "decal", v = obj.Transparency}
			obj.Transparency = 1
			StatsInfo.lagCount += 1
		end
	end

	local function restore(obj, s)
		if s.kind == "enabled" then obj.Enabled = s.v
		elseif s.kind == "ff" then obj.Visible = s.v
		elseif s.kind == "part" then
			obj.Material, obj.Reflectance, obj.CastShadow = s.mat, s.refl, s.shadow
			if s.fid then obj.RenderFidelity = s.fid end
		elseif s.kind == "decal" then obj.Transparency = s.v
		elseif s.kind == "atm" then obj.Density, obj.Haze = s.d, s.h end
	end

	Callbacks.AntiLag = function(state)
		if state == antiLag.on then return end
		antiLag.on = state
		StatsInfo.lagOn = state
		antiLag.token += 1
		local my = antiLag.token

		if state then
			StatsInfo.lagCount = 0
			antiLag.lighting = {GlobalShadows = Lighting.GlobalShadows,
				EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
				EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
				Brightness = Lighting.Brightness}
			pcall(function() antiLag.quality = settings().Rendering.QualityLevel end)
			Lighting.GlobalShadows = false
			Lighting.EnvironmentDiffuseScale = 0
			Lighting.EnvironmentSpecularScale = 0
			pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

			pcall(function()
				local t = workspace.Terrain
				antiLag.terrain = {WaterWaveSize = t.WaterWaveSize, WaterWaveSpeed = t.WaterWaveSpeed,
					WaterReflectance = t.WaterReflectance}
				t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance = 0, 0, 0
			end)

			for _, d in ipairs(Lighting:GetDescendants()) do pcall(dampen, d) end
			local atm = Lighting:FindFirstChildOfClass("Atmosphere")
			if atm then
				antiLag.saved[atm] = {kind = "atm", d = atm.Density, h = atm.Haze}
				atm.Density, atm.Haze = 0, 0
			end

			antiLag.conn = workspace.DescendantAdded:Connect(function(d)
				if antiLag.on then pcall(dampen, d) end
			end)

			task.spawn(function()
				local n = 0
				for _, d in ipairs(workspace:GetDescendants()) do
					if antiLag.token ~= my then return end
					pcall(dampen, d)
					n += 1
					if n % 300 == 0 then RunService.Heartbeat:Wait() end
				end
			end)
		else
			if antiLag.conn then antiLag.conn:Disconnect() antiLag.conn = nil end
			for k, v in pairs(antiLag.lighting or {}) do pcall(function() Lighting[k] = v end) end
			for k, v in pairs(antiLag.terrain or {}) do pcall(function() workspace.Terrain[k] = v end) end
			if antiLag.quality then
				pcall(function() settings().Rendering.QualityLevel = antiLag.quality end)
			end
			local list = antiLag.saved
			antiLag.saved = setmetatable({}, {__mode = "k"})
			task.spawn(function()
				local n = 0
				for obj, s in pairs(list) do
					pcall(restore, obj, s)
					n += 1
					if n % 300 == 0 then RunService.Heartbeat:Wait() end
				end
			end)
		end
	end
end

