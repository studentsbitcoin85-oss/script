    title.Font=Enum.Font.GothamBlack
    title.Parent=frame
    Instance.new("UICorner",title).CornerRadius=UDim.new(0,12)

    local container=Instance.new("ScrollingFrame")
    container.Size=UDim2.new(1,-20,1,-65)
    container.Position=UDim2.new(0,10,0,55)
    container.BackgroundTransparency=1
    container.CanvasSize=UDim2.new(0,0,0,380)
    container.ScrollBarThickness=6
    container.Parent=frame

    local layout=Instance.new("UIListLayout",container)
    layout.SortOrder=Enum.SortOrder.LayoutOrder
    layout.Padding=UDim.new(0,8)

    local function createToggle(name,default,callback)
        local btn=Instance.new("TextButton")
        btn.Size=UDim2.new(1,0,0,40)
        btn.BackgroundColor3=Color3.fromRGB(25,15,50)
        btn.Text=name..": "..(default and "ON" or "OFF")
        btn.TextColor3=default and Color3.fromRGB(80,220,120) or Color3.fromRGB(255,80,80)
        btn.Font=Enum.Font.GothamBold
        btn.TextSize=14
        btn.Parent=container
        Instance.new("UICorner",btn).CornerRadius=UDim.new(0,8)

        local enabled=default
        btn.MouseButton1Click:Connect(function()
            enabled=not enabled
            btn.Text=name..": "..(enabled and "ON" or "OFF")
            btn.TextColor3=enabled and Color3.fromRGB(80,220,120) or Color3.fromRGB(255,80,80)
            callback(enabled)
        end)
    end

    -- SPEED MODE SELECTOR
    local modeBtn=Instance.new("TextButton")
    modeBtn.Size=UDim2.new(1,0,0,40)
    modeBtn.BackgroundColor3=Color3.fromRGB(25,15,50)
    modeBtn.Text="⚡ Farm Speed: NORMAL"
    modeBtn.TextColor3=CYAN
    modeBtn.Font=Enum.Font.GothamBold
    modeBtn.TextSize=14
    modeBtn.Parent=container
    Instance.new("UICorner",modeBtn).CornerRadius=UDim.new(0,8)

    modeBtn.MouseButton1Click:Connect(function()
        if farmMode=="Normal" then
            farmMode="Fast"
            modeBtn.Text="⚡ Farm Speed: FAST 🔥"
            modeBtn.TextColor3=Color3.fromRGB(255,170,0)
        else
            farmMode="Normal"
            modeBtn.Text="⚡ Farm Speed: NORMAL"
            modeBtn.TextColor3=CYAN
        end
    end)

    -- TOGGLES
    createToggle("Auto Weight",false,function(v) autoWeight=v end)
    createToggle("Auto Pushups",false,function(v) autoPushups=v end)
    createToggle("Auto Situps",false,function(v) autoSitups=v end)
    createToggle("Auto Punch",false,function(v) autoPunch=v end)
    createToggle("Auto Rebirth",false,function(v) autoRebirth=v end)
    createToggle("Auto Join Brawl",false,function(v) autoBrawl=v end)

    -- FLOATING BUTTON CREATION
    createFloatingButton(frame)

    -- OPTIMIZED AUTO FARM LOOP
    task.spawn(function()
        while true do
            if farmMode == "Fast" then
                RunService.RenderStepped:Wait()
            else
                task.wait(humanDelay(normalDelay))
            end

            local ME = getMuscleEvent()
            if ME then
                if autoWeight then
                    ME:FireServer("rep")
                end
                if autoPushups then
                    ME:FireServer("pushups")
                end
                if autoSitups then
                    ME:FireServer("situps")
                end
                if autoPunch then
                    ME:FireServer("punch","LeftHand")
                    ME:FireServer("punch","RightHand")
                end
            end
        end
    end)

    task.spawn(function()
        while task.wait(1) do
            local ME = getMuscleEvent()
            if ME then
                if autoRebirth then
                    ME:FireServer("rebirthRequest")
                end
                if autoBrawl then
                    ME:FireServer("joinBrawl")
                end
            end
        end
    end)

    startFakeMove()
end

