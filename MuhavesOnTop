-- Minimize / restore animation: the window shrinks and fades while it glides to the position of the ≡ button,
-- then the button fades in. Restoring is the reverse. Adjust the speed with the duration numbers (larger = slower).
local miniStroke = mini:FindFirstChildOfClass("UIStroke")
local animBusy = false

local function targetScale()
	return userScale or math.clamp((cam.ViewportSize.X - 16) / cur.w, MINSCALE, 1)
end
local function miniBg(a) return MINI_SHOW + (1 - MINI_SHOW) * a end
local function miniEdge(a) return STROKE_SHOW + (1 - STROKE_SHOW) * a end
local function setMiniAlpha(a) -- 0 = visible, 1 = hidden
	mini.BackgroundTransparency = miniBg(a)
	for _, ln in ipairs(miniLines) do ln.BackgroundTransparency = a end
	if miniStroke then miniStroke.Transparency = miniEdge(a) end
end
local function tweenMini(a, t)
	local info = TweenInfo.new(t, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	TweenService:Create(mini, info, {BackgroundTransparency = miniBg(a)}):Play()
	for _, ln in ipairs(miniLines) do
		TweenService:Create(ln, info, {BackgroundTransparency = a}):Play()
	end
	if miniStroke then TweenService:Create(miniStroke, info, {Transparency = miniEdge(a)}):Play() end
end

-- center of the mini button in screen pixels (the window is anchored at its center, so it glides to this point)
local winHome
local function miniGoal()
	local v, mpos = cam.ViewportSize, mini.Position
	return UDim2.fromOffset(mpos.X.Scale * v.X + mpos.X.Offset, mpos.Y.Scale * v.Y + mpos.Y.Offset + 13)
end

local function minimizeWindow()
	if animBusy or not win.Visible then return end
	animBusy = true
	winHome = win.Position
	local info = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
	TweenService:Create(scale, info, {Scale = 0.05}):Play()
	introCover.Visible = true
	TweenService:Create(introCover, info, {BackgroundTransparency = 0}):Play()
	TweenService:Create(win, info, {Position = miniGoal()}):Play()
	task.wait(0.5)
	win.Visible = false
	win.Position = winHome
	scale.Scale = targetScale() -- prepare the normal size for when it opens again
	setMiniAlpha(1)
	mini.Visible = true
	tweenMini(0, 0.3)
	animBusy = false
end

local function restoreWindow()
	if animBusy then return end
	animBusy = true
	tweenMini(1, 0.2)
	local home = winHome or win.Position
	win.Position = miniGoal()
	scale.Scale = 0.05
	introCover.BackgroundTransparency = 0
	introCover.Visible = true
	win.Visible = true
	local info = TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	TweenService:Create(scale, info, {Scale = targetScale()}):Play()
	TweenService:Create(win, info, {Position = home}):Play()
	TweenService:Create(introCover, info, {BackgroundTransparency = 1}):Play()
	task.delay(0.2, function() mini.Visible = false end)
	task.wait(0.6)
	introCover.Visible = false
	animBusy = false
end

