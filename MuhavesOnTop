local function formatNumber(num)
	local sign = ""
	if num < 0 then sign, num = "-", -num end
	if num >= 1e18 then return sign .. string.format("%.2fQi", num / 1e18) end
	if num >= 1e15 then return sign .. string.format("%.2fQa", num / 1e15) end
	if num >= 1e12 then return sign .. string.format("%.2fT", num / 1e12) end
	if num >= 1e9 then return sign .. string.format("%.2fB", num / 1e9) end
	if num >= 1e6 then return sign .. string.format("%.2fM", num / 1e6) end
	if num >= 1e3 then return sign .. string.format("%.2fK", num / 1e3) end
	return sign .. string.format("%.0f", num)
end

local function formatPace(r)
	return formatNumber(r) .. "/s | " .. formatNumber(r * 60) .. "/m | "
		.. formatNumber(r * 3600) .. "/h | " .. formatNumber(r * 86400) .. "/d"
end

