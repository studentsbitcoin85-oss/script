-- FIX BUG #1: Delay bervariasi untuk mode Normal
local function humanDelay(base)
    if not randomDelayEnabled then return base end
    local jitter = (math.random(-20, 30) / 100) * base
    return math.max(0.01, base + jitter)
end

-- PERBAIKAN ANTI-DETECTION: Beraktivitas tanpa menggeser/memindahkan posisi karakter
local function startFakeMove()
    if fakeMoveConnection then pcall(function() task.cancel(fakeMoveConnection) end) end
    fakeMoveEnabled=true
    fakeMoveConnection=task.spawn(function()
        while fakeMoveEnabled do
            pcall(function()
                local cam = workspace.CurrentCamera
                if cam then
                    -- Memutar sudut kamera sedikit (-2° s.d. +2°) agar terdeteksi aktif tanpa menggeser karakter
                    local rotX = math.rad(math.random(-2, 2))
                    local rotY = math.rad(math.random(-2, 2))
                    cam.CFrame = cam.CFrame * CFrame.Angles(rotX, rotY, 0)
                end
            end)
            task.wait(math.random(4, 9))
        end
    end)
end

local function stopFakeMove()
    fakeMoveEnabled=false
    if fakeMoveConnection then
        pcall(function() task.cancel(fakeMoveConnection) end)
        fakeMoveConnection=nil
    end
end

local function cleanupOldUI()
    pcall(function()
        local oldIu=CG:FindFirstChild("imgui")
        if oldIu then oldIu:Destroy() end
    end)
    pcall(function()
        for _,g in pairs(PG:GetChildren()) do
            if g.Name=="MuhavesKey" or g.Name=="MuhavesFloat" or g.Name=="MuhavesOverlay" or g.Name=="MuhavesLoading" or g.Name=="MuhavesKeyLoading" or g.Name=="MuhavesHub" then
                g:Destroy()
            end
        end
    end)
end

local function saveKey() pcall(function() if writefile then writefile(KEY_FILE,KEY) end end) end
local function hasSavedKey()
    local ok,result=pcall(function()
        if readfile and isfile and isfile(KEY_FILE) then return readfile(KEY_FILE) end
        return nil
    end)
    if ok and result then return result==KEY end
    return false
end

