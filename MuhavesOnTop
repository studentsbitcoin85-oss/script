-- Sidebar + navigation
local pages, sizes = {}, {}
local SIDEMIN = 300
local CHAR_MAX_H = 600
local PAGE_MAX_H = 470 -- maximum page area height; if the content is taller, the page scrolls

local sidebar = box(body, PAD, PAD, SW, 400, BLACK, 16)
local nav = {{"⚡", "Fast Farming"}, {"⚙", "Extras"}, {"📢", "Notice"}}
local navBtns, navLbls = {}, {}
local charImg
local currentNav = 0
local navToken = 0

local function applyNav(idx, instant)
	currentNav = idx
	local navInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	for i, b in ipairs(navBtns) do
		local on = i == idx
		local stk = b:FindFirstChildOfClass("UIStroke")
		local goal = {
			-- BackgroundColor3 is MULTIPLIED by the button's UIGradient, so white = the gradient's own gray (selected),
			-- a darker value = a dimmer gray (not selected). Both stay clearly visible on the black sidebar.
			BackgroundTransparency = 0,
			BackgroundColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(120, 120, 120),
		}
		local lblGoal = {TextColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(225, 225, 228)}
		if instant then
			for k, v in pairs(goal) do b[k] = v end
			for k, v in pairs(lblGoal) do navLbls[i][k] = v end
			stk.Transparency = on and 0 or 0.4
		else
			TweenService:Create(b, navInfo, goal):Play()
			TweenService:Create(navLbls[i], navInfo, lblGoal):Play()
			TweenService:Create(stk, navInfo, {Transparency = on and 0 or 0.4}):Play()
		end
		pages[i].Visible = on
	end
	local sz = sizes[idx]
	local viewH = math.min(sz.h, PAGE_MAX_H)
	local W = CX + sz.w + PAD
	local H = math.max(HH + PAD + viewH + PAD, HH + PAD + SIDEMIN + PAD)
	cur.w, cur.h = W, H
	pages[idx].Size = UDim2.fromOffset(sz.w + 8, viewH)
	pages[idx].CanvasSize = UDim2.fromOffset(0, sz.h)
	pages[idx].CanvasPosition = Vector2.new(0, 0)
	local sideH = H - HH - 2 * PAD
	local charH = math.min(CHAR_MAX_H, sideH - 172 - 8)
	if charImg and charImg:IsA("ImageLabel") then
		charImg.ScaleType = Enum.ScaleType.Crop -- fill the box top to bottom without squashing
	end
	local goals = {
		{sidebar, {Size = UDim2.fromOffset(SW, sideH)}},
	}
	if charImg then table.insert(goals, {charImg, {Size = UDim2.fromOffset(SW - 16, charH)}}) end
	for _, g in ipairs(goals) do
		if instant then
			for k, v in pairs(g[2]) do g[1][k] = v end
		else
			TweenService:Create(g[1], SMOOTH, g[2]):Play()
		end
	end
	minimized = false
	body.Visible = true
	body.CanvasPosition = Vector2.new(0, 0)
	layoutWindow(not instant)
end

-- Tab switch: fade the page area to black, swap the page while it is hidden, then fade back in.
local function selectNav(idx, instant)
	if instant then
		applyNav(idx, true)
		return
	end
	if idx == currentNav then return end
	navToken += 1
	local my = navToken
	TweenService:Create(pageCover, FADE_IN, {BackgroundTransparency = 0}):Play()
	task.delay(0.13, function()
		if my ~= navToken or not gui.Parent then return end
		applyNav(idx, false)
		TweenService:Create(pageCover, FADE_OUT, {BackgroundTransparency = 1}):Play()
	end)
end

