----------------------------------------------------------------------
-- Formatter
----------------------------------------------------------------------
local SUFFIXES = {
    { 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" },
    { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" },
}
local function fmt(n)
    local sign = n < 0 and "-" or ""
    n = math.abs(n)
    for _, s in ipairs(SUFFIXES) do
        if n >= s[1] then
            return string.format("%s%.2f%s", sign, n / s[1], s[2])
        end
    end
    return string.format("%s%.0f", sign, n)
end

local function paceText(perSecond)
    return string.format("%s/s | %s/m | %s/h | %s/d",
        fmt(perSecond), fmt(perSecond * 60), fmt(perSecond * 3600), fmt(perSecond * 86400))
end

local function duration(sec)
    return string.format("%dd %dh %dm %ds",
        math.floor(sec / 86400), math.floor((sec % 86400) / 3600),
        math.floor((sec % 3600) / 60), math.floor(sec % 60))
end

