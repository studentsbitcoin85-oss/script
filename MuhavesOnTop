-- HIDE POPUPS
do
	local POPUP_NAMES = {"popup", "pop_up", "notification", "notif", "toast", "alert", "announce", "stateffects"}
	local POPUP_IGNORE = {"muhavesui", "chat", "backpack", "leaderboard", "hotbar", "quest", "mission", "misi",
		"shop", "store", "inventory", "settings", "trade", "index", "rewardlist", "codes"}

	local popup = {on = false, token = 0, conns = {},
		hidden = setmetatable({}, {__mode = "k"}),
		baseline = setmetatable({}, {__mode = "k"}),
		labelSet = setmetatable({}, {__mode = "k"}),
		seen = setmetatable({}, {__mode = "k"}),
		counted = setmetatable({}, {__mode = "k"}),
		spawn = setmetatable({}, {__mode = "k"})}

	local function gainText(t)
		return t ~= "" and t:match("^%s*[%+%-]%s*%d") ~= nil
	end

	local function ignored(o)
		if o.Name == "MuhavesUI" or o:FindFirstAncestor("MuhavesUI") then return true end
		local a = o
		while a and a ~= workspace and not a:IsA("PlayerGui") do
			local n = a.Name:lower()
			for _, k in ipairs(POPUP_IGNORE) do
				if n:find(k, 1, true) then return true end
			end
			a = a.Parent
		end
		return false
	end

	local function layouty(p)
		return p:IsA("ScrollingFrame") or p:FindFirstChildWhichIsA("UIGridStyleLayout") ~= nil
	end

	local function inScrolling(o)
		local a = o.Parent
		while a and not a:IsA("PlayerGui") and a ~= workspace do
			if a:IsA("ScrollingFrame") then return true end
			a = a.Parent
		end
		return false
	end

	local function unhide(o)
		local s = popup.hidden[o]
		if not s then return end
		popup.hidden[o] = nil
		for _, c in ipairs({s.conn, s.conn2, s.conn3}) do if c then c:Disconnect() end end
		pcall(function() o[s.prop] = s.v end)
	end

	local function hideTarget(o, why, srcLabel)
		if popup.hidden[o] or ignored(o) or inScrolling(o) then return end
		local prop = o:IsA("LayerCollector") and "Enabled" or "Visible"
		local s = {prop = prop, v = o[prop]}
		popup.hidden[o] = s
		o[prop] = false
		if not popup.counted[o] then
			popup.counted[o] = true
			StatsInfo.popCount += 1
		end
		local full = o:GetFullName():gsub("^.-PlayerGui%.", "")
		StatsInfo.popLast = why .. ": " .. full:sub(-46)
		s.conn = o:GetPropertyChangedSignal(prop):Connect(function()
			if popup.on and o[prop] == true then o[prop] = false end
		end)
		s.conn2 = o.Destroying:Connect(function()
			popup.hidden[o] = nil
			if s.conn then s.conn:Disconnect() end
			if s.conn3 then s.conn3:Disconnect() end
		end)
		if srcLabel then
			s.conn3 = srcLabel:GetPropertyChangedSignal("Text"):Connect(function()
				if not gainText(srcLabel.Text) then
					popup.seen[srcLabel] = nil
					unhide(o)
				end
			end)
		end
	end

	local function pickTarget(lbl)
		local t, p = lbl, lbl.Parent
		while p and p:IsA("GuiObject") and not popup.baseline[p] and not layouty(p) do
			t, p = p, p.Parent
		end
		if p and p:IsA("LayerCollector") and not popup.baseline[p] then
			return p
		end
		if t == lbl and popup.baseline[lbl] and p and p:IsA("GuiObject")
			and not layouty(p) and #p:GetChildren() <= 4 then
			t = p
		end
		return t
	end

	local function checkLabel(lbl)
		if not popup.on or popup.hidden[lbl] then return end
		local seenT = popup.seen[lbl]
		if seenT and popup.hidden[seenT] then return end
		if not lbl.Visible or not gainText(lbl.Text) or inScrolling(lbl) then return end
		local t = pickTarget(lbl)
		popup.seen[lbl] = t
		hideTarget(t, "gain", lbl)
	end

	local function nameHit(o)
		if not o:IsA("GuiObject") and not o:IsA("LayerCollector") then return false end
		if o:IsA("GuiButton") then return false end
		local n = o.Name:lower()
		for _, k in ipairs(POPUP_NAMES) do
			if n:find(k, 1, true) then return true end
		end
		return false
	end

	local function spawnCheck(d)
		if not d:IsA("GuiObject") or d:IsA("GuiButton") then return end
		local parent = d.Parent
		if not parent or not (parent:IsA("GuiObject") or parent:IsA("LayerCollector")) then return end
		if layouty(parent) then return end
		local now = os.clock()
		local s = popup.spawn[parent]
		if not s then s = {short = 0, flag = false, lastShort = 0}; popup.spawn[parent] = s end
		if s.flag and now - s.lastShort > 20 then s.flag = false; s.short = 0 end
		d.Destroying:Connect(function()
			local t = os.clock()
			if t - now < 4 then
				s.short += 1
				s.lastShort = t
				if s.short >= 3 then s.flag = true end
			end
		end)
		if s.flag then hideTarget(d, "spawn") end
	end

	Callbacks.HidePopups = function(state)
		if state == popup.on then return end
		popup.on = state
		StatsInfo.popOn = state
		popup.token += 1
		local my = popup.token
		local pg = LocalPlayer:WaitForChild("PlayerGui")

		if state then
			StatsInfo.popCount, StatsInfo.popLast = 0, "-"
			for _, d in ipairs(pg:GetDescendants()) do
				popup.baseline[d] = true
				if d:IsA("TextLabel") or d:IsA("TextButton") then popup.labelSet[d] = true end
			end
			for _, d in ipairs(pg:GetDescendants()) do
				if nameHit(d) then pcall(hideTarget, d, "name") end
			end

			table.insert(popup.conns, pg.DescendantAdded:Connect(function(d)
				if not popup.on then return end
				if d:IsA("TextLabel") or d:IsA("TextButton") then popup.labelSet[d] = true end
				task.defer(function()
					if not popup.on or not d.Parent then return end
					pcall(function()
						if nameHit(d) then hideTarget(d, "name") return end
						spawnCheck(d)
						if d:IsA("TextLabel") or d:IsA("TextButton") then checkLabel(d) end
					end)
				end)
			end))

			table.insert(popup.conns, workspace.DescendantAdded:Connect(function(d)
				if popup.on and d:IsA("TextLabel") then
					task.delay(0.15, function()
						if popup.on and d.Parent and gainText(d.Text) then
							local bb = d:FindFirstAncestorWhichIsA("BillboardGui") or d:FindFirstAncestorWhichIsA("SurfaceGui")
							if bb then pcall(hideTarget, bb, "world") end
						end
					end)
				end
			end))

			task.spawn(function()
				while popup.token == my do
					local n = 0
					for lbl in pairs(popup.labelSet) do
						if lbl.Parent then pcall(checkLabel, lbl) end
						n += 1
						if n % 600 == 0 then RunService.Heartbeat:Wait() end
					end
					task.wait(0.25)
				end
			end)
		else
			for _, c in ipairs(popup.conns) do c:Disconnect() end
			popup.conns = {}
			for o in pairs(popup.hidden) do unhide(o) end
			popup.hidden = setmetatable({}, {__mode = "k"})
			popup.baseline = setmetatable({}, {__mode = "k"})
			popup.labelSet = setmetatable({}, {__mode = "k"})
			popup.seen = setmetatable({}, {__mode = "k"})
			popup.spawn = setmetatable({}, {__mode = "k"})
			popup.counted = setmetatable({}, {__mode = "k"})
		end
	end
end

-- HIDE PLAYERS
do
	local hidePl = {on = false, conns = {}, saved = setmetatable({}, {__mode = "k"})}

	local function hpHide(d)
		if hidePl.saved[d] then return end
		if d:IsA("BasePart") then
			hidePl.saved[d] = {k = "p", v = d.LocalTransparencyModifier}
			d.LocalTransparencyModifier = 1
		elseif d:IsA("Decal") or d:IsA("Texture") then
			hidePl.saved[d] = {k = "d", v = d.Transparency}
			d.Transparency = 1
		elseif d:IsA("BillboardGui") then
			hidePl.saved[d] = {k = "b", v = d.Enabled}
			d.Enabled = false
		end
	end

	local function hpChar(char)
		for _, d in ipairs(char:GetDescendants()) do pcall(hpHide, d) end
		table.insert(hidePl.conns, char.DescendantAdded:Connect(function(d)
			if hidePl.on then task.defer(pcall, hpHide, d) end
		end))
	end

	local function hpPlayer(pl)
		if pl == LocalPlayer then return end
		if pl.Character then hpChar(pl.Character) end
		table.insert(hidePl.conns, pl.CharacterAdded:Connect(function(c)
			if not hidePl.on then return end
			task.wait(0.5)
			if hidePl.on then hpChar(c) end
		end))
	end

	Callbacks.HidePlayers = function(state)
		if state == hidePl.on then return end
		hidePl.on = state
		if state then
			for _, pl in ipairs(Players:GetPlayers()) do pcall(hpPlayer, pl) end
			table.insert(hidePl.conns, Players.PlayerAdded:Connect(function(pl) pcall(hpPlayer, pl) end))
		else
			for _, c in ipairs(hidePl.conns) do c:Disconnect() end
			hidePl.conns = {}
			local list = hidePl.saved
			hidePl.saved = setmetatable({}, {__mode = "k"})
			for d, s in pairs(list) do
				pcall(function()
					if s.k == "p" then d.LocalTransparencyModifier = s.v
					elseif s.k == "d" then d.Transparency = s.v
					else d.Enabled = s.v end
				end)
			end
		end
	end
end

