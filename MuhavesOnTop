-- HIDE POPUPS (leak-free version)
do
	local on = false
	local STRICT = true
	local POPUP_PATTERNS = {"popup", "pop_up", "pop up", "notif", "toast"}
	local GAIN = "^%s*%+%s*[%d%.,]"
	local saved = {}      -- instance -> {property, original value}
	local objConns = {}   -- instance -> {connections owned by that object}
	local rootConns = {}  -- global connections (only a few)

	local function link(o, c)
		local t = objConns[o]
		if not t then t = {} objConns[o] = t end
		t[#t + 1] = c
	end
	local function drop(o)
		local t = objConns[o]
		if t then
			for _, c in ipairs(t) do c:Disconnect() end
			objConns[o] = nil
		end
	end
	-- objects that no longer exist in the game: disconnect them and remove their records
	local function sweep()
		for o in pairs(objConns) do
			if not o:IsDescendantOf(game) then
				drop(o)
				saved[o] = nil
			end
		end
		for o in pairs(saved) do
			if not o:IsDescendantOf(game) then saved[o] = nil end
		end
	end

	local function propOf(o)
		if o:IsA("ScreenGui") or o:IsA("BillboardGui") then return "Enabled" end
		if o:IsA("GuiObject") then return "Visible" end
	end
	local function nameMatch(n)
		n = n:lower()
		for _, p in ipairs(POPUP_PATTERNS) do
			if n:find(p, 1, true) then return true end
		end
		return false
	end
	local function mine(o)
		if o:IsDescendantOf(gui) then return true end
		local top = o:IsA("ScreenGui") and o or o:FindFirstAncestorWhichIsA("ScreenGui") or o
		return top.Name:sub(1, 7) == "Muhaves"
	end
	local function hide(o, orig)
		local prop = propOf(o)
		if not prop or saved[o] ~= nil then return end
		local original = orig
		if original == nil then original = o[prop] end
		saved[o] = {prop, original}
		o[prop] = false
		link(o, o:GetPropertyChangedSignal(prop):Connect(function()
			if on and o[prop] ~= false then o[prop] = false end
		end))
	end
	local function rules(o)
		if nameMatch(o.Name) then
			hide(o)
		elseif o:IsA("TextLabel") then
			local bb = o:FindFirstAncestorWhichIsA("BillboardGui")
			local function test()
				if on and o.Text:match(GAIN) then hide(bb or o) end
			end
			test()
			if bb then link(o, o:GetPropertyChangedSignal("Text"):Connect(test)) end
		end
	end
	local function onExisting(o)
		local prop = propOf(o)
		if not prop or mine(o) then return end
		rules(o)
		if STRICT and not o:IsA("BillboardGui") and o[prop] == false then
			link(o, o:GetPropertyChangedSignal(prop):Connect(function()
				if on and o[prop] == true then hide(o, false) end
			end))
		end
	end
	local function onNew(o)
		local prop = propOf(o)
		if not prop or mine(o) then return end
		if STRICT then hide(o) else rules(o) end
	end

	local function setHidden(state)
		if state == on then return end
		on = state
		if on then
			for _, root in ipairs({lp:WaitForChild("PlayerGui"), workspace}) do
				rootConns[#rootConns + 1] = root.DescendantAdded:Connect(function(o)
					if on then pcall(onNew, o) end
				end)
				task.spawn(function()
					walk(root, function(o)
						if not on then return true end
						pcall(onExisting, o)
					end)
				end)
			end
			task.spawn(function()
				while on and alive() do
					task.wait(30)
					if on then sweep() end
				end
			end)
		else
			for _, c in ipairs(rootConns) do c:Disconnect() end
			table.clear(rootConns)
			for o in pairs(objConns) do drop(o) end
			for o, v in pairs(saved) do
				if o.Parent then pcall(function() o[v[1]] = v[2] end) end
			end
			table.clear(saved)
		end
	end

	Callbacks.HidePopups = setHidden
	gui.Destroying:Connect(function() setHidden(false) end)
end

